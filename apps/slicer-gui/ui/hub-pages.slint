// The Home, Device and Project tabs (Orca/Bambu's top-level pages beside
// Prepare and Preview). Each page fills the area between the header and
// the status bar and only talks to the app through its properties and
// callbacks.
import { SecondaryButton as Button } from "secondary-button.slint";
import { PrimaryButton } from "primary-button.slint";
import { ShellTheme } from "theme.slint";
import { ComboBox, LineEdit, ScrollView } from "std-widgets.slint";

export struct RecentProject { name: string, folder: string, modified: string, missing: bool, thumbnail: image, has-thumbnail: bool }
export struct DriveRow { label: string }
export struct HistoryRow { when: string, job: string, printer: string, material: string, layers: int, estimate: string, outcome: int, failed-layer: string }
export struct PlateRow { number: int, name: string, objects: int, status: string, stale: bool, layers: int, time: string, active: bool }

// A titled white card, the building block of every hub page.
component Card inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    background: ShellTheme.panel;
    border-radius: 8px;
    border-width: 1px;
    border-color: ShellTheme.border;
    VerticalLayout {
        padding: 18px; spacing: 12px;
        VerticalLayout { spacing: 2px;
            Text { text: root.title; color: ShellTheme.text; font-size: 15px; font-weight: 600; }
            if root.subtitle != "": Text { text: root.subtitle; color: ShellTheme.muted; font-size: 12px; wrap: word-wrap; }
        }
        @children
    }
}

// "Label ........ value" line inside a card.
component InfoLine inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 12px;
    Text { text: root.label; color: ShellTheme.muted; font-size: 13px; width: 120px; }
    Text { text: root.value; color: ShellTheme.text; font-size: 13px; horizontal-stretch: 1; wrap: word-wrap; }
}

// Big action card of the Home page (New project / Open project).
component ActionCard inherits Rectangle {
    in property <image> icon;
    in property <int> tint: 0;
    in property <string> title;
    in property <string> subtitle;
    callback clicked();
    accessible-role: button;
    accessible-label: root.title;
    accessible-action-default => { root.clicked(); }
    // At least 280 px, wider when the text needs it (R103: the "Open a file"
    // subtitle ran past the card's edge).
    width: Math.max(280px, action-row.preferred-width); height: 100px;
    background: touch.has-hover ? ShellTheme.field : ShellTheme.panel;
    border-radius: 8px;
    border-width: 1px;
    border-color: touch.has-hover ? ShellTheme.accent : ShellTheme.border;
    action-row := HorizontalLayout {
        padding-left: 22px; padding-right: 22px; spacing: 18px;
        VerticalLayout { alignment: center;
            Rectangle {
                width: 48px; height: 48px; border-radius: 8px;
                border-width: 1.5px; border-color: ShellTheme.icon-tint(root.tint);
                Image { source: root.icon; width: 26px; height: 26px; colorize: ShellTheme.icon-tint(root.tint); }
            }
        }
        VerticalLayout { alignment: center; spacing: 2px;
            Text { text: root.title; color: ShellTheme.text; font-size: 15px; }
            Text { text: root.subtitle; color: ShellTheme.muted; font-size: 13px; }
        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// The printer or resin the app is set up for, with its picture (Home).
component SetupItem inherits Rectangle {
    in property <string> kind;
    in property <string> name;
    in property <image> picture;
    callback change();
    // Grows for a long name, which wraps instead of being cut off.
    height: Math.max(72px, setup-row.preferred-height); border-radius: 8px; background: ShellTheme.field;
    setup-row := HorizontalLayout { padding: 8px; spacing: 10px;
        Rectangle { width: 56px; height: 56px; border-radius: 6px; background: ShellTheme.panel;
            if root.picture.width > 0: Image { x: 2px; y: 2px; width: 52px; height: 52px; source: root.picture; image-fit: contain; }
        }
        VerticalLayout { alignment: center; spacing: 2px; horizontal-stretch: 1;
            Text { text: root.kind; color: ShellTheme.muted; font-size: 11px; }
            Text { text: root.name; color: ShellTheme.text; font-size: 13px; font-weight: 600; wrap: word-wrap; }
        }
        VerticalLayout { alignment: center;
            Button { text: @tr("Change..."); accessible-label: @tr("Change {}", root.kind); clicked => { root.change(); } }
        }
    }
}

// One numbered step of "Getting started" (Home).
component StepLine inherits HorizontalLayout {
    in property <int> number;
    in property <string> title;
    in property <string> detail;
    spacing: 10px;
    VerticalLayout { alignment: start;
        Rectangle { width: 22px; height: 22px; border-radius: 11px; background: ShellTheme.accent;
            Text { text: root.number; color: ShellTheme.accent-text; font-size: 12px; font-weight: 700; }
        }
    }
    VerticalLayout { spacing: 1px; horizontal-stretch: 1;
        Text { text: root.title; color: ShellTheme.text; font-size: 13px; font-weight: 600; }
        Text { text: root.detail; color: ShellTheme.muted; font-size: 12px; wrap: word-wrap; }
    }
}

// One numbered step of "Send this print" (Device): a filled check when done.
component SendStep inherits Rectangle {
    in property <int> number;
    in property <string> title;
    in property <string> detail;
    in property <bool> done;
    horizontal-stretch: 1;
    min-height: 150px;
    border-radius: 8px; border-width: 1px;
    border-color: root.done ? ShellTheme.accent.transparentize(0.4) : ShellTheme.border;
    background: root.done ? ShellTheme.accent.transparentize(0.9) : ShellTheme.field.transparentize(0.5);
    VerticalLayout { padding: 12px; spacing: 8px; alignment: start;
        HorizontalLayout { spacing: 8px;
            Rectangle { width: 24px; height: 24px; border-radius: 12px;
                background: root.done ? ShellTheme.accent : transparent;
                border-width: root.done ? 0px : 1.5px; border-color: ShellTheme.muted;
                Text { text: root.done ? "\u{2713}" : root.number; color: root.done ? ShellTheme.accent-text : ShellTheme.muted; font-size: 12px; font-weight: 700; }
            }
            Text { text: root.title; color: ShellTheme.text; font-size: 14px; font-weight: 600; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
        }
        Text { text: root.detail; color: ShellTheme.muted; font-size: 12px; wrap: word-wrap; }
        @children
    }
}

// A fold inside a card: a title line that opens and closes its content.
component Fold inherits VerticalLayout {
    in property <string> title;
    in-out property <bool> open: false;
    spacing: 8px;
    Rectangle { height: 28px;
        accessible-role: button; accessible-label: root.title; accessible-expanded: root.open;
        accessible-action-default => { root.open = !root.open; }
        HorizontalLayout { spacing: 6px;
            VerticalLayout { alignment: center; Image { source: root.open ? @image-url("icons/chevron-down.svg") : @image-url("icons/chevron-right.svg"); width: 14px; height: 14px; colorize: ShellTheme.muted; } }
            Text { text: root.title; color: ShellTheme.text; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; }
        }
        TouchArea { mouse-cursor: pointer; clicked => { root.open = !root.open; } }
    }
    // @children cannot sit in an `if`: the content collapses to nothing
    // (and leaves the accessibility tree) while folded.
    Rectangle {
        visible: root.open;
        height: root.open ? fold-content.preferred-height : 0px;
        clip: true;
        fold-content := VerticalLayout { spacing: 8px; @children }
    }
}

export component HomePage inherits Rectangle {
    in property <[RecentProject]> recent;
    in property <string> printer-name;
    in property <string> resin-name;
    in property <image> printer-picture;
    in property <image> resin-picture;
    callback new-project();
    callback open-project();
    callback open-recent(int);
    callback remove-recent(int);
    callback change-printer();
    callback change-resin();
    callback setup-wizard();
    background: ShellTheme.background;

    // What a newcomer needs first (R102): the printer and resin they are set
    // up for, and the four steps from a model to a print. (The account rail
    // that stood here offered a sign-in that does not exist yet.)
    Rectangle {
        x: 0px; y: 0px; width: 280px; height: parent.height;
        background: ShellTheme.panel;
        Rectangle { x: parent.width - 1px; width: 1px; background: ShellTheme.border; }
        VerticalLayout {
            padding: 20px; spacing: 10px; alignment: start;
            Text { text: @tr("Your setup"); color: ShellTheme.text; font-size: 15px; font-weight: 600; }
            SetupItem { kind: @tr("Printer"); name: root.printer-name; picture: root.printer-picture; change => { root.change-printer(); } }
            SetupItem { kind: @tr("Resin"); name: root.resin-name; picture: root.resin-picture; change => { root.change-resin(); } }
            HorizontalLayout { alignment: start;
                Button { text: @tr("Run setup wizard..."); clicked => { root.setup-wizard(); } }
            }
            Rectangle { height: 12px; }
            Text { text: @tr("Getting started"); color: ShellTheme.text; font-size: 15px; font-weight: 600; }
            StepLine { number: 1; title: @tr("Add a model"); detail: @tr("Open an STL, OBJ or 3MF, or drop it on the plate."); }
            StepLine { number: 2; title: @tr("Auto prepare"); detail: @tr("Turns the part, places it and adds supports."); }
            StepLine { number: 3; title: @tr("Slice"); detail: @tr("Check the layers and print time in Preview."); }
            StepLine { number: 4; title: @tr("Send to printer"); detail: @tr("Export to a USB drive from the Device tab."); }
        }
    }

    // Recent projects in a responsive grid of cards.
    property <length> card-w: 220px;
    property <length> card-h: 196px;
    property <length> gap: 16px;
    property <int> columns: Math.max(1, Math.floor((self.width - 280px - 80px + root.gap) / (root.card-w + root.gap)));
    ScrollView {
        x: 280px; y: 0px; width: parent.width - 280px; height: parent.height;
        viewport-height: 300px + Math.ceil(root.recent.length / root.columns) * (root.card-h + root.gap);
        VerticalLayout {
            padding: 40px; spacing: 28px; alignment: start;
            HorizontalLayout { spacing: 16px; alignment: start;
                ActionCard { tint: 0; icon: @image-url("icons/add.svg"); title: @tr("New project"); subtitle: @tr("Start with an empty plate"); clicked => { root.new-project(); } }
                ActionCard { tint: 0; icon: @image-url("icons/export.svg"); title: @tr("Open a file"); subtitle: @tr("A model (STL, OBJ) or a project (3MF)"); clicked => { root.open-project(); } }
            }
            Text { text: @tr("Recently opened"); color: ShellTheme.text; font-size: 16px; font-weight: 600; }
            if root.recent.length == 0: Text { text: @tr("Projects and models you open appear here."); color: ShellTheme.muted; }
            Rectangle {
                height: Math.ceil(root.recent.length / root.columns) * (root.card-h + root.gap);
                for item[i] in root.recent: Rectangle {
                    x: Math.mod(i, root.columns) * (root.card-w + root.gap);
                    y: Math.floor(i / root.columns) * (root.card-h + root.gap);
                    width: root.card-w; height: root.card-h;
                    accessible-role: button;
                    accessible-label: item.name;
                    accessible-action-default => { if !item.missing { root.open-recent(i); } }
                    background: card-touch.has-hover && !item.missing ? ShellTheme.field : ShellTheme.panel;
                    border-radius: 8px; border-width: 1px;
                    border-color: card-touch.has-hover && !item.missing ? ShellTheme.accent : ShellTheme.border;
                    opacity: item.missing ? 0.55 : 1;
                    // Orca-style card: the file's rendered preview on top,
                    // name / folder / date underneath.
                    VerticalLayout {
                        padding: 8px; spacing: 8px;
                        Rectangle { height: 116px; border-radius: 6px; background: #2e3138; clip: true;
                            if item.has-thumbnail: Image { source: item.thumbnail; width: parent.width; height: parent.height; image-fit: cover; }
                            if !item.has-thumbnail: Image { source: @image-url("icons/prepare.svg"); width: 32px; height: 32px; colorize: #8a8f99; }
                        }
                        VerticalLayout { padding-left: 4px; padding-right: 4px; spacing: 2px;
                            Text { text: item.name; color: ShellTheme.text; font-size: 13px; font-weight: 600; overflow: elide; }
                            Text { text: item.folder; color: ShellTheme.muted; font-size: 11px; overflow: elide; }
                            Text { text: item.missing ? @tr("File not found") : item.modified; color: item.missing ? ShellTheme.error : ShellTheme.muted; font-size: 11px; }
                        }
                    }
                    card-touch := TouchArea { mouse-cursor: item.missing ? default : pointer; clicked => { if !item.missing { root.open-recent(i); } } }
                    // A missing file can only be dropped from the list.
                    if item.missing: Rectangle {
                        x: parent.width - self.width - 8px; y: 8px; width: remove-text.preferred-width + 16px; height: 24px;
                        border-radius: 4px; background: remove-touch.has-hover ? ShellTheme.border : ShellTheme.field;
                        accessible-role: button; accessible-label: @tr("Remove {} from the list", item.name);
                        accessible-action-default => { root.remove-recent(i); }
                        remove-text := Text { text: @tr("Remove from list"); color: ShellTheme.text; font-size: 11px; }
                        remove-touch := TouchArea { mouse-cursor: pointer; clicked => { root.remove-recent(i); } }
                    }
                }
            }
        }
    }
}

export component DevicePage inherits Rectangle {
    in property <string> printer-name;
    in property <string> printer-model;
    in property <string> build-volume;
    in property <string> resolution;
    in property <string> output;
    in property <string> material-name;
    in property <[DriveRow]> drives;
    in property <bool> export-ready;
    in-out property <int> export-format;
    in-out property <string> post-export-command;
    in property <[HistoryRow]> history;
    in property <string> estimate-correction;
    in property <image> printer-picture;
    in property <string> print-time;
    in property <bool> can-slice;
    in property <bool> slicing;
    callback slice-now();
    callback edit-printer();
    callback calibration-tools();
    callback refresh-drives();
    callback export-to-drive(int);
    callback post-export-command-edited(string);
    callback history-outcome(int, int);
    callback history-failed-layer(int, string);
    callback calibrate-estimate();
    callback reset-estimate();
    background: ShellTheme.background;

    // R102, from Orca / Bambu's Device page: the job and its hand-off come
    // first, as three numbered steps (slice, insert a drive, export), each
    // saying whether it is done; the print history fills the rest. The
    // printer, with its picture and tools, sits on the right; hardware specs
    // and the advanced export options are folded away.
    HorizontalLayout {
        padding: 24px; spacing: 20px;
        VerticalLayout { horizontal-stretch: 1; spacing: 20px;
            Card {
                title: @tr("Send this print");
                subtitle: @tr("Three steps from the plate to the printer.");
                HorizontalLayout { spacing: 12px;
                    SendStep {
                        number: 1; title: @tr("Slice"); done: root.export-ready;
                        detail: root.export-ready ? (root.print-time != "" ? @tr("Sliced · {} print", root.print-time) : @tr("Sliced")) : root.slicing ? @tr("Slicing...") : @tr("The plate is not sliced yet.");
                        if !root.export-ready: PrimaryButton { text: @tr("Slice now"); icon: @image-url("icons/slice.svg"); enabled: root.can-slice; clicked => { root.slice-now(); } }
                    }
                    SendStep {
                        number: 2; title: @tr("Insert a USB drive"); done: root.drives.length > 0;
                        detail: root.drives.length > 0 ? @tr("Found: {}", root.drives[0].label) : @tr("Plug in the printer's USB drive or SD card.");
                        Button { text: @tr("Refresh drives"); clicked => { root.refresh-drives(); } }
                    }
                    SendStep {
                        number: 3; title: @tr("Export"); done: false;
                        detail: root.export-ready && root.drives.length > 0 ? @tr("Then start the print on the printer's screen.") : @tr("Ready once steps 1 and 2 are done.");
                        for drive[i] in root.drives: PrimaryButton { text: root.drives.length == 1 ? @tr("Export to drive") : @tr("Export to {}", drive.label); enabled: root.export-ready; clicked => { root.export-to-drive(i); } }
                    }
                }
                Fold {
                    title: @tr("File format and automation");
                    HorizontalLayout { spacing: 8px;
                        Text { text: @tr("Format"); color: ShellTheme.muted; width: 120px; vertical-alignment: center; }
                        ComboBox { accessible-label: @tr("Export format"); model: ["G-code ZIP", "PNG layers", "3MF", "SVG"]; current-index <=> root.export-format; }
                    }
                    Text { text: @tr("After every export, run"); color: ShellTheme.text; font-size: 13px; }
                    LineEdit {
                        accessible-label: @tr("After-export command");
                        text <=> root.post-export-command;
                        placeholder-text: @tr("e.g. upload.bat {{file}}");
                        edited(t) => { root.post-export-command-edited(t); }
                    }
                    Text { text: @tr("{{file}} is replaced by the exported file's path. Leave empty to run nothing."); color: ShellTheme.muted; font-size: 12px; wrap: word-wrap; }
                }
            }
            Card {
                vertical-stretch: 1;
                title: @tr("Print history");
                subtitle: @tr("Every exported job. Record how each print went; failures and their layers stay with the job.");
                if root.history.length == 0: Text { text: @tr("No exports yet. Exported jobs appear here."); color: ShellTheme.muted; }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout { spacing: 0px; alignment: start;
                        for row[i] in root.history: Rectangle {
                            height: 64px;
                            Rectangle { y: parent.height - 1px; height: 1px; background: ShellTheme.border; }
                            HorizontalLayout { padding-right: 12px; spacing: 12px;
                                VerticalLayout { alignment: center; spacing: 2px; horizontal-stretch: 1;
                                    Text { text: row.job; color: ShellTheme.text; font-size: 13px; font-weight: 600; overflow: elide; }
                                    Text { text: row.when + " · " + row.printer + " · " + row.material; color: ShellTheme.muted; font-size: 11px; overflow: elide; }
                                    Text { text: @tr("{} layers · {}", row.layers, row.estimate == "" ? "—" : row.estimate); color: ShellTheme.muted; font-size: 11px; }
                                }
                                VerticalLayout { alignment: center;
                                    ComboBox {
                                        width: 150px;
                                        accessible-label: @tr("Outcome of {}", row.job);
                                        model: [@tr("Not recorded"), @tr("Succeeded"), @tr("Failed")];
                                        current-index: row.outcome;
                                        selected => { root.history-outcome(i, self.current-index); }
                                    }
                                }
                                if row.outcome == 2: VerticalLayout { alignment: center;
                                    LineEdit {
                                        width: 110px;
                                        accessible-label: @tr("Failed at layer");
                                        placeholder-text: @tr("Failed layer");
                                        input-type: number;
                                        text: row.failed-layer;
                                        accepted(t) => { root.history-failed-layer(i, t); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        VerticalLayout { width: 320px; spacing: 20px; alignment: start;
            Card {
                title: root.printer-name;
                subtitle: root.material-name != "" ? @tr("Resin: {}", root.material-name) : "";
                HorizontalLayout { alignment: center;
                    Rectangle { width: 180px; height: 180px; border-radius: 10px; background: ShellTheme.field;
                        if root.printer-picture.width > 0: Image { x: 6px; y: 6px; width: 168px; height: 168px; source: root.printer-picture; image-fit: contain; }
                    }
                }
                Button { text: @tr("Edit printer..."); icon: @image-url("icons/gear.svg"); clicked => { root.edit-printer(); } }
                Button { text: @tr("Calibration tools..."); clicked => { root.calibration-tools(); } }
                Button { text: @tr("Calibrate time estimate..."); clicked => { root.calibrate-estimate(); } }
                if root.estimate-correction != "": HorizontalLayout { spacing: 8px;
                    Text { text: root.estimate-correction; color: ShellTheme.muted; font-size: 12px; wrap: word-wrap; horizontal-stretch: 1; vertical-alignment: center; }
                    Button { text: @tr("Reset"); clicked => { root.reset-estimate(); } }
                }
                Fold {
                    title: @tr("Hardware details");
                    InfoLine { label: @tr("Model"); value: root.printer-model; }
                    InfoLine { label: @tr("Build volume"); value: root.build-volume; }
                    InfoLine { label: @tr("LCD"); value: root.resolution; }
                    InfoLine { label: @tr("Output"); value: root.output; }
                }
            }
        }
    }
}

export component ProjectPage inherits Rectangle {
    in property <string> project-name;
    in property <string> project-path;
    in property <bool> dirty;
    in property <[PlateRow]> plates;
    in property <string> totals;
    in property <bool> has-scene;
    callback save();
    callback save-as();
    callback slice-all();
    callback export-all();
    callback open-plate(int);
    background: ShellTheme.background;

    VerticalLayout {
        padding: 24px; spacing: 20px; alignment: start;
        Card {
            title: root.project-name;
            subtitle: root.project-path == "" ? @tr("Not saved yet") : root.project-path;
            HorizontalLayout { spacing: 8px; alignment: start;
                Text { text: root.dirty ? @tr("Unsaved changes") : @tr("All changes saved"); color: root.dirty ? ShellTheme.warning : ShellTheme.muted; vertical-alignment: center; }
                Rectangle { width: 12px; }
                Button { text: @tr("Save"); enabled: root.has-scene; clicked => { root.save(); } }
                Button { text: @tr("Save as..."); enabled: root.has-scene; clicked => { root.save-as(); } }
            }
        }
        Card {
            title: @tr("Plates");
            subtitle: root.totals;
            HorizontalLayout { spacing: 8px; alignment: start;
                PrimaryButton { text: @tr("Slice all plates"); icon: @image-url("icons/slice.svg"); enabled: root.has-scene; clicked => { root.slice-all(); } }
                Button { text: @tr("Export all..."); icon: @image-url("icons/export.svg"); enabled: root.has-scene; clicked => { root.export-all(); } }
            }
            // Table header.
            HorizontalLayout { spacing: 12px; padding-left: 12px; padding-right: 12px;
                Text { text: @tr("Plate"); color: ShellTheme.muted; font-size: 12px; horizontal-stretch: 1; }
                Text { text: @tr("Objects"); color: ShellTheme.muted; font-size: 12px; width: 70px; horizontal-alignment: right; }
                Text { text: @tr("Slice"); color: ShellTheme.muted; font-size: 12px; width: 110px; }
                Text { text: @tr("Layers"); color: ShellTheme.muted; font-size: 12px; width: 70px; horizontal-alignment: right; }
                Text { text: @tr("Print time"); color: ShellTheme.muted; font-size: 12px; width: 90px; horizontal-alignment: right; }
            }
            for plate[i] in root.plates: Rectangle {
                height: 40px; border-radius: 4px;
                accessible-role: button;
                accessible-label: @tr("Open plate {}", plate.number);
                accessible-action-default => { root.open-plate(i); }
                background: row-touch.has-hover ? ShellTheme.field : plate.active ? ShellTheme.accent.transparentize(0.88) : transparent;
                HorizontalLayout { spacing: 12px; padding-left: 12px; padding-right: 12px;
                    Text { text: plate.name; color: ShellTheme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    Text { text: plate.objects; color: ShellTheme.text; vertical-alignment: center; width: 70px; horizontal-alignment: right; }
                    Text { text: plate.status; color: plate.stale ? ShellTheme.warning : ShellTheme.muted; vertical-alignment: center; width: 110px; }
                    Text { text: plate.layers > 0 ? plate.layers : "—"; color: ShellTheme.text; vertical-alignment: center; width: 70px; horizontal-alignment: right; }
                    Text { text: plate.time == "" ? "—" : plate.time; color: ShellTheme.text; vertical-alignment: center; width: 90px; horizontal-alignment: right; }
                }
                row-touch := TouchArea { mouse-cursor: pointer; clicked => { root.open-plate(i); } }
            }
        }
    }
}
