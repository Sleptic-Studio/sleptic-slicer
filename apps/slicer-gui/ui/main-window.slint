// Noto Sans is built into the program and registered for the whole
// process, so laying out text never searches the system's fonts
// (through fontconfig that froze the UI the first time a menu opened).
import "../assets/fonts/NotoSans-Variable.ttf";

export { MotionField, AboutWindow, AxisView, ErrorDialog, ExtendDialog, ForkDialog, InfoDialog, PointerModifiers, PreferencesWindow, ProfileViewDialog, ShortcutGroup, ShortcutRow, ShortcutsDialog, SliceOverwriteDialog, ThemePreference }

// One setting row of the left Settings panel, as Rust lists them.
export struct SettingRow {
    id: int, label: string, units: string, value: string, modified: bool, level: int, help: string, minimum: float, maximum: float, step: float,
}

export struct PlateOverlay { id: int, index: int, slot: int, x: float, y: float, w: float, h: float, locked: bool, glyph-path: string, tile-path: string }

// Where a file load is, for its progress panel; Rust maps its worker's
// phases onto these.
export enum OpenStep { Reading, Meshing, Uploading }

// Where a save or export is, for its progress panel (one line each).
// Rust maps its worker's phases onto these. Only an export flattens (STL
// needs the scene as one mesh); a save starts at Serializing.
export enum WriteStep { Flattening, Serializing, Compressing, Writing }

// How the menus are shown: `Bar` along the top, `Compact` behind a
// button to save the height. Saved for the whole app; Rust always uses
// `Bar` on macOS, whose menu bar is the system's.
export enum MenuLayout { Bar, Compact }

// The window's section: `Prepare` (checks and repairs), `Transform`
// (moving, turning and scaling parts) or `Slice`. Each window has its
// own and it is not saved; Rust opens a file in the section its mesh
// health calls for.
export enum WorkspaceSection { Prepare, Transform, Slice }

// A section tab of the switcher: tinted when its section is open. A
// click goes to the window, which asks Rust to switch.
component WorkTab inherits Rectangle {
    in property <string> caption;
    in property <bool> current;
    in property <image> icon;
    // What a screen reader calls a tab that shows only its icon.
    in property <string> name;
    callback chosen();

    // An icon-only tab is narrower.
    property <length> side: root.caption == "" ? 10px : 14px;
    property <brush> ink: root.current ? ShellTheme.accent-text : Palette.foreground;

    border-radius: 12px;
    // The open tab is filled; another shades while the pointer is on it.
    background: root.current ? ShellTheme.accent : touch.has-hover ? ShellTheme.field : transparent;
    accessible-role: button;
    accessible-label: root.caption != "" ? root.caption : root.name;
    accessible-action-default => { root.chosen(); }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.chosen(); }
    }

    HorizontalLayout {
        // About 30 px tall: one line of text with room above and below.
        min-height: 30px;
        padding-left: root.side;
        padding-right: root.side;
        spacing: 7px;

        if root.icon.width > 0: VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: 16px;
                height: 16px;
                colorize: root.ink;
            }
        }

        Text {
            text: root.caption;
            color: root.ink;
            font-weight: root.current ? 700 : 400;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// Orca / Bambu-style value box: the number and its unit in one bordered
// field. Up / Down keys and the mouse wheel step it (no stepper buttons).
component ValueBox inherits Rectangle {
    in property <string> unit;
    in-out property <string> text;
    in property <string> placeholder;
    in property <string> name;
    in property <string> help;
    callback accepted(string);
    callback step(int);
    width: 104px;
    height: 28px;
    border-radius: 4px;
    // Same well as the std inputs and combo boxes around it (white in light).
    background: ShellTheme.light ? #ffffff : ShellTheme.field;
    border-width: 1px;
    border-color: input.has-focus ? ShellTheme.accent : box-touch.has-hover ? ShellTheme.muted : ShellTheme.light ? #c9cdd3 : ShellTheme.border;
    box-touch := TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
        scroll-event(e) => {
            if !input.has-focus || e.delta-y == 0 { return reject; }
            root.step(e.delta-y > 0 ? 1 : -1);
            accept
        }
        HorizontalLayout {
            padding-left: 8px; padding-right: 8px; spacing: 4px;
            Rectangle { horizontal-stretch: 1; clip: true;
                if input.text == "" && !input.has-focus: Text { width: 100%; text: root.placeholder; color: ShellTheme.muted; horizontal-alignment: right; vertical-alignment: center; font-size: 13px; }
                input := TextInput {
                    width: 100%; height: 100%;
                    text <=> root.text;
                    accessible-role: text-input;
                    accessible-label: root.name;
                    accessible-description: root.help;
                    horizontal-alignment: right; vertical-alignment: center;
                    single-line: true; input-type: decimal;
                    color: ShellTheme.text; font-size: 13px;
                    accepted => { root.accepted(self.text); }
                    key-pressed(e) => {
                        if e.text == Key.UpArrow { root.step(1); return accept; }
                        if e.text == Key.DownArrow { root.step(-1); return accept; }
                        reject
                    }
                }
            }
            if root.unit != "": Text { text: root.unit; color: ShellTheme.muted; font-size: 11px; vertical-alignment: center; }
        }
    }
    if root.help != "": Tooltip { text: @markdown("\{root.help}"); }
}

// One sidebar setting, Orca-style: a single-line label (accent when changed
// from the profile) and a value box; the reset arrow shows only when changed.
component SettingField inherits HorizontalLayout {
    in property <SettingRow> setting;
    callback edited(int, string);
    height: 32px;
    spacing: 6px;
    Text { text: root.setting.label; overflow: elide; color: root.setting.modified ? ShellTheme.accent : ShellTheme.text; min-width: 0px; horizontal-stretch: 1; vertical-alignment: center; font-size: 13px; }
    VerticalLayout { alignment: center;
        value-input := ValueBox {
            text: root.setting.value;
            unit: root.setting.units;
            name: root.setting.label;
            help: root.setting.help;
            accepted(t) => { root.edited(root.setting.id, t); }
            step(d) => {
                root.edited(root.setting.id, "" + Math.max(root.setting.minimum, Math.min(root.setting.maximum, root.setting.value.to-float() + d * root.setting.step)));
            }
        }
    }
    VerticalLayout { alignment: center; width: 22px;
        if root.setting.modified: Rectangle { width: 22px; height: 22px; border-radius: 4px;
            accessible-role: button; accessible-label: @tr("Reset {}", root.setting.label);
            accessible-action-default => { root.edited(root.setting.id, ""); }
            background: reset-touch.has-hover ? ShellTheme.field : transparent;
            Image { source: @image-url("icons/reset.svg"); width: 14px; height: 14px; x: 4px; y: 4px; colorize: ShellTheme.muted; }
            reset-touch := TouchArea { mouse-cursor: pointer; clicked => { root.edited(root.setting.id, ""); } }
        }
    }
    changed setting => { value-input.text = root.setting.value; }
}

// A free-text numeric setting in the same row style as SettingField.
component CompactField inherits HorizontalLayout {
    in property <string> label;
    in property <string> unit;
    in-out property <string> value;
    height: 32px;
    spacing: 6px;
    Text { text: root.label; overflow: elide; color: ShellTheme.text; min-width: 0px; horizontal-stretch: 1; vertical-alignment: center; font-size: 13px; }
    VerticalLayout { alignment: center;
        ValueBox { text <=> root.value; unit: root.unit; name: root.label;
            step(d) => { root.value = "" + Math.max(0, root.value.to-float() + d); }
        }
    }
    Rectangle { width: 22px; }
}

// Floating tool panel (supports, hollow): title row with a close button over
// the panel surface; content is placed by the user below y = 48px.
component ToolPanel inherits Rectangle {
    in property <string> title;
    callback close();
    background: ShellTheme.panel; border-radius: ShellTheme.radius;
    border-color: ShellTheme.border; border-width: 1px;
    drop-shadow-blur: 12px; drop-shadow-offset-y: 4px; drop-shadow-color: #00000040;
    HorizontalLayout { y: 0px; height: 44px; padding-left: 12px; padding-right: 8px; spacing: 8px;
        Text { text: root.title; color: ShellTheme.text; font-size: 14px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
        VerticalLayout { alignment: center;
            Rectangle { width: 28px; height: 28px; border-radius: 4px;
                accessible-role: button; accessible-label: @tr("Close {}", root.title);
                accessible-action-default => { root.close(); }
                background: close-touch.has-hover ? ShellTheme.field : transparent;
                Path { x: 9px; y: 9px; width: 10px; height: 10px; viewbox-width: 10; viewbox-height: 10;
                    commands: "M 0 0 L 10 10 M 10 0 L 0 10"; stroke: close-touch.has-hover ? ShellTheme.text : ShellTheme.muted; stroke-width: 1.5px; }
                close-touch := TouchArea { mouse-cursor: pointer; clicked => { root.close(); } }
            }
        }
    }
    @children
}

// Sub-heading inside a tool panel.
component PanelSection inherits VerticalLayout {
    in property <string> title;
    padding-top: 8px;
    spacing: 4px;
    Text { text: root.title; color: ShellTheme.muted; font-size: 11px; font-weight: 600; }
    Rectangle { height: 1px; background: ShellTheme.border; }
}

// Numeric field for tool panels: a wide label column (labels are never cut
// off), 64 px value, 32 px unit.
component PanelField inherits HorizontalLayout {
    in property <string> label;
    in property <string> unit;
    in-out property <string> value;
    height: 34px;
    spacing: 6px;
    Text { text: root.label; color: ShellTheme.text; min-width: 0px; horizontal-stretch: 1; vertical-alignment: center; font-size: 13px; overflow: elide; }
    VerticalLayout { alignment: center;
        ValueBox { width: 96px; text <=> root.value; unit: root.unit; name: root.label;
            step(d) => { root.value = "" + Math.max(0, root.value.to-float() + d * (root.value.to-float() < 2 ? 0.1 : 1)); }
        }
    }
}

// Label / value line in the right-hand information cards.
component InfoRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 8px;
    Text { text: root.label; color: ShellTheme.muted; width: 64px; }
    Text { text: root.value; color: ShellTheme.text; horizontal-stretch: 1; overflow: elide; }
}

// Small chevron button above / below the preview layer slider.
component LayerStepButton inherits Rectangle {
    in property <bool> up;
    callback clicked();
    width: 28px; height: 24px; border-radius: ShellTheme.radius;
    background: step-touch.has-hover ? ShellTheme.border : ShellTheme.field;
    accessible-role: button;
    accessible-label: root.up ? @tr("Next layer") : @tr("Previous layer");
    accessible-action-default => { root.clicked(); }
    Image { source: root.up ? @image-url("icons/chevron-up.svg") : @image-url("icons/chevron-down.svg"); width: 14px; height: 14px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; colorize: ShellTheme.text; }
    step-touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    property <string> tip: root.up ? @tr("Next layer (Up)") : @tr("Previous layer (Down)");
    Tooltip { text: @markdown("\{root.tip}"); }
}

component IconTool inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <string> disabled-reason;
    property <string> tooltip-text: root.enabled || root.disabled-reason == "" ? root.label : root.label + " - " + root.disabled-reason;
    in property <bool> enabled: true;
    in property <bool> active: false;
    // 0 blue, 1 yellow, 2 red (ShellTheme.icon-tint); -1 plain text colour.
    in property <int> tint: -1;
    callback clicked();
    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.tooltip-text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    width: 36px; height: 36px; border-radius: ShellTheme.radius;
    background: root.active ? ShellTheme.accent.transparentize(0.75) : touch.has-hover ? ShellTheme.field : transparent;
    Image { source: root.icon; width: Math.min(24px, parent.width - 8px); height: self.width; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; colorize: root.enabled ? ShellTheme.icon-tint(root.tint) : ShellTheme.muted; opacity: root.enabled ? 1 : 0.4; }
    touch := TouchArea { mouse-cursor: root.enabled ? pointer : default; clicked => { if root.enabled { root.clicked(); } } }
    Tooltip { text: @markdown("\{root.tooltip-text}"); }
}

// Auto prepare: the one button that orients, arranges and adds supports, so
// it carries its name and the automatic colour (yellow), like Lychee's Magic
// button and PreForm's One-Click Print (R94: a plain cube among 18 icons was
// taken for Auto orient).
component AutoPrepareTool inherits Rectangle {
    in property <bool> enabled: true;
    in property <string> disabled-reason;
    property <string> label: @tr("Auto prepare");
    property <string> tip: @tr("Auto prepare: orient, arrange and add supports");
    callback clicked();
    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.tip;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    height: 36px; border-radius: ShellTheme.radius;
    border-width: 1px; border-color: root.enabled ? ShellTheme.icon-yellow.transparentize(0.4) : ShellTheme.border;
    background: touch.has-hover && root.enabled ? ShellTheme.icon-yellow.transparentize(0.82) : transparent;
    opacity: root.enabled ? 1 : 0.5;
    HorizontalLayout {
        padding-left: 8px; padding-right: 10px; spacing: 6px;
        VerticalLayout { alignment: center; Image { source: @image-url("icons/auto-prepare.svg"); width: 20px; height: 20px; colorize: root.enabled ? ShellTheme.icon-yellow : ShellTheme.muted; } }
        Text { text: root.label; vertical-alignment: center; color: ShellTheme.text; font-weight: 600; }
    }
    touch := TouchArea { mouse-cursor: root.enabled ? pointer : default; clicked => { if root.enabled { root.clicked(); } } }
    Tooltip { text: @markdown("\{root.enabled || root.disabled-reason == "" ? root.tip : root.tip + " - " + root.disabled-reason}"); }
}

// Surface of every dropdown and popover: panel colour, hairline border and a
// soft shadow so it reads as floating above the panel it opened from.
component MenuSurface inherits Rectangle {
    background: ShellTheme.panel;
    border-color: ShellTheme.border; border-width: 1px; border-radius: ShellTheme.radius;
    drop-shadow-blur: 12px; drop-shadow-offset-y: 4px; drop-shadow-color: #00000040;
}

// One dropdown row: icon, label and shortcut, highlighted across its full
// width on hover. The accessible label keeps the shortcut ("Undo (Ctrl+Z)")
// so it matches the toolbar button it stands in for.
component MenuRow inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <string> shortcut;
    in property <bool> enabled: true;
    callback clicked();
    accessible-role: button;
    accessible-label: root.shortcut == "" ? root.label : root.label + " (" + root.shortcut + ")";
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    height: 32px;
    border-radius: 4px;
    background: touch.has-hover && root.enabled ? ShellTheme.field : transparent;
    HorizontalLayout {
        padding-left: 10px; padding-right: 12px; spacing: 10px;
        if root.icon.width > 0: VerticalLayout { alignment: center;
            Image { source: root.icon; width: 18px; height: 18px; colorize: root.enabled ? ShellTheme.text : ShellTheme.muted; opacity: root.enabled ? 1 : 0.5; } }
        Text { text: root.label; horizontal-stretch: 1; vertical-alignment: center; font-size: 13px; color: root.enabled ? ShellTheme.text : ShellTheme.muted; }
        if root.shortcut != "": Text { text: root.shortcut; vertical-alignment: center; font-size: 12px; color: ShellTheme.muted; }
    }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: root.enabled ? pointer : default; clicked => { root.clicked(); } }
}

component MenuSeparator inherits Rectangle {
    height: 9px;
    Rectangle { x: 8px; y: 4px; width: parent.width - 16px; height: 1px; background: ShellTheme.border; }
}

// The arrow half of a split button: the main button's height, chevron
// centred both ways; `accent` matches the filled Slice button.
component DropArrow inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> accent: false;
    callback clicked();
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    width: 28px; height: 36px;
    border-radius: ShellTheme.radius;
    border-width: root.accent ? 0px : 1px; border-color: ShellTheme.border;
    background: root.accent
        ? (!root.enabled ? ShellTheme.field : touch.has-hover ? ShellTheme.accent-hover : ShellTheme.accent)
        : (touch.has-hover && root.enabled ? ShellTheme.field : ShellTheme.panel);
    Image {
        source: @image-url("icons/chevron-down.svg");
        width: 16px; height: 16px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        colorize: root.accent && root.enabled ? ShellTheme.accent-text : ShellTheme.text;
        opacity: root.enabled ? 1 : 0.45;
    }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: root.enabled ? pointer : default; clicked => { root.clicked(); } }
    Tooltip { text: @markdown("\{root.label}"); }
}


// A block title in the settings sidebar (Printer, Material, Process), on a
// tinted band like Orca's, with its actions on the right.
component SidebarBar inherits Rectangle {
    in property <string> title;
    in property <image> icon;
    height: 34px; border-radius: 6px; background: ShellTheme.field;
    HorizontalLayout {
        padding-left: 8px; padding-right: 2px; spacing: 8px;
        VerticalLayout { alignment: center; Image { source: root.icon; width: 16px; height: 16px; colorize: ShellTheme.icon-tint(0); } }
        Text { text: root.title; color: ShellTheme.text; font-size: 14px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
        @children
    }
}

// A picture beside a picker, as Orca shows the printer (R99): our own
// drawings in layers, never vendor photos.
component PictureTile inherits Rectangle {
    width: 56px; height: 56px; border-radius: 6px; background: ShellTheme.field;
    @children
}

// One printer or resin in the "More printers / More resins" chooser (R101).
export struct ChooserRow {
    // Not empty: a heading line (a brand's series, or a resin kind), not a choice.
    heading: string,
    label: string,
    picture: image,
    // Shown in the sidebar dropdown (a favourite).
    in-list: bool,
    // The current choice.
    current: bool,
}

// One level of the Simple / Advanced / Expert switch.
component LevelTab inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    border-radius: 11px;
    background: root.active ? ShellTheme.accent : transparent;
    Text { text: root.label; font-size: 12px; color: root.active ? ShellTheme.accent-text : ShellTheme.text; font-weight: root.active ? 700 : 400; horizontal-alignment: center; vertical-alignment: center; }
    TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// A category tab under Process: bold and underlined in blue when active.
component SettingsTab inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();
    accessible-role: tab;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    min-width: label-text.preferred-width + 14px;
    label-text := Text { text: root.label; font-size: 13px; color: root.active ? ShellTheme.text : ShellTheme.muted; font-weight: root.active ? 700 : 400; horizontal-alignment: center; vertical-alignment: center; }
    if root.active: Rectangle { y: parent.height - 2px; height: 2px; width: label-text.preferred-width; x: 7px; background: ShellTheme.accent; }
    TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// A section title inside a settings tab (Orca: icon and bold title).
component SettingsSection inherits HorizontalLayout {
    in property <string> title;
    in property <image> icon;
    padding-top: 8px; padding-bottom: 2px; spacing: 6px; height: 34px;
    if root.icon.width > 0: VerticalLayout { alignment: center; Image { source: root.icon; width: 14px; height: 14px; colorize: ShellTheme.icon-tint(0); } }
    Text { text: root.title; color: ShellTheme.text; font-size: 13px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
}

component StatTile inherits Rectangle {
    in property <image> icon;
    in property <string> value;
    in property <string> label;
    // When set, a link replaces the value (e.g. "Set resin price" for Cost).
    in property <string> action-text;
    callback action();
    height: 32px;
    HorizontalLayout {
        spacing: 8px;
        Image { source: root.icon; width: 16px; colorize: ShellTheme.muted; }
        Text { text: root.label; color: ShellTheme.muted; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
        if root.action-text == "": Text { text: root.value; color: ShellTheme.text; font-size: 13px; vertical-alignment: center; }
        if root.action-text != "": Text {
            text: root.action-text; color: ShellTheme.accent; font-size: 13px; vertical-alignment: center;
            accessible-role: button; accessible-label: root.action-text;
            accessible-action-default => { root.action(); }
            TouchArea { mouse-cursor: pointer; clicked => { root.action(); } }
        }
    }
}

export component MainWindow inherits Window {
    // The open file's name, starred while it has unsaved changes, or the
    // app's name when nothing is open.
    title: root.project-title != ""
        ? (root.unsaved-changes ? "* " : "") + root.project-title
        : @tr("Sleptic Slicer");
    icon: @image-url("../assets/images/sleptic.svg");
    default-font-family: "Noto Sans";

    min-height: 700px;
    min-width: 1100px;
    preferred-width: 1600px;
    preferred-height: 1000px;

    default-font-size: 13px;
    background: ShellTheme.background;
    callback sidebar-changed();
    changed printer-expanded => { root.sidebar-changed(); }
    changed material-expanded => { root.sidebar-changed(); }
    changed process-expanded => { root.sidebar-changed(); }
    changed export-format => { root.sidebar-changed(); }
    changed motion-expanded => { root.sidebar-changed(); }
    changed supports-expanded => { root.sidebar-changed(); }
    // One floating tool panel at a time: they share the same spot.
    changed supports-tool-active => { if root.supports-tool-active { root.hollow-tool-active = false; root.model-tools-active = false; } }
    changed hollow-tool-active => { if root.hollow-tool-active { root.supports-tool-active = false; root.model-tools-active = false; } }
    changed model-tools-active => { if root.model-tools-active { root.supports-tool-active = false; root.hollow-tool-active = false; } }
    property <bool> material-matches: root.settings-search == "" || root.settings-match(@tr("Normal exposure") + " " + @tr("Bottom exposure") + " " + @tr("Bottom layers") + " " + @tr("Transition layers") + " " + @tr("Light-off delay"), root.settings-search);
    property <bool> supports-matches: root.settings-search == "" || root.settings-match(@tr("Enable supports") + " " + @tr("Support preset") + " " + @tr("Support spacing") + " " + @tr("Overhang angle") + " " + @tr("Symmetric supports (detected models)") + " " + @tr("Tip contact diameter") + " " + @tr("Tip length") + " " + @tr("Contact depth") + " " + @tr("Shaft diameter") + " " + @tr("Tree supports") + " " + @tr("Branch angle limit") + " " + @tr("Min column diameter") + " " + @tr("Max column diameter") + " " + @tr("Lift") + " " + @tr("Raft") + " " + @tr("Lattice raft") + " " + @tr("Skate raft (pads under the columns)") + " " + @tr("Raft thickness") + " " + @tr("Raft margin") + " " + @tr("Base diameter") + " " + @tr("Base height"), root.settings-search);
    property <bool> quality-matches: root.settings-search == "" || root.settings-match(@tr("Layer height") + " " + @tr("First layer height") + " " + @tr("Anti-aliasing") + " " + @tr("AA gray levels") + " " + @tr("Bottom compensation") + " " + @tr("XY compensation"), root.settings-search);
    property <bool> others-matches: root.settings-search == "" || root.settings-match(@tr("Arrange gap"), root.settings-search);
    property <bool> motion-matches: root.settings-search == "" || root.settings-match(@tr("Lift distance") + " " + @tr("Lift speed") + " " + @tr("Retract speed"), root.settings-search);
    property <bool> process-matches: root.settings-search == "" || root.settings-match(@tr("Layer height") + " " + @tr("First layer height") + " " + @tr("Anti-aliasing") + " " + @tr("AA gray levels") + " " + @tr("Bottom compensation") + " " + @tr("XY compensation") + " " + @tr("Arrange gap"), root.settings-search);
    // Move (0) / Rotate (1) / Scale (2); -1 = no tool, the default: a
    // selected part shows no gizmo until a tool is picked, as in Orca.
    in-out property <int> active-tool: -1;
    // Toolbar icon size: Orca-like 30 px below 1600 px wide so every main
    // tool fits at 1280; 36 px on wide windows.
    property <length> tool-w: root.width < 1600px ? 30px : 36px;
    in-out property <int> settings-level: 1;
    // Simple mode keeps the toolbar to the everyday tools (R95); Fill plate,
    // copies, model tools and Measure move into More.
    property <bool> simple-tools: root.settings-level == 0;
    in-out property <string> settings-search: "";
    // Narrow windows keep the 340 px sidebar so the toolbar and the add-plate
    // button still fit; wide ones get room for long labels.
    in-out property <length> settings-width: root.width < 1500px ? 340px : 372px;
    in-out property <int> export-format: 0;
    in property <[SettingRow]> process-settings;
    in property <string> printer-summary;
    in property <string> estimated-weight-text;
    in property <string> exposure-summary;
    in property <string> layer-z-text;
    in property <string> layer-detail-text;
    in property <[float]> layer-areas;
    in-out property <bool> benchmark-preview: false;
    in-out property <int> benchmark-frames: 0;
    in-out property <float> benchmark-fps: 0;
    // Preview opens on the 3D view of the sliced plate (R95: the top layer
    // alone often looked nearly empty, as if slicing had failed).
    in-out property <bool> preview-3d: true;
    in property <float> preview-plate-aspect: 1.6;
    in-out property <float> preview-zoom: 1;
    in-out property <length> preview-pan-x: 0px;
    in-out property <length> preview-pan-y: 0px;
    in property <string> process-summary;
    in property <string> mirror-summary;
    in-out property <int> process-aa-index: 0;
    in property <bool> process-aa-modified;
    callback process-aa-picked(int);
    // Place on face (after Orca): the button toggles the tool; the
    // controller shows the model's flat sides and places the clicked one.
    callback place-face-tool-changed();
    in-out property <int> machine-tool: -1;
    in-out property <bool> calibration-menu-open: false;
    in-out property <int> verification-popup: 0;
    in-out property <string> machine-measured-x: "100";
    in-out property <string> machine-measured-y: "100";
    in-out property <bool> machine-mirror-x;
    in-out property <bool> machine-mirror-y;
    in-out property <int> machine-rotation;
    in-out property <string> machine-message;
    callback machine-opened();
    callback machine-create();
    callback machine-record();
    changed machine-tool => {if root.machine-tool >= 0 {root.machine-opened();}}
    in-out property <bool> calibration-open:false;
    in-out property <string> calibration-start:"1.5";
    in-out property <string> calibration-step:"0.5";
    in-out property <string> calibration-count:"4";
    in-out property <string> calibration-list;
    in-out property <string> calibration-message;
    in-out property <[string]> calibration-tiles;
    in-out property <int> calibration-best:0;
    callback calibration-opened();
    changed calibration-open => {if root.calibration-open {root.calibration-opened();}}
    callback calibration-create();
    callback calibration-record();
    // Overhang test (R80): place it, then record the flattest clean ledge
    // (index into 30..80 degrees) as the selected resin's support angle.
    in-out property <bool> overhang-test-open: false;
    in-out property <string> overhang-test-message;
    in-out property <int> overhang-test-best: 1;
    callback overhang-test-create();
    callback overhang-test-record(int);
    callback auto-orient-requested();
    callback orient-preset-changed(int);
    in-out property <int> orient-preset: 0;
    in-out property <bool> orient-advanced: false;
    in-out property <bool> orient-options-open:false;
    in-out property <bool> orient-for-supports: true;
    in-out property <float> orient-convenience-weight: 25;
    in-out property <int> orient-zero-support-head-start: 10;
    in-out property <float> orient-support-weight: 25;
    in-out property <float> orient-height-weight: 25;
    in-out property <float> orient-quality-weight: 25;
    in-out property <float> orient-footprint-weight: 0.5;
    function set-orient-preset(index: int) {
        root.orient-preset = index;
        root.orient-convenience-weight = 25;
        root.orient-support-weight = index == 1 ? 62.5 : index == 2 ? 5 : index == 3 ? 17.5 : index == 4 ? 6.25 : 25;
        root.orient-height-weight = index == 1 ? 15 : index == 2 ? 100 : index == 3 ? 17.5 : index == 4 ? 10 : 25;
        root.orient-quality-weight = index == 1 ? 12.5 : index == 2 ? 7.5 : index == 3 ? 100 : index == 4 ? 7.5 : 25;
        root.orient-footprint-weight = index == 4 ? 500 : index == 0 ? 0.5 : 0.25;
        root.orient-preset-changed(index);
    }
    in-out property <string> arrange-gap-mm: "3";
    callback arrange-requested();
    callback mirror-requested(int);
    callback recipes-requested();
    callback recipe-selected(int);
    callback recipe-edit(int);
    callback recipe-run();
    callback recipe-cancel();
    in-out property <bool> recipes-visible: false;
    in-out property <bool> recipe-busy: false;
