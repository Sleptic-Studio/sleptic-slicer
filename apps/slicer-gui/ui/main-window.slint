    in-out property <int> model-tool-mode: 0;
    in-out property <bool> simplify-busy: false;
    in-out property <float> simplify-progress: 0;
    callback model-tool-cancel();
    in-out property <string> simplify-target: "50";
    in-out property <bool> simplify-percentage: true;
    in-out property <string> simplify-deviation: "0.02";
    in-out property <string> cut-z-mm: "10";
    in-out property <int> cut-keep: 2;
    in-out property <bool> cut-cap: true;
    in-out property <string> label-text: "Sleptic";
    in-out property <string> label-size-mm: "3.5";
    in-out property <string> label-depth-mm: "0.5";
    in-out property <bool> label-engrave: false;
    in-out property <int> boolean-operation: 1;
    in-out property <string> model-tool-error;
    in property <[MeasureMarker]> cut-plane-markers;
    callback model-tool-requested(int);
    callback model-tool-evidence(int);
    callback cut-plane-dragged(float);
    in property <[MeasureMarker]> measure-markers;
    callback measure-evidence-requested();
    in-out property <bool> drain-tool-active: false;
    in-out property <int> expanded-risk-kind: -1;
    in-out property <bool> hollow-tool-active: false;
    in-out property <string> hollow-saved-text;
    in-out property <int> suction-cup-count: 0;
    callback hollow-requested(bool);
    in-out property <bool> printer-expanded: true;
    in-out property <bool> material-expanded: true;
    in-out property <bool> process-expanded: true;
    in-out property <bool> motion-expanded: true;
    in-out property <bool> supports-expanded: true;
    // Raft type, one choice (R105; three separate checkboxes allowed
    // contradictions): 0 none, 1 solid, 2 lattice (least peel), 3 skate pads.
    // Kept in step both ways with the three settings Rust reads and presets set.
    in-out property <int> support-raft-kind: 1;
    changed support-raft-kind => {
        root.support-raft = root.support-raft-kind > 0;
        root.support-lattice-raft = root.support-raft-kind == 2;
        root.support-skate-raft = root.support-raft-kind == 3;
    }
    function raft-kind-from-settings() {
        root.support-raft-kind = !root.support-raft ? 0 : root.support-skate-raft ? 3 : root.support-lattice-raft ? 2 : 1;
    }
    changed support-raft => { root.raft-kind-from-settings(); }
    changed support-lattice-raft => { root.raft-kind-from-settings(); }
    changed support-skate-raft => { root.raft-kind-from-settings(); }
    // The sidebar tab: 0 Quality, 1 Exposure, 2 Lift, 3 Supports, 4 Others (R98).
    in-out property <int> settings-tab: 0;
    // The selected resin's colour for its bottle picture, guessed from its
    // name (profiles have no colour field); grey like most standard resins.
    in property <color> resin-color: #9aa0a6;
    // The resin colour palette beside the Resin dropdown (R121); the
    // models are drawn in `resin-color`.
    in property <[color]> resin-swatches: [];
    in property <[string]> resin-swatch-names: [];
    callback resin-color-picked(int);
    // Each profile's own picture (R100); empty falls back to the drawing.
    in property <image> printer-picture;
    in property <image> resin-picture;
    // The full-catalog chooser behind the dropdowns' last row, as Orca's
    // "Add/Remove printers" (R101): 0 closed, 1 printers, 2 resins.
    in-out property <int> chooser-kind: 0;
    in property <[ChooserRow]> chooser-rows: [];
    // The brands to filter by, "All" first; the one shown.
    in property <[string]> chooser-brands: [];
    in-out property <int> chooser-brand: 0;
    callback chooser-brand-picked(int);
    in-out property <string> chooser-search;
    callback chooser-search-edited(string);
    callback chooser-picked(int);
    callback chooser-star(int);
    callback chooser-open-requested(int);
    changed settings-tab => { root.sidebar-changed(); }
    in property <string> object-volume-text;
    callback process-setting-edited(int, string);
    pure callback settings-match(string, string) -> bool;
    in property <bool> slice-export-ready: false;
    in property <bool> slice-failed: false;
    in property <string> slice-failure-message;
    in-out property <string> slice-recovery-message;
    in property <image> view-ready;
    in property <bool> busy-opening: false;
    in property <bool> scene-present: false;
    in property <bool> undo-available: false;
    in property <bool> redo-available: false;
    // The scene has changes not yet saved (from the document); the title
    // then starts with `*`.
    in property <bool> unsaved-changes: false;
    // The open file's name with its extension, from the document; empty
    // with nothing open, and the title then shows the app's name.
    in property <string> project-title: "";
    // Recently opened files, most-recent-first, shown as full paths in
    // the File > Open Recent submenu. Empty until the first file is
    // opened; the submenu is disabled while empty.
    in property <[string]> recent-files: [];
    // Top-level page beside the Prepare/Preview workspace: 0 = workspace,
    // 1 = Home, 2 = Device, 3 = Project. Rust refreshes a page's data on
    // hub-page-opened.
    in-out property <int> hub-page: 0;
    callback hub-page-opened(int);
    // Opening anything from Home (drop, File menu, recent) lands on Prepare.
    changed busy-opening => { if root.busy-opening && root.hub-page == 1 { root.hub-page = 0; } }
    in property <[RecentProject]> home-recent;
    callback new-project-requested();
    callback remove-recent-requested(int);
    in property <string> device-printer-name;
    in property <string> device-printer-model;
