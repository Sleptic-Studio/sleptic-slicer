    in-out property <bool> units-hint-visible: false;
    // "No supports needed" banner after Generate supports / Auto prepare;
    // empty hides it (Rust clears it after a few seconds).
    in-out property <string> support-notice-text: "";
    in property <string> units-hint-text;
    callback units-conversion-requested(float);
    // Scale fields edit all three axes together while this is on (default).
    in-out property <bool> scale-uniform: true;
    callback profile-edit-requested(bool);
    in property <string> position-x-text: "";
    in property <string> position-y-text: "";
    in property <string> position-z-text: "";
    // Fired when a Position field commits (Enter or focus-loss), with
    // its raw (unparsed) text; the Rust side parses and validates.
    callback position-x-committed(string);
    callback position-y-committed(string);
    callback position-z-committed(string);
    // Read-only world-space bounding-box size (mm) for the selected
    // object, recomputed alongside the Position fields above. Empty
    // while nothing is selected, or for a leaf with no renderable
    // geometry. See `transform-panel.slint`.
    in property <string> bbox-x-text: "";
    in property <string> bbox-y-text: "";
    in property <string> bbox-z-text: "";
