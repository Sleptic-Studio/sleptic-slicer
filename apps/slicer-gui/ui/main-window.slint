    callback projection-toggled(bool);
    callback scale-to-fit-requested();
    callback drop-to-plate-requested();
    // A file is being dragged over the window (Rust sets this between
    // winit's `HoveredFile` and `DroppedFile` or `HoveredFileCancelled`); it
    // shows the "Drop to open" overlay. Not on Wayland until winit can
    // drag and drop there.
    in property <bool> file-over-window: false;
    // A file is being read: from the moment one is picked and sent to the
    // loader until the load ends, however it ends. Shows the load panel.
    // Not `loading`, which is set as soon as the file dialog opens.
    in property <bool> opening: false;
    // Where the load is and how far (0 to 1), read from Rust while it runs.
    in property <OpenStep> open-step: OpenStep.Reading;
    in property <float> open-fraction: 0.0;
    // A save is being written, from its start until it ends however it
    // ends: shows the save panel and turns the Save commands off. Its phase
    // and progress (0 to 1) are read from Rust meanwhile.
    in property <bool> saving: false;
    in property <WriteStep> save-step: WriteStep.Serializing;
    in property <float> save-fraction: 0.0;
    in property <ThemePreference> theme: ThemePreference.System;
    in property <[bool]> object-visibility;
    callback object-visibility-toggled(int);
    in property <[StandardListViewItem]> parts-list: [];
    // "N objects · M triangles" subtitle for the object-list panel,
    // recomputed alongside `object-list` on every scene install /
    // structural mutation. Empty while no scene is loaded.
    in property <string> object-list-stats-text: "";
    in-out property <int> chosen-part-row: -1;
    in-out property <[bool]> selected-object-rows;
    in-out property <bool> parts-panel-shown: true;
    // The right-hand panel slides in and out (R109): its width, which the
    // 3D view and the overlays beside it follow.
    out property <length> right-panel-w: root.parts-panel-shown ? 284px : 0px;
    animate right-panel-w { duration: 180ms; easing: ease-in-out; }
    // The space the right panel takes, without the slide (R113): the 3D
    // view and its overlays resize once. Following the animated width
    // resized the GPU surface every frame, which flashed the view.
    out property <length> right-panel-space: root.parts-panel-shown ? 284px : 0px;
    // Models on the plate, support rows not counted (R109).
    in property <int> object-model-count;
    // Where the object list floats, saved per window. It keeps to one
    // corner (`anchor-right`, `anchor-bottom`) at `offset-x` / `offset-y`
    // from its edges, so resizing the window leaves it in its corner. A
    // height of 0px fits the rows. It starts top right; Rust restores the
    // last session's place when there was one.
    in-out property <bool> parts-panel-at-right: true;
    in-out property <bool> parts-panel-at-bottom: false;
    in-out property <length> parts-panel-x: 12px;
    in-out property <length> parts-panel-y: 12px;
    in-out property <length> parts-panel-w: 220px;
    in-out property <length> parts-panel-h: 0px;
    in-out property <bool> parts-panel-folded: false;
    // Running on macOS (set by Rust when the window is made): the View menu
    // then shows Cmd+Ctrl+F for full screen instead of F11.
    in property <bool> on-macos: false;
    // Menu bar or compact menu, from the saved preference (always the bar
    // on macOS).
    in property <MenuLayout> menu-style: MenuLayout.Bar;
    // The open section, set by Rust. The switcher shows it, and a click
    // there asks Rust (`section-change-requested`) rather than changing it,
    // so Rust alone decides, as it does when a file opens.
    in property <WorkspaceSection> section: WorkspaceSection.Prepare;
    // The printer and resin lists of the Slice panel, from Rust: the
    // favourites, the default and the scene's own choice. Each
    // `*-current-index` is the chosen entry, -1 for none.
    in property <[string]> printer-choices: [];
    in-out property <int> printer-choice: -1;
    in property <[string]> resin-choices: [];
    // The selected resin's support behaviour, under the resin picker.
    in property <string> resin-support-summary: "";
    in-out property <int> resin-choice: -1;
    in-out property <string> first-layer-text;
    // "Nh Mm" estimated print duration for the held slice, pushed by
    // the Rust side once a slice completes. Empty while no slice is
    // held (see `mirror_slice_layer_count_to_ui`'s doc comment for
    // why it is not recomputed on every scene event).
    in property <string> estimated-print-time-text: "";
    // Estimated resin volume (e.g. "12.3 mL") for the held slice's
    // whole plate (model plus any generated supports actually on it).
    // Empty while no slice is held, same lifecycle as the time
    // estimate above.
    in property <string> estimated-resin-volume-text: "";
    // Estimated resin cost (e.g. "$4.92") for the held slice's whole
    // plate, at the selected resin's configured price. Empty both
    // while no slice is held AND when the resin has no price set
    // (`MaterialDefaults::price_per_liter` is `None`) -- an unpriced
    // resin shows a volume estimate with no cost line, never a
    // fabricated zero.
    in property <string> estimated-resin-cost-text: "";
    // True when the scene changed since the held slice ran, so the
    // estimates above are stale. See `SceneDocument::slice_is_geometry_stale`.
    in property <bool> slice-estimates-stale: false;
    // A slice is running (Rust sets it at the start and clears it on every
    // way out): Slice is off and the progress modal takes the input.
    in-out property <bool> slicing: false;
    // A repair is running (set at its start, cleared on every way out).
    // Repair and undo/redo are off meanwhile: an undo during the run would
    // make the worker's result wrong.
    in-out property <bool> repairing: false;

    out property <color> support-warning-color: ShellTheme.warning;
    in-out property <bool> supports-stale: false;
    in-out property <bool> supports-enabled: false;
    in-out property <bool> supports-tool-active: false;
    in property <int> supports-count: 0;
    in property <string> supports-error;
    callback auto-supports-requested();
    callback remove-supports-requested();
    callback remove-row-supports-requested(int);
    in property <[bool]> object-row-support;
    callback support-paint-requested(float, float, float, int, bool);
    in-out property <string> support-brush-radius-mm: "3";
    callback support-contact-requested(float, float, float, int, bool);
    in-out property <string> support-overhang-angle-deg: "45";
    in-out property <string> support-spacing-mm: "4";
    in-out property <string> support-tip-contact-diameter-mm: "0.4";
    in-out property <string> support-contact-depth-mm: "0.1";
    in-out property <bool> support-lattice-raft: false;
    in-out property <bool> support-skate-raft: false;
    in-out property <string> support-min-column-diameter-mm: "0.8";
    in-out property <string> support-max-column-diameter-mm: "2";
    in-out property <bool> support-tree: true;
    in-out property <string> support-branch-angle-deg: "40";
    in-out property <bool> support-symmetric: false;
    callback support-preset-selected(int);
    in-out property <int> support-preset: 1;
    in-out property <string> support-tip-length-mm: "2";
    in-out property <string> support-shaft-diameter-mm: "1.2";
    in-out property <string> support-base-diameter-mm: "4";
    in-out property <string> support-base-height-mm: "0.6";
    in-out property <string> support-raft-thickness-mm: "1";
    in-out property <string> support-raft-margin-mm: "3";
    in-out property <string> support-lift-mm: "5";
    in-out property <bool> support-raft: true;

    // Support generation run state (Auto prepare and the Supports panel):
    // set when the job starts and cleared when it ends, fails or cannot
    // start; its phase and progress are read from Rust meanwhile.
    in-out property <bool> making-supports: false;
    in property <string> supports-step: "";
    in property <float> supports-fraction: 0.0;

    in property <int> layers-done: 0;
    in property <int> layers-planned: 0;
    in property <float> slice-fraction: 0.0;
    in property <string> slice-plate-label;
    // Set for a moment by Rust when Slice is pressed with nothing changed
    // since the held slice: the Slice panel says it is up to date.
    in property <bool> slice-current: false;
    // Where the Slice panel floats, as for the object list; it starts top
    // left, away from the list. A height of 0px fits the content.
    in-out property <bool> slice-box-at-right: false;
    in-out property <bool> slice-box-at-bottom: false;
    in-out property <length> slice-box-x: 12px;
    in-out property <length> slice-box-y: 12px;
    in-out property <length> slice-box-w: 240px;
    in-out property <length> slice-box-h: 0px;
    // The layer slider. `slice-layer-count` is the held slice's layers (0
    // turns the slider off); `selected-layer-index` is the layer shown, a
    // `float` to bind to the slider's value but always whole (Rust rounds
    // it when reading).
    in property <int> layer-total: 0;
    in-out property <float> layer-shown: 0;
    // Move the preview layer by `delta`, clamped to the sliced stack.
    function step-layer(delta: int) {
        if root.layer-total <= 0 { return; }
        root.layer-shown = Math.max(0, Math.min(root.layer-total - 1, root.layer-shown + delta));
        root.layer-picked();
    }
    // Zero-based layer of every unsupported island of the current slice
    // (one entry per island), and the request to jump the slider to the
    // next island layer above the selected one (wraps to the lowest).
    in property <[RiskRow]> print-risks;
    in property <int> risk-error-count;
    in-out property <int> selected-risk: -1;
    in-out property <string> minimum-feature-mm: "0.3";
    callback risk-jump-requested(int);
    callback risk-fix-requested(int);
    callback risk-settings-changed();
    in property <[int]> island-layers;
    callback next-island-requested();
    // The floating layer view: the shown layer's cross-section (pushed by
    // Rust as `slice-view-image`), toggled in the View menu as well as by
    // the section and slice. Placed as the object list is; it starts bottom
    // left. A height of 0px fits the content.
    in-out property <bool> layer-view-shown: true;
    in-out property <bool> layer-view-at-right: false;
    in-out property <bool> layer-view-at-bottom: true;
    in-out property <length> layer-view-x: 12px;
    in-out property <length> layer-view-y: 12px;
    in-out property <length> layer-view-w: 240px;
    in-out property <length> layer-view-h: 0px;
    in-out property <bool> layer-view-folded: false;
    in property <image> layer-image;
    // The current layer as SVG path data (mm, plate top-left origin), drawn
    // as a vector shape so its edges stay crisp at every zoom.
    in property <string> slice-view-path;
    // UV-violet depth of the shown layer: 0 at the normal exposure, 1 at the
    // longest (bottom layers); the 2D view and the 3D cut face share it.
    in property <float> layer-cure-shade: 0;
    in property <float> slice-view-plate-w: 1;
    in property <float> slice-view-plate-h: 1;

    init => {
        ShellTheme.light = root.theme == ThemePreference.Light;
        Palette.color-scheme = root.theme == ThemePreference.Light ? ColorScheme.light : ColorScheme.dark;
    }
    callback shell-theme-changed();
    changed theme => {
        root.shell-theme-changed();
        root.plate-thumbnails-refresh();
        ShellTheme.light = root.theme == ThemePreference.Light;
        Palette.color-scheme = root.theme == ThemePreference.Light ? ColorScheme.light : ColorScheme.dark;
    }

    callback open-file();
    callback close-scene();
    callback save-project();
    callback save-project-as();
    callback export-model();
    // "Export Sliced File": writes the held slice (not the raw model)
    // to disk. Two writers today, matching what `sc_sla_formats`
    // actually has: a combined SVG, or one PNG per layer in a folder.
    // Neither is a native printer file (see `slice_export.rs`'s own
    // doc comment) -- both gate on `slice-layer-count > 0`, i.e. a
    // held slice, same as the layer-preview slider does.
    callback export-sliced-job-requested();
    callback export-sliced-3mf-requested();
    callback export-sliced-svg-requested();
    callback export-sliced-png-layers-requested();
    callback scene-opened();
    callback show-about();
    // First-run setup wizard (also Help > Setup wizard...).
    callback show-setup-requested();
    // In-window confirmation (confirm.rs): a modal card, not an OS window.
    in-out property <bool> confirm-visible: false;
    in property <string> confirm-title;
    in property <string> confirm-body;
    in property <string> confirm-primary;
    in property <string> confirm-secondary;
    in property <bool> confirm-destructive;
    callback confirm-chosen(int);
    in-out property <bool> setup-visible: false;
    in-out property <int> setup-step: 0;
    in property <int> setup-theme-choice: 0;
    in property <[SetupGroup]> setup-printer-groups;
    in property <[SetupGroup]> setup-resin-groups;
    in property <image> setup-printer-picture;
    in property <image> setup-resin-picture;
    in property <string> setup-printer-name;
    in property <string> setup-resin-name;
    callback setup-theme-picked(int);
    callback setup-printer-search(string);
    callback setup-resin-search(string);
    callback setup-printer-clicked(int);
    callback setup-resin-clicked(int);
    callback setup-custom-printer();
    callback setup-skip();
    callback setup-finish(bool);
    callback show-shortcuts-requested();
    callback show-preferences();
    in-out property <bool> plate-editor-open: false;
    in-out property <bool> plate-editor-locked: false;
    in property <[string]> plate-names;
    in-out property <string> plate-display-name;
    callback plate-renamed(string);
    callback plate-settings-requested();
    callback open-new-window();
    // Asks for the other menu layout; Rust saves it through the preferences
    // bus, so every window and the settings file follow.
    callback menu-style-picked(MenuLayout);
    // A switcher click asks for a section; Rust switches this window and
    // sets `workspace-section` back.
    callback section-picked(WorkspaceSection);
    // The object list was shown or hidden: Rust saves it. The file keeps
    // the last value; other open windows keep their own.
    callback parts-panel-toggled(bool);
    // The object list was moved, resized or minimised (anchor-right,
    // anchor-bottom, offset-x, offset-y, width, height, minimised): Rust
    // saves it for this window.
    callback parts-panel-moved(bool, bool, length, length, length, length, bool);
    // A printer or resin picked in the Slice panel, by its place in the list.
    callback printer-picked(int);
    callback resin-picked(int);
    callback first-layer-edited(string);
    // A slice: the button starts one, the modal's Cancel stops it, and the
    // worker calls `slice-finished` so the result is taken on the UI thread.
    callback start-slice();
    callback cancel-slice();
    callback slice-done();
    // The Slice panel was moved or resized (anchor-right, anchor-bottom,
    // offset-x, offset-y, width, height): Rust saves it for this window.
    callback slice-box-moved(bool, bool, length, length, length, length);
    // The layer view was shown or hidden: Rust saves it, as for the list.
    callback layer-view-toggled(bool);
    // The layer view was moved, resized or minimised (anchor-right,
    // anchor-bottom, offset-x, offset-y, width, height, minimised): Rust
    // saves it.
    callback layer-view-moved(bool, bool, length, length, length, length, bool);
    // The layer slider moved: Rust redraws so the cut follows the layer.
    callback layer-picked();
    callback view-size-changed <=> mv.view-size-changed;
    // The 3D view's size as laid out this frame, read before rendering
    // (R116): its `changed width` handler runs only after the frame, so
    // that frame stretched the old picture to the new width.
    out property <length> viewer-width: mv.width;
    out property <length> viewer-height: mv.height;
    callback orbit-dragged <=> mv.orbit-dragged;
    callback pan-dragged <=> mv.pan-dragged;
    callback wheel-zoom <=> mv.wheel-zoom;
    callback fit-view-asked <=> mv.fit-view-asked;
    callback axis-view-asked <=> mv.axis-view-asked;
    callback part-row-picked(int);
    // Returns true when the press grabbed a gizmo handle (else left-drag orbits).
    callback viewport-pointer-down <=> mv.viewport-pointer-down;
    callback pointer-moved <=> mv.pointer-moved;
    callback pointer-released <=> mv.pointer-released;
    callback selection-dropped <=> mv.selection-dropped;
    callback undo();
    callback redo();
    callback repair-models();
    callback repair-done();
    in property <bool> keys-drive-gizmo: false;
    callback gizmo-toolbar(int);
    callback move-tool-key <=> mv.move-tool-key;
    callback rotate-tool-key <=> mv.rotate-tool-key;
    callback scale-tool-key <=> mv.scale-tool-key;
    callback arrow-key-down <=> mv.arrow-key-down;
    callback arrow-key-up <=> mv.arrow-key-up;
    // Tab and Shift+Tab pick through the parts while a scene with parts is
    // open; otherwise Tab moves the focus as usual.
    callback step-selection <=> mv.step-selection;
    // Ctrl+C / Ctrl+V from the 3D view. Rust uses one clipboard for the
    // whole app, so a copy here pastes in any window.
    callback copy-key <=> mv.copy-key;
    callback paste-key <=> mv.paste-key;
    // Duplicate: copies the current selection and pastes it back near
    // the cursor (or the viewport centre, with no cursor position
    // cached) in one action -- an Edit-menu/shortcut convenience over
    // doing Copy then Paste separately, not a new scene operation.
    callback duplicate-requested();
    // The pointer left the 3D view: a paste then goes to the view's middle.
    callback pointer-left-view <=> mv.pointer-left-view;
    // The right-click menu: Rust opens it through the 3D view once a right
    // click turned out not to be a drag, and its Copy and Paste come back
    // here for Rust to run against the app's clipboard.
    in-out property <bool> context-on-plate: true;
    in-out property <bool> plate-locked: false;
    callback plate-lock-changed(bool);
    changed plate-locked => { root.plate-lock-changed(root.plate-locked); }
    in-out property <[CubeFace]> cube-faces;
    in-out property <[CubeRound]> cube-round;
    in-out property <int> cube-hover-face: -1;
    // SVG path of the hovered face / edge / corner (one union fill).
    in-out property <string> cube-highlight;
    callback cube-hovered(float, float);
    in-out property <[NavAxis]> nav-axes;
    in-out property <float> nav-yaw: -999;
    in-out property <float> nav-pitch: -999;
    callback cube-clicked(float, float);
    callback navigation-view(int);
    in-out property <float> plate-toolbar-x: 600;
    in-out property <float> plate-toolbar-y: 200;
    callback open-context-menu(length, length, bool, bool, bool);
    open-context-menu(x, y, copy, paste, del) => {
        mv.pop-view-menu(x, y, copy, paste, del);
    }
    in-out property <bool> drop-project-prompt: false;
    callback drop-project-choice(bool);
    in-out property <bool> selected-is-hollow: false;
    callback input-evidence(int);
    callback export-object-requested();
    callback auto-supports-object-requested();
    callback add-model-requested();
    callback context-action(int);
    callback menu-copy-chosen <=> mv.menu-copy-chosen;
    callback menu-paste-chosen <=> mv.menu-paste-chosen;
    // Delete, from the key, the right-click menu or Edit > Delete alike.
    callback delete-key <=> mv.delete-key;
    // Where the right button went down and up, from which Rust tells a menu
    // click from a camera drag.
    callback secondary-pressed <=> mv.secondary-pressed;
    callback secondary-released <=> mv.secondary-released;

    // Bindings here are kept to state that rarely changes (scene loaded,
    // loading, recent files). On Windows Slint rebuilds the native menu
    // bar whenever a property it reads changes, and the rebuild
    // (WM_SETREDRAW off/on) blinks the whole window: Sleptic saw the screen
    // flash on every select / click-off, and his recorder saw it as a
    // window switch. Selection, undo, section and busy checks live in the
    // `activated` handlers instead, which the rebuild does not track.
    // Toggle items keep one title for both states for the same reason
    // (R118: hiding the object panel flipped "Hide / Show Object List",
    // and every hide or show blinked the window black).
    // The guarded menu commands, written once for both menus. A command
    // does nothing when its condition does not hold: the menu bar checks
    // here, when an item is picked, because its bindings may not read state
    // that changes while editing (R59: the native bar is rebuilt and the
    // window flashes); the compact menu also shows the conditions in its
    // items' `enabled`.
    property <bool> may-undo: root.undo-available && !root.repairing && root.section != WorkspaceSection.Slice;
    property <bool> may-redo: root.redo-available && !root.repairing && root.section != WorkspaceSection.Slice;
    property <bool> may-edit-selection: root.chosen-part-row != -1 && root.section == WorkspaceSection.Transform;

    // 0 exposure test, 1 overhang test, 2 LCD orientation, 3 XY scale,
    // 4 Z check, 5 time estimate from a print log. Not while slicing.
    public function open-calibration-tool(tool: int) {
        if root.slicing {
            return;
        }
        if tool == 0 {
            root.calibration-open = true;
        } else if tool == 1 {
            root.overhang-test-open = true;
        } else if tool <= 4 {
            root.machine-tool = tool - 2;
        } else {
            root.calibrate-estimate-requested();
        }
    }
    // Recipes (0) or batch prepare (1); not while slicing.
    public function open-planner(batch: bool) {
        if root.slicing {
            return;
        }
        if batch {
            root.batch-prepare-requested();
        } else {
            root.recipes-requested();
        }
    }
    // 0 Save, 1 Save As, 2 Export As; not while a save runs.
    public function run-save(kind: int) {
        if root.saving {
            return;
        }
        if kind == 0 {
            root.save-project();
        } else if kind == 1 {
            root.save-project-as();
        } else {
            root.export-model();
        }
    }
    public function run-slice() {
        if !root.slicing {
            root.start-slice();
        }
    }
    // The held slice as 0 a printer job (ZIP), 1 SVG, 2 PNG layers.
    public function export-slice(kind: int) {
        if !root.slice-export-ready {
            return;
        }
        if kind == 0 {
            root.export-sliced-job-requested();
        } else if kind == 1 {
            root.export-sliced-svg-requested();
        } else {
            root.export-sliced-png-layers-requested();
        }
    }
    public function run-history(redo: bool) {
        if redo && root.may-redo {
            root.redo();
        } else if !redo && root.may-undo {
            root.undo();
        }
    }
    public function run-on-selection(delete: bool) {
        if !root.may-edit-selection {
            return;
        }
        if delete {
            root.delete-key();
        } else {
            root.duplicate-requested();
        }
    }
    public function toggle-projection() {
        root.perspective-view = !root.perspective-view;
        root.projection-toggled(root.perspective-view);
    }
    public function toggle-object-list() {
        root.parts-panel-shown = !root.parts-panel-shown;
        root.parts-panel-toggled(root.parts-panel-shown);
    }
    public function toggle-slice-view() {
        root.layer-view-shown = !root.layer-view-shown;
        root.layer-view-toggled(root.layer-view-shown);
    }
    public function switch-menu-layout() {
        root.menu-style-picked(root.menu-style == MenuLayout.Compact ? MenuLayout.Bar : MenuLayout.Compact);
    }

    MenuBar {
        // Hidden in the compact layout but still there, so its shortcuts keep
        // working (a hidden bar gives up its room and keeps its accelerators).
        // Never hidden on macOS.
        visible: root.menu-style == MenuLayout.Bar;

        Menu {
            title: @tr("MenuBar" => "File");
            MenuItem { title: @tr("MenuBar" => "Open…"); shortcut: @keys(Control + O); enabled: !root.busy-opening; activated => { root.open-file(); } }
            Menu {
                title: @tr("MenuBar" => "Open Recent");
                enabled: root.recent-files.length > 0 && !root.busy-opening;
                for path[idx] in root.recent-files: MenuItem { title: path; activated => { root.open-recent-requested(idx); } }
            }
            MenuItem { title: @tr("MenuBar" => "New Window"); shortcut: @keys(Control + Shift + N); activated => { root.open-new-window(); } }
            MenuSeparator {}
            MenuItem { title: @tr("MenuBar" => "Save"); shortcut: @keys(Control + S); enabled: root.scene-present && !root.busy-opening; activated => { root.run-save(0); } }
            MenuItem { title: @tr("MenuBar" => "Save As…"); shortcut: @keys(Control + Shift + S); enabled: root.scene-present && !root.busy-opening; activated => { root.run-save(1); } }
            MenuItem { title: @tr("MenuBar" => "Export As…"); shortcut: @keys(Control + Shift + E); enabled: root.scene-present && !root.busy-opening; activated => { root.run-save(2); } }
            MenuItem { title: @tr("MenuBar" => "Close"); shortcut: @keys(Control + W); enabled: root.busy-opening || root.scene-present; activated => { root.close-scene(); } }
            MenuSeparator {}
            MenuItem { title: @tr("MenuBar" => "Slice Plate"); shortcut: @keys(Control + R); enabled: root.scene-present && !root.busy-opening; activated => { root.run-slice(); } }
            MenuItem { title: @tr("MenuBar" => "Export Printer Job (ZIP)…"); shortcut: @keys(Control + G); activated => { root.export-slice(0); } }
            MenuItem { title: @tr("MenuBar" => "Export Sliced File (SVG)…"); activated => { root.export-slice(1); } }
            MenuItem { title: @tr("MenuBar" => "Export Sliced Layers (PNG)…"); activated => { root.export-slice(2); } }
            MenuSeparator {}
            MenuItem { title: @tr("Recipes..."); enabled: !root.busy-opening; activated => { root.open-planner(false); } }
            MenuItem { title: @tr("Batch prepare..."); enabled: !root.busy-opening; activated => { root.open-planner(true); } }
            MenuItem { title: @tr("Print history..."); activated => { root.hub-page = 2; root.hub-page-opened(2); } }
        }
        Menu {
            title: @tr("MenuBar" => "Edit");
            MenuItem { title: @tr("MenuBar" => "Undo"); shortcut: @keys(Control + Z); enabled: root.scene-present && !root.busy-opening; activated => { root.run-history(false); } }
            MenuItem { title: @tr("MenuBar" => "Redo"); shortcut: @keys(Control + Shift + Z); enabled: root.scene-present && !root.busy-opening; activated => { root.run-history(true); } }
            MenuSeparator {}
            MenuItem { title: @tr("MenuBar" => "Duplicate"); shortcut: @keys(Control + D); enabled: root.scene-present && !root.busy-opening; activated => { root.run-on-selection(false); } }
            MenuItem { title: @tr("MenuBar" => "Delete"); enabled: root.scene-present && !root.busy-opening; activated => { root.run-on-selection(true); } }
            MenuSeparator {}
            MenuItem { title: @tr("MenuBar" => "Preferences"); shortcut: @keys(Control + Comma); activated => { root.show-preferences(); } }
        }
        Menu {
            title: @tr("MenuBar" => "View");
            MenuItem { title: @tr("MenuBar" => "Perspective / Orthographic View (5)"); activated => { root.toggle-projection(); } }
            MenuItem { title: @tr("MenuBar" => "Show / Hide Object List"); shortcut: @keys(Control + L); activated => { root.toggle-object-list(); } }
            MenuItem { title: @tr("MenuBar" => "Show / Hide Slice View"); enabled: root.scene-present; activated => { root.toggle-slice-view(); } }
            MenuSeparator {}
            MenuItem { title: root.menu-style == MenuLayout.Compact ? @tr("MenuBar" => "Show Menu Bar") : @tr("MenuBar" => "Hide Menu Bar"); enabled: !root.on-macos; activated => { root.switch-menu-layout(); } }
            MenuItem { title: @tr("MenuBar" => "Fullscreen"); checkable: true; checked <=> root.full-screen; shortcut: root.on-macos ? @keys(Control + Meta + F) : @keys(F11); }
        }
        Menu {
            title: @tr("Calibration");
            MenuItem { title: @tr("All calibration tools..."); activated => { root.calibration-menu-open = true; } }
            MenuItem { title: @tr("Exposure test..."); activated => { root.open-calibration-tool(0); } }
            MenuItem { title: @tr("Overhang test..."); activated => { root.open-calibration-tool(1); } }
            MenuItem { title: @tr("LCD orientation..."); activated => { root.open-calibration-tool(2); } }
            MenuItem { title: @tr("XY scale..."); activated => { root.open-calibration-tool(3); } }
            MenuItem { title: @tr("Z check..."); activated => { root.open-calibration-tool(4); } }
            MenuItem { title: @tr("Time estimate from a print log..."); activated => { root.open-calibration-tool(5); } }
        }
        Menu {
            title: @tr("MenuBar" => "Help");
            MenuItem { title: @tr("MenuBar" => "Keyboard Shortcuts"); shortcut: @keys(Control + Slash); activated => { root.show-shortcuts-requested(); } }
            MenuItem { title: @tr("MenuBar" => "Setup Wizard..."); activated => { root.show-setup-requested(); } }
            MenuSeparator {}
            MenuItem { title: @tr("MenuBar" => "About"); activated => { root.show-about(); } }
        }
    }

    // The 3D view, between the settings sidebar and the right panel.
    mv := MeshViewer {
        x: root.settings-width;
        y: 68px;
        width: root.width - root.settings-width - root.right-panel-space;
        height: root.height - 108px;
        over-control: root.hovered-plate-tile >= 0 && root.section != WorkspaceSection.Slice;
        frame-image: root.view-ready;
        empty-hint: @tr("Open a 3D model to visualize it here");
        has-scene: root.scene-present;
        open-file-requested => {
            root.open-file();
        }
        gizmo-keys-on: root.keys-drive-gizmo;
        // Tab picks parts while a scene is open; without one it moves the focus
        // through the window's controls instead.
        cycle-allowed: root.scene-present;
        projection-toggle-requested() => {
            root.perspective-view = !root.perspective-view;
            root.projection-toggled(root.perspective-view);
        }
        shortcuts-help-requested() => {
            root.show-shortcuts-requested();
        }
        plate-ids: root.plate-ids;
        context-on-plate: root.context-on-plate;
        context-plate-locked: root.plate-locked;
        context-has-selection: root.chosen-part-row >= 0;
        context-is-hollow: root.selected-is-hollow;
        context-editable: root.section == WorkspaceSection.Transform && !root.busy-opening && !root.slicing && !root.making-supports;
        context-action(action) => {
            if (action == 25) { root.add-plate-requested(); }
            if (action >= 1000) { root.move-to-plate-requested(action - 1000); }
            if (action == 0) { root.add-model-requested(); }
            if (action == 2) { root.arrange-requested(); }
            if (action == 4) { root.fill-plate-requested(); }
            if (action == 5) { root.paste-key(); }
            if (action == 7) { root.fit-view-asked(); }
            if (action == 8) { root.delete-key(); }
            if (action == 9) { root.duplicate-requested(); }
            if (action == 10) { root.copy-key(); }
            if (action == 11) { root.center-on-plate-requested(); }
            if (action == 12) { root.drop-to-plate-requested(); }
            if (action >= 13 && action <= 15) { root.mirror-requested(action - 13); }
            if (action == 16) { root.auto-orient-requested(); }
            if (action == 17) { root.hollow-requested(false); }
            if (action == 26) { root.model-tool-mode = 3; root.model-tools-active = true; root.supports-tool-active = false; root.hollow-tool-active = false; root.drain-tool-active = false; root.measure-tool-active = false; root.place-face-tool-active = false; }
            if (action == 19) { root.auto-supports-object-requested(); }
            if (action == 22) { root.plate-settings-requested(); }
            if (action == 24) { root.show-preferences(); }
            if (action == 23) { root.navigation-view(0); }
            if (action == 21) { root.export-object-requested(); }
            root.context-action(action);
        }
        if root.place-face-tool-active && root.place-face-path != "": Path {
            width: parent.width; height: parent.height;
            viewbox-x: 0; viewbox-y: 0;
            viewbox-width: self.width / 1px; viewbox-height: self.height / 1px;
            commands: root.place-face-path;
            fill: ShellTheme.accent.with-alpha(0.16);
            stroke: ShellTheme.accent.with-alpha(0.55); stroke-width: 1px;
        }
        if root.place-face-tool-active && root.place-face-hover-path != "": Path {
            width: parent.width; height: parent.height;
            viewbox-x: 0; viewbox-y: 0;
            viewbox-width: self.width / 1px; viewbox-height: self.height / 1px;
            commands: root.place-face-hover-path;
            fill: ShellTheme.accent.with-alpha(0.5);
            stroke: ShellTheme.accent; stroke-width: 2px;
        }
        if root.rotate-ticks-path != "": Path {
            width: parent.width; height: parent.height;
            viewbox-x: 0; viewbox-y: 0;
            viewbox-width: self.width / 1px; viewbox-height: self.height / 1px;
            commands: root.rotate-ticks-path;
            stroke: ShellTheme.text.with-alpha(0.7); stroke-width: 1.5px;
        }
        if root.rotate-tick-hot-path != "": Path {
            width: parent.width; height: parent.height;
            viewbox-x: 0; viewbox-y: 0;
            viewbox-width: self.width / 1px; viewbox-height: self.height / 1px;
            commands: root.rotate-tick-hot-path;
            stroke: ShellTheme.accent; stroke-width: 3px;
        }
        if root.rotate-readout != "": Rectangle {
            x: root.rotate-readout-x - self.width / 2; y: root.rotate-readout-y - self.height / 2;
            width: rotate-label.preferred-width + 14px; height: 22px;
            background: ShellTheme.panel; border-radius: 11px;
            border-width: 1px; border-color: ShellTheme.accent;
            rotate-label := Text { text: root.rotate-readout; color: ShellTheme.text; font-weight: 600;
                horizontal-alignment: center; vertical-alignment: center; }
        }
        if root.measure-tool-active && root.measure-markers.length == 2: Path {
            width: parent.width; height: parent.height;
            viewbox-x: 0; viewbox-y: 0;
            viewbox-width: self.width / 1px; viewbox-height: self.height / 1px;
            stroke: ShellTheme.accent; stroke-width: 2px;
            MoveTo { x: root.measure-markers[0].x; y: root.measure-markers[0].y; }
            LineTo { x: root.measure-markers[1].x; y: root.measure-markers[1].y; }
        }
        for marker in root.measure-markers: Rectangle {
            visible: root.measure-tool-active;
            x: marker.x * 1px - 5px; y: marker.y * 1px - 5px;
            width: 10px; height: 10px; border-radius: 5px;
            background: ShellTheme.accent; border-width: 1px; border-color: ShellTheme.accent-text;
        }
        if root.model-tools-active && root.section != WorkspaceSection.Slice && root.model-tool-mode == 0 && root.cut-plane-markers.length == 4: Rectangle {
            width: parent.width; height: parent.height;
            Path {
                width: parent.width; height: parent.height;
                viewbox-width: self.width / 1px; viewbox-height: self.height / 1px;
                stroke: ShellTheme.cut-plane; stroke-width: 2px; fill: ShellTheme.cut-plane.with-alpha(0.12);
                MoveTo { x: root.cut-plane-markers[0].x; y: root.cut-plane-markers[0].y; }
                LineTo { x: root.cut-plane-markers[1].x; y: root.cut-plane-markers[1].y; }
                LineTo { x: root.cut-plane-markers[2].x; y: root.cut-plane-markers[2].y; }
                LineTo { x: root.cut-plane-markers[3].x; y: root.cut-plane-markers[3].y; } Close {}
            }
            Rectangle {
                x: (root.cut-plane-markers[0].x + root.cut-plane-markers[1].x + root.cut-plane-markers[2].x + root.cut-plane-markers[3].x) / 4 * 1px - 16px; y: (root.cut-plane-markers[0].y + root.cut-plane-markers[1].y + root.cut-plane-markers[2].y + root.cut-plane-markers[3].y) / 4 * 1px - 14px;
                width: 32px; height: 28px; border-radius: 6px; background: ShellTheme.cut-plane;
                Text { text: "Z"; horizontal-alignment: center; vertical-alignment: center; color: ShellTheme.accent-text; }
                TouchArea {
                    property <float> last-y;
                    pointer-event(e) => { if e.kind == PointerEventKind.down { self.last-y = (self.mouse-y + parent.y) / 1px; } }
                    moved => { if self.pressed { root.cut-plane-dragged((self.mouse-y + parent.y) / 1px - self.last-y); self.last-y = (self.mouse-y + parent.y) / 1px; } }
                }
            }
        }
    }

    // 2D layer mode: an opaque backdrop over the whole canvas, under the 2D
    // panel and the layer slider. The 3D viewport keeps rendering beneath;
    // without this its picture showed through the slider column and the
    // panel's edge gaps.
    if root.section == WorkspaceSection.Slice && !root.preview-3d: Rectangle {
        x: root.settings-width; y: 68px;
        width: root.width - root.settings-width - root.right-panel-space;
        height: root.height - 108px;
        background: ShellTheme.preview;
        TouchArea { scroll-event(e) => { return accept; } }
    }
    if root.section == WorkspaceSection.Slice && !root.preview-3d: Rectangle {
        x: root.settings-width + 4px; y: 72px;
        width: root.width - root.settings-width - root.right-panel-space - 96px;
        height: root.height - 116px;
        background: ShellTheme.preview; clip: true;
        Rectangle {
            width: Math.min(parent.width - 32px, (parent.height - 96px) * root.preview-plate-aspect) * root.preview-zoom;
            height: self.width / root.preview-plate-aspect;
            x: (parent.width - self.width) / 2 + root.preview-pan-x;
            y: (parent.height - self.height) / 2 + root.preview-pan-y;
            border-width: 1px; border-color: ShellTheme.muted;
            // The layer as the printer's LCD shows it: black mask, the
            // cured shape glowing UV violet with light bleeding past it.
            background: #07060c;
            property <color> cure: #4b0082.mix(#a259ff, root.layer-cure-shade);
            for halo in [{ w: 14px, a: 0.10 }, { w: 8px, a: 0.16 }, { w: 4px, a: 0.28 }]: Path {
                width: parent.width; height: parent.height;
                commands: root.slice-view-path;
                viewbox-x: 0; viewbox-y: 0;
                viewbox-width: root.slice-view-plate-w; viewbox-height: root.slice-view-plate-h;
                fill: transparent;
                stroke: #b07bff.with-alpha(halo.a);
                stroke-width: halo.w;
            }
            Path {
                width: parent.width; height: parent.height;
                commands: root.slice-view-path;
                viewbox-x: 0; viewbox-y: 0;
                viewbox-width: root.slice-view-plate-w; viewbox-height: root.slice-view-plate-h;
                fill: parent.cure;
                fill-rule: nonzero;
                stroke-width: 0px;
            }
            // Red island overlay (transparent elsewhere).
            Image { source: root.layer-image; width: parent.width; height: parent.height; image-fit: fill; }
        }
        // Pans with the right (or middle) button, as the 3D view does (R110:
        // it panned on the left, the opposite of Prepare).
        preview-touch := TouchArea {
            property <length> base-x; property <length> base-y;
            property <length> start-x; property <length> start-y;
            property <bool> panning;
            pointer-event(e) => {
                if e.kind == PointerEventKind.down {
                    preview-focus.focus();
                    if e.button == PointerEventButton.right || e.button == PointerEventButton.middle {
                        self.panning = true;
                        self.base-x = root.preview-pan-x; self.base-y = root.preview-pan-y;
                        self.start-x = self.mouse-x; self.start-y = self.mouse-y;
                    }
                }
                if e.kind == PointerEventKind.up && (e.button == PointerEventButton.right || e.button == PointerEventButton.middle) { self.panning = false; }
                if e.kind == PointerEventKind.move && self.panning {
                    root.preview-pan-x = self.base-x + self.mouse-x - self.start-x;
                    root.preview-pan-y = self.base-y + self.mouse-y - self.start-y;
                }
            }
            scroll-event(e) => { root.preview-zoom = Math.max(0.25, Math.min(12, root.preview-zoom * (e.delta-y > 0px ? 1.15 : 0.87))); return accept; }
        }
        preview-focus := FocusScope {
            init => { self.focus(); }
            key-pressed(e) => {
                if e.text == Key.UpArrow || e.text == Key.PageUp { root.layer-shown = Math.min(root.layer-total - 1, root.layer-shown + (e.text == Key.PageUp ? 10 : 1)); root.layer-picked(); return accept; }
                if e.text == Key.DownArrow || e.text == Key.PageDown { root.layer-shown = Math.max(0, root.layer-shown - (e.text == Key.PageDown ? 10 : 1)); root.layer-picked(); return accept; }
                return reject;
            }
        }
        HorizontalLayout {
            x: 16px; y: 12px; width: 300px; height: 32px;
            Button { text: @tr("Preview" => "Fit"); clicked => { root.preview-zoom = 1; root.preview-pan-x = 0px; root.preview-pan-y = 0px; } }
            // The active view is the accent button, not a disabled-looking one.
            PrimaryButton { icon: @image-url("icons/2d.svg"); text: @tr("Preview" => "2D layer"); clicked => { root.preview-3d = false; root.layer-picked(); } }
            Button { colorize-icon: true; icon: @image-url("icons/3d.svg"); text: @tr("Preview" => "3D view"); clicked => { root.preview-3d = true; root.layer-picked(); } }
        }
    }

    if root.section == WorkspaceSection.Slice && root.preview-3d: HorizontalLayout {
        x: root.settings-width + 16px; y: 80px; width: 264px; height: 32px;
        Button { colorize-icon: true; icon: @image-url("icons/2d.svg"); text: @tr("2D layer"); clicked => { root.preview-3d = false; root.layer-picked(); } }
        PrimaryButton { icon: @image-url("icons/3d.svg"); text: @tr("3D view"); clicked => { root.preview-3d = true; } }
    }
    Rectangle {
        x: 0px; y: 0px; width: parent.width; height: 64px;
        background: ShellTheme.panel;
        HorizontalLayout {
            padding: 12px; spacing: root.width < 1400px ? 6px : 12px;
            Image { source: @image-url("../assets/images/sleptic.svg"); width: 30px; height: 30px; }
            IconTool { tint: 0; icon: @image-url("icons/gear.svg"); label: @tr("Preferences"); clicked => { root.show-preferences(); } }
            // Wordmark: the brand name bold, the product name in muted grey.
            // Packed left: a fixed-width box let both words stretch apart
            // ("Sleptic      Slicer").
            HorizontalLayout {
                horizontal-stretch: 0; spacing: 5px; alignment: start;
                Text { text: "Sleptic"; horizontal-stretch: 0; color: ShellTheme.text; font-weight: 800; font-size: 16px; vertical-alignment: center; }
                Text { text: @tr("Slicer"); horizontal-stretch: 0; color: ShellTheme.muted; font-weight: 500; font-size: 16px; vertical-alignment: center; }
            }
            // Below 1400 px the free space goes to the profile pickers
            // (they truncated to "ELEGO..."), not to centring the tabs.
            Rectangle { min-width: 8px; horizontal-stretch: root.width < 1400px ? 0 : 1; }
            HorizontalLayout {
                horizontal-stretch: 0; spacing: 4px;
                WorkTab { icon: @image-url("icons/home.svg"); name: @tr("Home"); current: root.hub-page == 1; chosen => { root.hub-page = 1; root.hub-page-opened(1); } }
                WorkTab { icon: @image-url("icons/prepare.svg"); caption: @tr("Prepare"); current: root.hub-page == 0 && root.section != WorkspaceSection.Slice; chosen => { root.hub-page = 0; root.section-picked(WorkspaceSection.Transform); } }
                // Preview without a current slice (never sliced, failed, or stale
                // after an edit) starts slicing; a finished slice opens Preview.
                WorkTab {
                    icon: @image-url("icons/layers.svg");
                    caption: @tr("Preview");
                    current: root.hub-page == 0 && root.section == WorkspaceSection.Slice;
                    chosen => {
                        root.hub-page = 0;
                        if (!root.slice-export-ready && root.scene-present && !root.busy-opening && !root.slicing) {
                            root.start-slice();
                        } else {
                            root.section-picked(WorkspaceSection.Slice);
                        }
                    }
                }
                WorkTab { icon: @image-url("icons/device.svg"); caption: @tr("Device"); current: root.hub-page == 2; chosen => { root.hub-page = 2; root.hub-page-opened(2); } }
                WorkTab { icon: @image-url("icons/project.svg"); caption: @tr("Project"); current: root.hub-page == 3; chosen => { root.hub-page = 3; root.hub-page-opened(3); } }
            }
            // Below 1400 px the free space goes to the profile pickers
            // (they truncated to "ELEGO..."), not to centring the tabs.
            Rectangle { min-width: 8px; horizontal-stretch: root.width < 1400px ? 0 : 1; }
            property <int> verification-popup: root.verification-popup;
            changed verification-popup => {if self.verification-popup == 3 {slice-all-menu.show();} if self.verification-popup == 4 {export-all-menu.show();}}
            slice-split := HorizontalLayout { spacing: 1px; width: 160px; horizontal-stretch: 0;
            slice-all-menu := PopupWindow { x: slice-split.width - self.width; y: slice-split.height + 4px; width: 200px; height: slice-menu-layout.preferred-height;
                MenuSurface {}
                slice-menu-layout := VerticalLayout { padding: 4px;
                    MenuRow { icon: @image-url("icons/slice.svg"); label: @tr("Slice all plates"); enabled: root.scene-present && !root.slicing; clicked => { root.slice-all-requested(); slice-all-menu.close(); } }
                }
            }
            PrimaryButton { width: 131px; icon: @image-url("icons/slice.svg"); text: root.slicing ? @tr("SlicePanel" => "Slicing... {}%", round(root.slice-fraction * 100)) : root.slice-estimates-stale ? @tr("SlicePanel" => "Re-slice") : @tr("SlicePanel" => "Slice"); enabled: root.scene-present && !root.busy-opening && !root.slicing; clicked => { root.start-slice(); } }
            DropArrow { accent: true; label: @tr("Slice options"); enabled: root.scene-present && !root.slicing; clicked => { slice-all-menu.show(); } }
            }
            export-split := HorizontalLayout { spacing: 1px; width: 160px; horizontal-stretch: 0;
            Button {
                width: 131px; height: 36px;
                text: @tr("Export"); icon: @image-url("icons/export.svg"); enabled: root.slice-export-ready;
                clicked => {
                    if root.export-format == 0 { root.export-sliced-job-requested(); }
                    else if root.export-format == 1 { root.export-sliced-png-layers-requested(); }
                    else if root.export-format == 2 { root.export-sliced-3mf-requested(); }
                    else { root.export-sliced-svg-requested(); }
                }
            }
            export-all-menu := PopupWindow { x: export-split.width - self.width; y: export-split.height + 4px; width: 240px; height: export-menu-layout.preferred-height;
                MenuSurface {}
                export-menu-layout := VerticalLayout { padding: 12px; spacing: 8px;
                Text { text: @tr("Export format"); color: ShellTheme.text; font-weight: 600; }
                ComboBox { accessible-label: @tr("Export format"); model: ["G-code ZIP", "PNG layers", "3MF", "SVG"]; current-index <=> root.export-format; }
                Button { text: @tr("Export all"); enabled: !root.slicing; clicked => { root.export-all-requested(); export-all-menu.close(); } }
                MenuRow { icon: @image-url("icons/device.svg"); label: @tr("Send to printer..."); clicked => { root.hub-page = 2; root.hub-page-opened(2); export-all-menu.close(); } }
                }
            }
            DropArrow { label: @tr("Export options"); enabled: !root.slicing; clicked => { export-all-menu.show(); } }
            }


        }
    }
    // Settings sidebar, laid out like Orca's (R98): the printer and the material
    // as pickers at the top, then Process with the Simple / Advanced / Expert
    // switch, search and one tab per kind of setting, tuned for resin.
    Rectangle {
        x: 0px; y: 68px; width: root.settings-width; height: root.height - 108px;
        background: ShellTheme.panel;
        VerticalLayout {
            padding: 12px; padding-top: 10px; spacing: 6px;
            SidebarBar { icon: @image-url("icons/layers.svg"); title: @tr("Printer");
                IconTool { width: 30px; height: 30px; tint: -1; icon: @image-url("icons/gear.svg"); label: @tr("Edit printer profile"); clicked => { root.profile-edit-requested(true); } }
            }
            HorizontalLayout { spacing: 8px;
                PictureTile {
                    if root.printer-picture.width > 0: Image { x: 2px; y: 2px; width: 52px; height: 52px; source: root.printer-picture; image-fit: contain; }
                    if root.printer-picture.width == 0: Image { x: 6px; y: 6px; width: 44px; height: 44px; source: @image-url("icons/printer-body.svg"); colorize: ShellTheme.muted; }
                    if root.printer-picture.width == 0: Image { x: 6px; y: 6px; width: 44px; height: 44px; source: @image-url("icons/printer-lid.svg"); colorize: ShellTheme.icon-yellow.transparentize(0.45); }
                    if root.printer-picture.width == 0: Image { x: 6px; y: 6px; width: 44px; height: 44px; source: @image-url("icons/printer-screen.svg"); colorize: ShellTheme.accent; }
                }
                VerticalLayout { alignment: center;
                    ComboBox { min-width: 0px; accessible-label: @tr("Printer"); model: root.printer-choices; current-index <=> root.printer-choice; selected(i) => { root.printer-picked(self.current-index); } }
                }
            }
            Text { text: root.printer-summary; color: ShellTheme.muted; wrap: word-wrap; font-size: 11px; }
            SidebarBar { icon: @image-url("icons/droplet.svg"); title: @tr("Resin");
                IconTool { width: 30px; height: 30px; tint: -1; icon: @image-url("icons/gear.svg"); label: @tr("Edit resin profile"); clicked => { root.profile-edit-requested(false); } }
            }
            HorizontalLayout { spacing: 8px;
                PictureTile {
                    if root.resin-picture.width > 0: Image { x: 2px; y: 2px; width: 52px; height: 52px; source: root.resin-picture; image-fit: contain; }
                    if root.resin-picture.width == 0: Image { x: 6px; y: 6px; width: 44px; height: 44px; source: @image-url("icons/bottle-resin.svg"); colorize: root.resin-color; }
                    if root.resin-picture.width == 0: Image { x: 6px; y: 6px; width: 44px; height: 44px; source: @image-url("icons/bottle-body.svg"); colorize: ShellTheme.text; }
                    if root.resin-picture.width == 0: Image { x: 6px; y: 6px; width: 44px; height: 44px; source: @image-url("icons/bottle-cap.svg"); colorize: ShellTheme.muted; }
                }
                VerticalLayout { alignment: center; horizontal-stretch: 1;
                    ComboBox { min-width: 0px; accessible-label: @tr("Resin"); model: root.resin-choices; current-index <=> root.resin-choice; selected(i) => { root.resin-picked(self.current-index); } }
                }
                // The resin's colour, which the models are drawn in (R121).
                VerticalLayout { alignment: center;
                    resin-swatch := Rectangle { width: 26px; height: 26px; border-radius: 13px;
                        background: root.resin-color; border-width: 2px; border-color: swatch-touch.has-hover ? ShellTheme.accent : ShellTheme.border;
                        accessible-role: button; accessible-label: @tr("Resin colour");
                        accessible-action-default => { resin-colors.show(); }
                        swatch-touch := TouchArea { mouse-cursor: pointer; clicked => { resin-colors.show(); } }
                        resin-colors := PopupWindow { x: -196px; y: 32px; width: 222px; height: colors-layout.preferred-height;
                            MenuSurface { }
                            colors-layout := VerticalLayout { padding: 10px; spacing: 8px;
                                Text { text: @tr("Colour of your resin"); color: ShellTheme.text; font-size: 12px; font-weight: 600; }
                                for row in [0, 1]: HorizontalLayout { spacing: 6px;
                                    for col in [0, 1, 2, 3, 4, 5, 6]: Rectangle { width: 24px; height: 24px; border-radius: 12px;
                                        background: root.resin-swatches[row * 7 + col];
                                        border-width: cell.has-hover ? 2px : 1px; border-color: cell.has-hover ? ShellTheme.accent : ShellTheme.border;
                                        accessible-role: button; accessible-label: root.resin-swatch-names[row * 7 + col];
                                        accessible-action-default => { root.resin-color-picked(row * 7 + col); }
                                        cell := TouchArea { mouse-cursor: pointer; clicked => { root.resin-color-picked(row * 7 + col); resin-colors.close(); } }
                                    }
                                }
                                MenuRow { label: @tr("Use the colour in the resin's name"); clicked => { root.resin-color-picked(-1); resin-colors.close(); } }
                            }
                        }
                    }
                }
            }
            SidebarBar { icon: @image-url("icons/gear.svg"); title: @tr("Process");
                // Segmented control (one track, the active level filled).
                VerticalLayout { alignment: center;
                    Rectangle {
                        width: 204px; height: 26px; border-radius: 13px; background: ShellTheme.panel;
                        HorizontalLayout {
                            padding: 2px; spacing: 0px;
                            for label[i] in [@tr("Simple"), @tr("Advanced"), @tr("Expert")]: LevelTab {
                                horizontal-stretch: 1;
                                label: label; active: root.settings-level == i;
                                clicked => { root.settings-level = i; }
                            }
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Image { source: @image-url("icons/search.svg"); width: 18px; colorize: ShellTheme.muted; }
                LineEdit { placeholder-text: @tr("Search settings"); text <=> root.settings-search; }
                if root.settings-search != "": Button { colorize-icon: true; icon: @image-url("icons/reset.svg"); width: 28px; clicked => { root.settings-search = ""; } }
            }
            // Category tabs (Orca's Quality / Strength / Speed / Support ...),
            // resin's own: a search shows matches from every tab.
            if root.settings-search == "": HorizontalLayout {
                spacing: 0px; height: 30px;
                for label[i] in [@tr("Quality"), @tr("Exposure"), @tr("Lift"), @tr("Supports"), @tr("Others")]: SettingsTab {
                    label: label; active: root.settings-tab == i;
                    clicked => { root.settings-tab = i; }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            Rectangle { height: 1px; background: ShellTheme.border; }
            ScrollView {
                vertical-stretch: 1;
                viewport-width: self.width;
                VerticalLayout {
                    // Right padding keeps rows clear of the overlaid scrollbar.
                    padding: 0px; padding-right: 12px; spacing: 8px; alignment: start;
                    if root.settings-search != "" ? root.quality-matches : root.settings-tab == 0: VerticalLayout {
                        spacing: 0px;
                        if root.settings-search == "": SettingsSection { icon: @image-url("icons/layers.svg"); title: @tr("Layers"); }
                        for row in root.process-settings: VerticalLayout {
                            if (row.id == 0) && (row.level <= root.settings-level || root.settings-search != "") && (root.settings-search == "" || root.settings-match(row.label, root.settings-search)): SettingField {
                                setting: row;
                                edited(id,t) => { root.process-setting-edited(id,t); }
                            }
                        }
                        if (root.settings-level > 0 || root.settings-search != "") && (root.settings-search == "" || root.settings-match(@tr("First layer height"), root.settings-search)): HorizontalLayout {
                            height: 32px;
                            spacing: 6px;
                            Text { text: @tr("First layer height"); overflow: elide; color: root.first-layer-text != "" ? ShellTheme.accent : ShellTheme.text; min-width: 0px; horizontal-stretch: 1; vertical-alignment: center; font-size: 13px; }
                            VerticalLayout { alignment: center;
                                ValueBox { text <=> root.first-layer-text; unit: "mm"; placeholder: @tr("Auto"); name: @tr("First layer height");
                                    accepted(t) => { root.first-layer-edited(t); } }
                            }
                            VerticalLayout { alignment: center; width: 22px;
                                if root.first-layer-text != "": Rectangle { width: 22px; height: 22px; border-radius: 4px;
                                    accessible-role: button; accessible-label: @tr("Reset {}", @tr("First layer height"));
                                    accessible-action-default => { root.first-layer-text = ""; root.first-layer-edited(""); }
                                    background: flh-reset.has-hover ? ShellTheme.field : transparent;
                                    Image { source: @image-url("icons/reset.svg"); width: 14px; height: 14px; x: 4px; y: 4px; colorize: ShellTheme.muted; }
                                    flh-reset := TouchArea { mouse-cursor: pointer; clicked => { root.first-layer-text = ""; root.first-layer-edited(""); } }
                                }
                            }
                        }
                        if root.settings-search == "" && root.settings-level > 0: SettingsSection { icon: @image-url("icons/gear.svg"); title: @tr("Accuracy"); }
                        for row in root.process-settings: VerticalLayout {
                            if (row.id >= 9) && (row.level <= root.settings-level || root.settings-search != "") && (root.settings-search == "" || root.settings-match(row.label, root.settings-search)): SettingField {
                                setting: row;
                                edited(id,t) => { root.process-setting-edited(id,t); }
                            }
                        }
                        if (root.settings-level > 0 || root.settings-search != "") && (root.settings-search == "" || root.settings-match(@tr("Anti-aliasing"), root.settings-search)): HorizontalLayout {
                            height: 32px;
                            spacing: 6px;
                            Text { text: @tr("Anti-aliasing"); overflow: elide; color: root.process-aa-modified ? ShellTheme.accent : ShellTheme.text; min-width: 0px; horizontal-stretch: 1; vertical-alignment: center; font-size: 13px; }
                            VerticalLayout { alignment: center;
                                ComboBox { width: 104px; height: 28px; model: [@tr("Off"), "x2", "x4", "x8"]; current-index <=> root.process-aa-index; selected(t) => { root.process-aa-picked(self.current-index); } }
                            }
                            VerticalLayout { alignment: center; width: 22px;
                                if root.process-aa-modified: Rectangle { width: 22px; height: 22px; border-radius: 4px;
                                    accessible-role: button; accessible-label: @tr("Reset {}", @tr("Anti-aliasing"));
                                    accessible-action-default => { root.process-aa-picked(-1); }
                                    background: aa-reset.has-hover ? ShellTheme.field : transparent;
                                    Image { source: @image-url("icons/reset.svg"); width: 14px; height: 14px; x: 4px; y: 4px; colorize: ShellTheme.muted; }
                                    aa-reset := TouchArea { mouse-cursor: pointer; clicked => { root.process-aa-picked(-1); } }
                                }
                            }
                        }
                    }
                    if root.settings-search != "" ? root.material-matches : root.settings-tab == 1: VerticalLayout {
                        spacing: 0px;
                        if root.settings-search == "": SettingsSection { icon: @image-url("icons/droplet.svg"); title: @tr("Exposure"); }
                        for row in root.process-settings: VerticalLayout {
                            if ((row.id >= 1 && row.id <= 3) || row.id == 7 || row.id == 8) && (row.level <= root.settings-level || root.settings-search != "") && (root.settings-search == "" || root.settings-match(row.label, root.settings-search)): SettingField {
                                setting: row;
                                edited(id,t) => { root.process-setting-edited(id,t); }
                            }
                        }
                        if root.settings-search == "" && root.resin-support-summary != "": Text { text: root.resin-support-summary; color: ShellTheme.muted; wrap: word-wrap; font-size: 12px; }
                    }
                    if root.settings-search != "" ? root.motion-matches : root.settings-tab == 2: VerticalLayout {
                        spacing: 0px;
                        if root.settings-search == "": SettingsSection { icon: @image-url("icons/move.svg"); title: @tr("Lift and retract"); }
                        for row in root.process-settings: VerticalLayout {
                            if (row.id >= 4 && row.id <= 6) && (row.level <= root.settings-level || root.settings-search != "") && (root.settings-search == "" || root.settings-match(row.label, root.settings-search)): SettingField {
                                setting: row;
                                edited(id,t) => { root.process-setting-edited(id,t); }
                            }
                        }
                        if root.settings-search == "" && root.settings-level == 0: Text { text: @tr("Lift speeds come from the printer and resin profiles. Switch to Advanced to change them."); color: ShellTheme.muted; wrap: word-wrap; font-size: 12px; }
                        if root.settings-search == "": Button { text: @tr("Motion profile..."); clicked => { root.profile-edit-requested(true); } }
                    }
                    if root.settings-search != "" ? root.supports-matches : root.settings-tab == 3: VerticalLayout {
                        spacing: 0px;
                        if root.settings-search == "": SettingsSection { icon: @image-url("icons/supports.svg"); title: @tr("Supports"); }
                        if root.settings-search == "" || root.settings-match(@tr("Enable supports"), root.settings-search): CheckBox { min-height: 32px; text: @tr("Enable supports"); checked <=> root.supports-enabled; }
                        if root.settings-search == "" || root.settings-match(@tr("Support preset"), root.settings-search): HorizontalLayout {
                            height: 32px; spacing: 6px;
                            Text { text: @tr("Support preset"); overflow: elide; color: ShellTheme.text; min-width: 0px; horizontal-stretch: 1; vertical-alignment: center; font-size: 13px; }
                            VerticalLayout { alignment: center;
                                ComboBox { width: 104px; height: 28px; accessible-label: @tr("Support preset"); model: [@tr("Light"), @tr("Medium"), @tr("Heavy")]; current-index <=> root.support-preset; selected(t) => { root.support-preset-selected(self.current-index); } }
                            }
                            Rectangle { width: 22px; }
                        }
                        if root.settings-search == "" ? root.settings-level >= 0 : root.settings-match(@tr("Support spacing") + " " + @tr("Overhang angle") + " " + @tr("Symmetric supports (detected models)"), root.settings-search): SettingsSection { icon: @image-url("icons/supports.svg"); title: @tr("Placement"); }
                        if (root.settings-search == "" ? root.settings-level >= 0 : root.settings-match(@tr("Support spacing"), root.settings-search)): CompactField { label: @tr("Support spacing"); unit: "mm"; value <=> root.support-spacing-mm; }
                        if (root.settings-search == "" ? root.settings-level >= 1 : root.settings-match(@tr("Overhang angle"), root.settings-search)): CompactField { label: @tr("Overhang angle"); unit: "\u{b0}"; value <=> root.support-overhang-angle-deg; }
                        if (root.settings-search == "" ? root.settings-level >= 1 : root.settings-match(@tr("Symmetric supports (detected models)"), root.settings-search)): CheckBox { min-height: 32px; text: @tr("Symmetric supports (detected models)"); checked <=> root.support-symmetric; }
                        if root.settings-search == "" ? root.settings-level >= 1 : root.settings-match(@tr("Tip contact diameter") + " " + @tr("Tip length") + " " + @tr("Contact depth"), root.settings-search): SettingsSection { icon: @image-url("icons/supports.svg"); title: @tr("Tips"); }
                        if (root.settings-search == "" ? root.settings-level >= 1 : root.settings-match(@tr("Tip contact diameter"), root.settings-search)): CompactField { label: @tr("Tip contact diameter"); unit: "mm"; value <=> root.support-tip-contact-diameter-mm; }
                        if (root.settings-search == "" ? root.settings-level >= 1 : root.settings-match(@tr("Tip length"), root.settings-search)): CompactField { label: @tr("Tip length"); unit: "mm"; value <=> root.support-tip-length-mm; }
                        if (root.settings-search == "" ? root.settings-level >= 2 : root.settings-match(@tr("Contact depth"), root.settings-search)): CompactField { label: @tr("Contact depth"); unit: "mm"; value <=> root.support-contact-depth-mm; }
                        if root.settings-search == "" ? root.settings-level >= 0 : root.settings-match(@tr("Shaft diameter") + " " + @tr("Tree supports") + " " + @tr("Branch angle limit") + " " + @tr("Min column diameter") + " " + @tr("Max column diameter"), root.settings-search): SettingsSection { icon: @image-url("icons/supports.svg"); title: @tr("Columns"); }
                        if (root.settings-search == "" ? root.settings-level >= 1 : root.settings-match(@tr("Shaft diameter"), root.settings-search)): CompactField { label: @tr("Shaft diameter"); unit: "mm"; value <=> root.support-shaft-diameter-mm; }
                        if (root.settings-search == "" ? root.settings-level >= 0 : root.settings-match(@tr("Tree supports"), root.settings-search)): CheckBox { min-height: 32px; text: @tr("Tree supports"); checked <=> root.support-tree; }
                        if root.support-tree && (root.settings-search == "" ? root.settings-level >= 1 : root.settings-match(@tr("Branch angle limit"), root.settings-search)): CompactField { label: @tr("Branch angle limit"); unit: "\u{b0}"; value <=> root.support-branch-angle-deg; }
                        if root.support-tree && (root.settings-search == "" ? root.settings-level >= 1 : root.settings-match(@tr("Min column diameter"), root.settings-search)): CompactField { label: @tr("Min column diameter"); unit: "mm"; value <=> root.support-min-column-diameter-mm; }
                        if root.support-tree && (root.settings-search == "" ? root.settings-level >= 1 : root.settings-match(@tr("Max column diameter"), root.settings-search)): CompactField { label: @tr("Max column diameter"); unit: "mm"; value <=> root.support-max-column-diameter-mm; }
                        if root.settings-search == "" ? root.settings-level >= 0 : root.settings-match(@tr("Lift") + " " + @tr("Raft") + " " + @tr("Lattice raft") + " " + @tr("Skate raft (pads under the columns)") + " " + @tr("Raft thickness") + " " + @tr("Raft margin") + " " + @tr("Base diameter") + " " + @tr("Base height"), root.settings-search): SettingsSection { icon: @image-url("icons/layers.svg"); title: @tr("Raft and base"); }
                        if (root.settings-search == "" ? root.settings-level >= 1 : root.settings-match(@tr("Lift"), root.settings-search)): CompactField { label: @tr("Lift"); unit: "mm"; value <=> root.support-lift-mm; }
                        if (root.settings-search == "" || root.settings-match(@tr("Raft type") + " " + @tr("Lattice raft") + " " + @tr("Skate raft"), root.settings-search)): HorizontalLayout {
                            height: 32px; spacing: 6px;
                            Text { text: @tr("Raft type"); overflow: elide; color: ShellTheme.text; min-width: 0px; horizontal-stretch: 1; vertical-alignment: center; font-size: 13px; }
                            VerticalLayout { alignment: center;
                                ComboBox { width: 150px; height: 28px; accessible-label: @tr("Raft type"); model: [@tr("No raft"), @tr("Solid raft"), @tr("Lattice raft (least peel)"), @tr("Skate pads (under each column)")]; current-index <=> root.support-raft-kind; }
                            }
                            Rectangle { width: 22px; }
                        }
                        if (root.settings-search == "" ? root.settings-level >= 1 : root.settings-match(@tr("Raft thickness"), root.settings-search)): CompactField { label: @tr("Raft thickness"); unit: "mm"; value <=> root.support-raft-thickness-mm; }
                        if (root.settings-search == "" ? root.settings-level >= 1 : root.settings-match(@tr("Raft margin"), root.settings-search)): CompactField { label: @tr("Raft margin"); unit: "mm"; value <=> root.support-raft-margin-mm; }
                        if (root.settings-search == "" ? root.settings-level >= 1 : root.settings-match(@tr("Base diameter"), root.settings-search)): CompactField { label: @tr("Base diameter"); unit: "mm"; value <=> root.support-base-diameter-mm; }
                        if (root.settings-search == "" ? root.settings-level >= 1 : root.settings-match(@tr("Base height"), root.settings-search)): CompactField { label: @tr("Base height"); unit: "mm"; value <=> root.support-base-height-mm; }
                        if root.settings-search == "": Button { text: root.making-supports ? @tr("Generating...") : @tr("Generate supports"); enabled: root.supports-enabled && root.scene-present && !root.making-supports && !root.slicing && !root.plate-locked; clicked => { root.auto-supports-requested(); } }
                    }
                    if root.settings-search != "" ? root.others-matches : root.settings-tab == 4: VerticalLayout {
                        spacing: 0px;
                        if root.settings-search == "": SettingsSection { icon: @image-url("icons/gear.svg"); title: @tr("Plate and models"); }
                        if (root.settings-search == "") || (root.settings-search != "" && root.settings-match(@tr("Arrange gap"), root.settings-search)): CompactField { label: @tr("Arrange gap"); unit: "mm"; value <=> root.arrange-gap-mm; }
                        if root.settings-search == "" && root.mirror-summary != "": Text { text: root.mirror-summary; color: ShellTheme.muted; wrap: word-wrap; height: 28px; vertical-alignment: center; }
                        if root.settings-search == "": Button { text: @tr("Prepare" => "Repair meshes"); enabled: root.scene-present && !root.busy-opening && root.section != WorkspaceSection.Slice; clicked => { root.section-picked(WorkspaceSection.Prepare); root.repair-models(); } }
                    }
                }
            }
        }
    }
    Rectangle {
        x: root.width - root.right-panel-w; y: 68px; width: 284px; height: root.height - 108px;
        visible: root.right-panel-w > 0;
        background: ShellTheme.panel;
        if root.section != WorkspaceSection.Slice: VerticalLayout {
            padding: 8px; spacing: 8px;
            HorizontalLayout { spacing: 2px;
                Text { text: @tr("Objects ({})", root.object-model-count); color: ShellTheme.text; font-size: 14px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                Rectangle {
                    width: 28px; height: 28px; border-radius: 4px;
                    accessible-role: button;
                    accessible-label: root.parts-panel-folded ? @tr("Expand object list") : @tr("Collapse object list");
                    accessible-action-default => { root.parts-panel-folded = !root.parts-panel-folded; }
                    background: collapse-touch.has-hover ? ShellTheme.field : transparent;
                    Image { source: root.parts-panel-folded ? @image-url("icons/chevron-right.svg") : @image-url("icons/chevron-down.svg"); width: 16px; height: 16px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; colorize: ShellTheme.muted; }
                    collapse-touch := TouchArea { mouse-cursor: pointer; clicked => { root.parts-panel-folded = !root.parts-panel-folded; } }
                }
                // Slides the whole panel out of the way (Ctrl+L brings it back).
                IconTool { width: 28px; height: 28px; tint: -1; icon: @image-url("icons/panel-hide.svg"); label: @tr("Hide object panel (Ctrl+L)");
                    clicked => { root.parts-panel-shown = false; root.parts-panel-toggled(false); } }
            }
            if !root.parts-panel-folded: Text { text: root.object-list-stats-text; color: ShellTheme.muted; font-size: 12px; wrap: word-wrap; }
            // The list scrolls on its own, so the object information stays
            // in view however many parts the plate holds (R109).
            if !root.parts-panel-folded: ScrollView {
                height: Math.min(object-rows.preferred-height, (root.height - 108px) * 0.55);
                viewport-width: self.width;
                object-rows := VerticalLayout {
                    spacing: 4px; padding-right: 8px; alignment: start;
                    for item[i] in root.parts-list: Rectangle {
                        // A model's supports sit under it as a slim, indented row.
                        height: root.object-row-support[i] ? 30px : 40px;
                        border-radius: ShellTheme.radius;
                        background: root.selected-object-rows[i] ? ShellTheme.accent.transparentize(0.8) : root.object-row-support[i] ? transparent : ShellTheme.field;
                        HorizontalLayout {
                            padding: root.object-row-support[i] ? 2px : 4px;
                            padding-left: root.object-row-support[i] ? 22px : 4px;
                            spacing: 6px;
                            if root.object-row-support[i]: VerticalLayout { alignment: center;
                                Image { source: @image-url("icons/supports.svg"); width: 14px; height: 14px; colorize: ShellTheme.muted; }
                            }
                            IconTool { width: root.object-row-support[i] ? 26px : 32px; height: root.object-row-support[i] ? 26px : 32px; icon: @image-url("icons/eye.svg"); label: @tr("Visibility"); active: root.object-visibility[i]; clicked => { root.object-visibility-toggled(i); } }
                            Rectangle {
                                horizontal-stretch: 1;
                                VerticalLayout {
                                    alignment: center; spacing: 0px;
                                    Text { text: item.text; color: root.object-row-support[i] ? ShellTheme.muted : ShellTheme.text; font-size: root.object-row-support[i] ? 12px : 13px; overflow: elide; }
                                    if !root.object-row-support[i]: Text { text: root.object-triangle-counts[i]; color: ShellTheme.muted; font-size: 11px; overflow: elide; }
                                }
                                accessible-role: button;
                                accessible-label: @tr("Select object {}", item.text);
                                accessible-action-default => { root.part-row-picked(i); }
                                TouchArea { clicked => { root.part-row-picked(i); } }
                            }
                            // A support row's trash removes that model's supports;
                            // a model's shows only on the selected row (R109: a
                            // greyed trash on every row).
                            if root.object-row-support[i] || root.selected-object-rows[i]: IconTool {
                                width: root.object-row-support[i] ? 26px : 32px; height: root.object-row-support[i] ? 26px : 32px;
                                icon: @image-url("icons/delete.svg");
                                label: root.object-row-support[i] ? @tr("Remove these supports") : @tr("Delete (Del)");
                                enabled: root.object-row-support[i] ? !root.plate-locked && !root.making-supports && !root.slicing : root.selected-object-rows[i];
                                clicked => { if root.object-row-support[i] { root.remove-row-supports-requested(i); } else { root.delete-key(); } } }
                        }
                    }
                }
            }
            if !root.parts-panel-folded: Rectangle { height: 1px; background: ShellTheme.border; }
            if !root.parts-panel-folded: Text { text: @tr("Object information"); color: ShellTheme.text; font-size: 14px; font-weight: 600; }
            if !root.parts-panel-folded && root.chosen-part-row < 0: Text { text: @tr("Select an object"); color: ShellTheme.muted; }
            if !root.parts-panel-folded && root.chosen-part-row >= 0: InfoRow { label: @tr("Size"); value: root.bbox-x-text + " × " + root.bbox-y-text + " × " + root.bbox-z-text + " mm"; }
            if !root.parts-panel-folded && root.chosen-part-row >= 0 && root.object-volume-text != "": InfoRow { label: @tr("Volume"); value: root.object-volume-text; }
            if !root.parts-panel-folded && root.chosen-part-row >= 0: InfoRow { label: @tr("Position"); value: root.position-x-text + ", " + root.position-y-text + ", " + root.position-z-text + " mm"; }
            if !root.parts-panel-folded && root.chosen-part-row >= 0 && root.object-plate-number > 0: InfoRow { label: @tr("Plate"); value: root.object-plate-number; }
            Rectangle { vertical-stretch: 1; }
        }
        if root.section == WorkspaceSection.Slice: VerticalLayout {
            padding: 16px; spacing: 8px;
            Text { text: @tr("Print statistics"); color: ShellTheme.text; font-size: 14px; font-weight: 600; }
            if root.hollow-saved-text != "" && root.hollow-saved-text != "0.00 mL": Text { text: @tr("Resin saved by hollowing: {}", root.hollow-saved-text); color: ShellTheme.muted; }

            StatTile { icon: @image-url("icons/clock.svg"); value: root.estimated-print-time-text; label: @tr("Print time"); }
            StatTile { icon: @image-url("icons/droplet.svg"); value: root.estimated-resin-volume-text; label: @tr("Resin volume"); }
            StatTile { icon: @image-url("icons/weight.svg"); value: root.estimated-weight-text; label: @tr("Weight"); }
            StatTile { icon: @image-url("icons/coin.svg"); value: root.estimated-resin-cost-text; label: @tr("Cost");
                action-text: root.estimated-resin-cost-text == @tr("Not priced") ? @tr("Set resin price...") : "";
                action => { root.profile-edit-requested(false); }
            }
            StatTile { icon: @image-url("icons/layers.svg"); value: "" + root.layer-total; label: @tr("Layers"); }
            Text { text: @tr("Exposure schedule"); color: ShellTheme.text; font-size: 14px; font-weight: 600; }
            Text { text: root.exposure-summary; color: ShellTheme.muted; wrap: word-wrap; }
            Rectangle { height: 1px; background: ShellTheme.border; }
            HorizontalLayout { spacing: 8px;
                Text { text: @tr("Layer {} | {}", root.layer-shown + 1, root.layer-z-text); color: ShellTheme.accent; vertical-alignment: center; horizontal-stretch: 1; }
                Text { text: @tr("Go to"); color: ShellTheme.muted; font-size: 12px; vertical-alignment: center; }
                LineEdit { width: 64px; height: 28px; accessible-label: @tr("Go to layer"); placeholder-text: "" + (root.layer-shown + 1); input-type: number; horizontal-alignment: right;
                    accepted(t) => {
                        if t.is-float() { root.step-layer(Math.round(t.to-float()) - 1 - root.layer-shown); }
                        self.text = "";
                    }
                }
            }
            Text { text: root.layer-detail-text; color: ShellTheme.muted; wrap: word-wrap; }
            Rectangle { height: 1px; background: ShellTheme.border; }
            Text { text: @tr("Print risks ({})", root.print-risks.length); color: ShellTheme.text; font-weight: 600; font-size: 14px; }
            HorizontalLayout {
                Text { text: @tr("Minimum feature"); color: ShellTheme.muted; vertical-alignment: center; horizontal-stretch: 1; }
                LineEdit { width: 64px; text <=> root.minimum-feature-mm; input-type: decimal; accepted => { root.risk-settings-changed(); } }
                Text { text: "mm"; color: ShellTheme.muted; vertical-alignment: center; }
            }
            if root.supports-stale: VerticalLayout { spacing: 4px; vertical-stretch: 0;
                Text { text: @tr("Supports out of date"); color: ShellTheme.warning; wrap: word-wrap; }
                Button { text: @tr("Regenerate"); enabled: !root.slicing && !root.making-supports; clicked => { root.auto-supports-requested(); } }
            }
            if root.slice-estimates-stale: Text { text: @tr("Re-slice to refresh risks"); color: ShellTheme.warning; wrap: word-wrap; }
            if root.print-risks.length == 0: Text { text: root.layer-total > 0 ? @tr("No print risks detected") : @tr("Slice to analyze print risks"); color: ShellTheme.muted; wrap: word-wrap; }
            ScrollView {
                min-height: 140px; vertical-stretch: 1;
                VerticalLayout { spacing: 0px; alignment: start;
                    for risk[index] in root.print-risks: VerticalLayout {
                        spacing: 0px; alignment: start; vertical-stretch: 0;
                        if risk.group != "": Button { text-color: risk.error ? ShellTheme.error : ShellTheme.warning; text: (root.expanded-risk-kind == risk.kind ? "− " : "+ ") + risk.group; accessible-label: risk.group;
                            clicked => { root.expanded-risk-kind = root.expanded-risk-kind == risk.kind ? -1 : risk.kind; }
                        }
                        Rectangle {
                            accessible-role: button;
                            accessible-label: risk.title;
                            accessible-action-default => { root.risk-jump-requested(index); }
                            visible: root.expanded-risk-kind == risk.kind;
                            height: root.expanded-risk-kind == risk.kind ? 32px : 0px; background: root.selected-risk == index ? ShellTheme.field : transparent;
                            Text { x: 4px; width: parent.width - 8px; height: parent.height; text: risk.title; color: risk.error ? ShellTheme.error : ShellTheme.warning; vertical-alignment: center; font-size: 12px; overflow: elide; }
                            TouchArea { mouse-cursor: pointer; clicked => { root.risk-jump-requested(index); } }
                        }
                        if root.selected-risk == index && root.expanded-risk-kind == risk.kind: VerticalLayout {
                            spacing: 4px; padding-bottom: 6px; vertical-stretch: 0;
                            Text { text: risk.detail; color: ShellTheme.text; wrap: word-wrap; font-size: 12px; }
                            Text { text: risk.fix; color: ShellTheme.muted; wrap: word-wrap; font-size: 12px; }
                            if risk.action > 0: Button { text: @tr("Fix"); enabled: !root.slice-estimates-stale && !root.slicing && !root.making-supports; clicked => { root.risk-fix-requested(index); } }
                        }
                    }
                }
            }

        }
    }
    Rectangle {
        x: 0px; y: parent.height - 36px; width: parent.width; height: 36px;
        background: ShellTheme.panel;
        HorizontalLayout {
            padding-left: 16px; padding-right: 16px; spacing: 16px;
            if root.risk-error-count > 0: Text { text: @tr("{n} print error" | "{n} print errors" % root.risk-error-count); color: ShellTheme.error; vertical-alignment: center; }
            Text { text: root.supports-stale ? @tr("Supports out of date - regenerate supports") : root.slice-failed ? root.slice-failure-message : root.busy-opening ? @tr("Loading...") : root.plate-action-message != "" ? root.plate-action-message : root.slice-export-ready && root.slice-recovery-message != "" ? root.slice-recovery-message : @tr("Ready"); color: ShellTheme.muted; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
            Text { text: root.object-list-stats-text; color: ShellTheme.muted; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            Text { text: root.bbox-x-text == "" ? @tr("No object selected") : root.bbox-x-text + " x " + root.bbox-y-text + " x " + root.bbox-z-text + " mm"; color: ShellTheme.muted; vertical-alignment: center; }
            Text { text: root.estimated-print-time-text; color: ShellTheme.accent; vertical-alignment: center; }
        }
    }

    Rectangle {
        x: root.settings-width - 3px; y: 68px; width: 6px; height: root.height - 108px;
        background: resize-settings.has-hover ? ShellTheme.accent : transparent;
        resize-settings := TouchArea {
            mouse-cursor: ew-resize;
            moved => { if self.pressed { root.settings-width = Math.max(280px, Math.min(480px, root.settings-width + self.mouse-x - self.pressed-x)); } }
        }
    }
    if root.section != WorkspaceSection.Slice: Rectangle {
        x: root.settings-width + (parent.width - root.settings-width - root.right-panel-space - self.width) / 2;
        y: 78px; width: tools.preferred-width; height: 48px;
        background: ShellTheme.panel; border-radius: ShellTheme.radius;
        property <int> verification-popup: root.verification-popup;
        changed verification-popup => {if self.verification-popup == 1 {mirror-menu.show();} if self.verification-popup == 2 {plate-menu.show();} if self.verification-popup == 6 {more-tools.show();}}
        mirror-menu := PopupWindow { x: mirror-btn.x; y: parent.height + 4px; width: 180px; height: mirror-layout.preferred-height;
            MenuSurface {}
            mirror-layout := VerticalLayout { padding: 4px;
                for axis[index] in ["X", "Y", "Z"]: MenuRow { icon: @image-url("icons/mirror.svg"); label: @tr("Mirror along {}", axis); clicked => { root.mirror-requested(index); mirror-menu.close(); } }
            }
        }
        property <bool> show-options:root.orient-options-open;
        changed show-options => {if self.show-options {orient-menu.show();}}
        orient-menu := PopupWindow { x: orient-btn.x; y: parent.height + 4px; width: 330px; height: orient-layout.preferred-height;
            MenuSurface {}
            orient-layout := VerticalLayout { padding: 12px; spacing: 8px;
                Text { text: @tr("Auto orient"); color: ShellTheme.text; font-weight: 600; }
                Text { text: @tr("Puts a flat face down when the part has one; otherwise picks the pose with the fewest supports that fits, prints fast and peels gently."); color: ShellTheme.muted; font-size: 12px; wrap: word-wrap; }
                CheckBox { text: @tr("Plan for automatic supports"); checked <=> root.orient-for-supports; }
                Button { text: @tr("Orient selected model"); enabled: root.chosen-part-row >= 0; clicked => {root.auto-orient-requested(); orient-menu.close();} }
            }
        }
        // Overflow menu, right-aligned under its button: only what the bar
        // does not already show (Undo/Redo and orient options when narrow).
        // Each row acts first and closes the menu last: closing first tore
        // the row down and dropped the action (the UI audit caught Undo).
        more-tools := PopupWindow { x: more-btn.x + more-btn.width - self.width; y: parent.height + 4px; width: 240px; height: more-layout.preferred-height;
            MenuSurface {}
            more-layout := VerticalLayout { padding: 4px;
                if root.width < 1600px: MenuRow { icon: @image-url("icons/undo.svg"); label: @tr("Undo"); shortcut: "Ctrl+Z"; enabled: root.undo-available && !root.busy-opening; clicked => { root.undo(); more-tools.close(); } }
                if root.width < 1600px: MenuRow { icon: @image-url("icons/redo.svg"); label: @tr("Redo"); shortcut: "Ctrl+Y"; enabled: root.redo-available && !root.busy-opening; clicked => { root.redo(); more-tools.close(); } }
                if root.width < 1600px: MenuRow { icon: @image-url("icons/gear.svg"); label: @tr("Auto orient options"); enabled: root.scene-present && !root.plate-locked; clicked => { orient-menu.show(); more-tools.close(); } }
                if root.width < 1600px: MenuSeparator {}
                MenuRow { icon: @image-url("icons/center.svg"); label: @tr("Center"); enabled: root.scene-present && !root.plate-locked; clicked => { root.center-on-plate-requested(); more-tools.close(); } }
                MenuRow { icon: @image-url("icons/drop.svg"); label: @tr("Drop to plate"); enabled: root.scene-present && !root.plate-locked; clicked => { root.drop-to-plate-requested(); more-tools.close(); } }
                MenuRow { icon: @image-url("icons/delete.svg"); label: @tr("Delete all"); enabled: root.scene-present && !root.plate-locked; clicked => { root.context-action(6); more-tools.close(); } }
                MenuSeparator {}
                MenuRow { icon: @image-url("icons/cut.svg"); label: @tr("Cut"); enabled: root.scene-present && !root.plate-locked; clicked => { root.model-tool-mode = 0; root.model-tools-active = true; root.hollow-tool-active = false; root.drain-tool-active = false; root.measure-tool-active = false; root.place-face-tool-active = false; root.supports-tool-active = false; more-tools.close(); } }
                MenuRow { icon: @image-url("icons/split.svg"); label: @tr("Split"); enabled: root.scene-present && !root.plate-locked; clicked => { root.model-tool-requested(1); more-tools.close(); } }
                MenuRow { icon: @image-url("icons/boolean.svg"); label: @tr("Boolean"); enabled: root.scene-present && !root.plate-locked; clicked => { root.model-tool-mode = 2; root.model-tools-active = true; root.hollow-tool-active = false; root.drain-tool-active = false; root.measure-tool-active = false; root.place-face-tool-active = false; root.supports-tool-active = false; more-tools.close(); } }
                MenuRow { icon: @image-url("icons/label.svg"); label: @tr("Label (text)"); enabled: root.scene-present && !root.plate-locked; clicked => { root.model-tool-mode = 1; root.model-tools-active = true; root.hollow-tool-active = false; root.drain-tool-active = false; root.measure-tool-active = false; root.place-face-tool-active = false; root.supports-tool-active = false; more-tools.close(); } }
                MenuRow { icon: @image-url("icons/simplify.svg"); label: @tr("Simplify"); enabled: root.scene-present && !root.plate-locked; clicked => { root.model-tool-mode = 3; root.model-tools-active = true; root.hollow-tool-active = false; root.drain-tool-active = false; root.measure-tool-active = false; root.place-face-tool-active = false; root.supports-tool-active = false; more-tools.close(); } }
                if root.width < 1400px || root.simple-tools: MenuSeparator {}
                if root.simple-tools: MenuRow { icon: @image-url("icons/fill.svg"); label: @tr("Fill plate"); enabled: root.chosen-part-row >= 0 && !root.plate-locked; clicked => { root.fill-plate-requested(); more-tools.close(); } }
                if root.width < 1400px || root.simple-tools: MenuRow { icon: @image-url("icons/copy-add.svg"); label: @tr("Add copy (Ctrl+D)"); enabled: root.chosen-part-row >= 0 && !root.plate-locked; clicked => { root.duplicate-requested(); more-tools.close(); } }
                if root.width < 1400px || root.simple-tools: MenuRow { icon: @image-url("icons/copy-remove.svg"); label: @tr("Remove copy (Delete)"); enabled: root.chosen-part-row >= 0 && !root.plate-locked; clicked => { root.delete-key(); more-tools.close(); } }
                MenuSeparator {}
                if root.simple-tools: MenuRow { icon: @image-url("icons/measure.svg"); label: @tr("Measure"); enabled: root.scene-present; clicked => { root.model-tools-active = false; root.supports-tool-active = false; root.hollow-tool-active = false; root.drain-tool-active = false; root.measure-tool-active = false; root.place-face-tool-active = false; root.measure-tool-active = true; more-tools.close(); } }
                MenuRow { icon: @image-url("icons/risks.svg"); label: @tr("Islands & risks check"); enabled: root.scene-present && !root.plate-locked; clicked => { root.start-slice(); more-tools.close(); } }
            }
        }
        tools := HorizontalLayout {
            padding: 6px; spacing: 2px;
            IconTool { width: root.tool-w; tint: -1; icon: @image-url("icons/add.svg"); label: @tr("Add model"); clicked => { root.add-model-requested(); } }
            IconTool { width: root.tool-w; tint: 2; icon: @image-url("icons/delete.svg"); label: @tr("Delete selection (Del)"); enabled: root.chosen-part-row >= 0 && !root.plate-locked; disabled-reason: root.plate-locked ? @tr("Unlock the plate to edit models.") : @tr("Select a model first."); clicked => { root.delete-key(); } }
            Rectangle { width: 1px; background: ShellTheme.border; }
            if root.width >= 1600px: IconTool { width: root.tool-w; tint: -1; icon: @image-url("icons/undo.svg"); label: @tr("Undo (Ctrl+Z)"); enabled: root.undo-available && !root.busy-opening; disabled-reason: @tr("No changes to undo."); clicked => { root.undo(); } }
            if root.width >= 1600px: IconTool { width: root.tool-w; tint: -1; icon: @image-url("icons/redo.svg"); label: @tr("Redo (Ctrl+Y)"); enabled: root.redo-available && !root.busy-opening; disabled-reason: @tr("No changes to redo."); clicked => { root.redo(); } }
            if root.width >= 1600px: Rectangle { width: 1px; background: ShellTheme.border; }
            AutoPrepareTool { enabled: root.scene-present && !root.plate-locked && !root.making-supports; disabled-reason: root.plate-locked ? @tr("Unlock the plate to edit models.") : @tr("Add a model first."); clicked => { root.auto-prepare-requested(); } }
            Rectangle { width: 1px; background: ShellTheme.border; }

            orient-btn := IconTool { width: root.tool-w; tint: -1; icon: @image-url("icons/auto-orient.svg"); label: @tr("Auto orient (turns the part; adds no supports)"); enabled: root.scene-present && !root.plate-locked; disabled-reason: root.plate-locked ? @tr("Unlock the plate to edit models.") : @tr("Add a model first."); clicked => { root.model-tools-active = false; root.supports-tool-active = false; root.hollow-tool-active = false; root.drain-tool-active = false; root.measure-tool-active = false; root.place-face-tool-active = false; root.auto-orient-requested(); } }
            if root.width >= 1600px: IconTool { width: 32px; tint: -1; icon: @image-url("icons/gear.svg"); label: @tr("Auto orient options"); enabled: root.scene-present && !root.plate-locked; disabled-reason: root.plate-locked ? @tr("Unlock the plate to edit models.") : @tr("Add a model first."); clicked => { orient-menu.show(); } }
            IconTool { width: root.tool-w; tint: -1; icon: @image-url("icons/arrange.svg"); label: @tr("Arrange (A)"); enabled: root.scene-present && !root.plate-locked; disabled-reason: root.plate-locked ? @tr("Unlock the plate to edit models.") : @tr("Add a model first."); clicked => { root.model-tools-active = false; root.supports-tool-active = false; root.hollow-tool-active = false; root.drain-tool-active = false; root.measure-tool-active = false; root.place-face-tool-active = false; root.arrange-requested(); } }
            if !root.simple-tools: IconTool { width: root.tool-w; tint: -1; icon: @image-url("icons/fill.svg"); label: @tr("Fill plate"); enabled: root.chosen-part-row >= 0 && !root.plate-locked; disabled-reason: root.plate-locked ? @tr("Unlock the plate to edit models.") : @tr("Select a model first."); clicked => { root.model-tools-active = false; root.supports-tool-active = false; root.hollow-tool-active = false; root.drain-tool-active = false; root.measure-tool-active = false; root.place-face-tool-active = false; root.fill-plate-requested(); } }
            Rectangle { width: 1px; background: ShellTheme.border; }
            if root.width >= 1400px && !root.simple-tools: IconTool { width: root.tool-w; tint: -1; icon: @image-url("icons/copy-add.svg"); label: @tr("Add copy (Ctrl+D)"); enabled: root.chosen-part-row >= 0 && !root.plate-locked; disabled-reason: root.plate-locked ? @tr("Unlock the plate to edit models.") : @tr("Select a model first."); clicked => { root.model-tools-active = false; root.supports-tool-active = false; root.hollow-tool-active = false; root.drain-tool-active = false; root.measure-tool-active = false; root.place-face-tool-active = false; root.duplicate-requested(); } }
            if root.width >= 1400px && !root.simple-tools: IconTool { width: root.tool-w; tint: -1; icon: @image-url("icons/copy-remove.svg"); label: @tr("Remove copy (Delete)"); enabled: root.chosen-part-row >= 0 && !root.plate-locked; disabled-reason: root.plate-locked ? @tr("Unlock the plate to edit models.") : @tr("Select a model first."); clicked => { root.model-tools-active = false; root.supports-tool-active = false; root.hollow-tool-active = false; root.drain-tool-active = false; root.measure-tool-active = false; root.place-face-tool-active = false; root.delete-key(); } }
            if root.width >= 1400px && !root.simple-tools: Rectangle { width: 1px; background: ShellTheme.border; }
            IconTool { width: root.tool-w; active: root.chosen-part-row >= 0 && root.active-tool == 0 && !root.supports-tool-active && !root.hollow-tool-active && !root.measure-tool-active && !root.place-face-tool-active && !root.model-tools-active; tint: -1; icon: @image-url("icons/move.svg"); label: @tr("Move (T)"); enabled: root.chosen-part-row >= 0 && !root.plate-locked; disabled-reason: root.plate-locked ? @tr("Unlock the plate to edit models.") : @tr("Select a model first."); clicked => { root.model-tools-active = false; root.supports-tool-active = false; root.hollow-tool-active = false; root.drain-tool-active = false; root.measure-tool-active = false; root.place-face-tool-active = false; root.gizmo-toolbar(0); } }
            IconTool { width: root.tool-w; active: root.chosen-part-row >= 0 && root.active-tool == 1 && !root.supports-tool-active && !root.hollow-tool-active && !root.measure-tool-active && !root.place-face-tool-active && !root.model-tools-active; tint: -1; icon: @image-url("icons/rotate.svg"); label: @tr("Rotate (R)"); enabled: root.chosen-part-row >= 0 && !root.plate-locked; disabled-reason: root.plate-locked ? @tr("Unlock the plate to edit models.") : @tr("Select a model first."); clicked => { root.model-tools-active = false; root.supports-tool-active = false; root.hollow-tool-active = false; root.drain-tool-active = false; root.measure-tool-active = false; root.place-face-tool-active = false; root.gizmo-toolbar(1); } }
            IconTool { width: root.tool-w; active: root.chosen-part-row >= 0 && root.active-tool == 2 && !root.supports-tool-active && !root.hollow-tool-active && !root.measure-tool-active && !root.place-face-tool-active && !root.model-tools-active; tint: -1; icon: @image-url("icons/scale.svg"); label: @tr("Scale (S)"); enabled: root.chosen-part-row >= 0 && !root.plate-locked; disabled-reason: root.plate-locked ? @tr("Unlock the plate to edit models.") : @tr("Select a model first."); clicked => { root.model-tools-active = false; root.supports-tool-active = false; root.hollow-tool-active = false; root.drain-tool-active = false; root.measure-tool-active = false; root.place-face-tool-active = false; root.gizmo-toolbar(2); } }
            IconTool { width: root.tool-w; tint: -1; icon: @image-url("icons/lay-flat.svg"); label: @tr("Place on face"); active: root.place-face-tool-active; enabled: root.chosen-part-row >= 0 && !root.plate-locked; disabled-reason: root.plate-locked ? @tr("Unlock the plate to edit models.") : @tr("Select a model first."); clicked => { root.model-tools-active = false; root.supports-tool-active = false; root.hollow-tool-active = false; root.drain-tool-active = false; root.measure-tool-active = false; root.place-face-tool-active = !root.place-face-tool-active; root.place-face-tool-changed(); } }
            mirror-btn := IconTool { width: root.tool-w; tint: -1; icon: @image-url("icons/mirror.svg"); label: @tr("Mirror"); enabled: root.chosen-part-row >= 0 && !root.plate-locked; disabled-reason: root.plate-locked ? @tr("Unlock the plate to edit models.") : @tr("Select a model first."); clicked => { mirror-menu.show(); } }
            Rectangle { width: 1px; background: ShellTheme.border; }
            IconTool { width: root.tool-w; tint: -1; icon: @image-url("icons/supports.svg"); label: @tr("Supports (generate and edit)"); active: root.supports-tool-active; enabled: root.scene-present; disabled-reason: @tr("Add a model first."); clicked => { root.model-tools-active = false; root.supports-tool-active = !root.supports-tool-active; root.hollow-tool-active = false; root.drain-tool-active = false; root.measure-tool-active = false; root.place-face-tool-active = false; root.supports-enabled = true; } }
            IconTool { width: root.tool-w; tint: -1; icon: @image-url("icons/hollow.svg"); label: @tr("Hollow / Drain holes"); active: root.hollow-tool-active; enabled: root.chosen-part-row >= 0 && !root.plate-locked; disabled-reason: root.plate-locked ? @tr("Unlock the plate to edit models.") : @tr("Select a model first."); clicked => { root.model-tools-active = false; root.hollow-tool-active = !root.hollow-tool-active; root.supports-tool-active = false; root.measure-tool-active = false; root.place-face-tool-active = false; if !root.hollow-tool-active { root.drain-tool-active = false; } } }
            if !root.simple-tools: IconTool { width: root.tool-w; tint: -1; icon: @image-url("icons/cut.svg"); label: @tr("Model tools (cut, split, boolean, label)"); active: root.model-tools-active; enabled: root.chosen-part-row >= 0 && !root.plate-locked; disabled-reason: root.plate-locked ? @tr("Unlock the plate to edit models.") : @tr("Select a model first."); clicked => { root.model-tools-active = !root.model-tools-active; root.supports-tool-active = false; root.hollow-tool-active = false; root.drain-tool-active = false; root.measure-tool-active = false; root.place-face-tool-active = false; } }
            Rectangle { width: 1px; background: ShellTheme.border; }
            if !root.simple-tools: IconTool { width: root.tool-w; tint: -1; icon: @image-url("icons/measure.svg"); label: @tr("Measure"); active: root.measure-tool-active; enabled: root.scene-present; disabled-reason: @tr("Add a model first."); clicked => { root.model-tools-active = false; root.measure-tool-active = !root.measure-tool-active; root.place-face-tool-active = false; root.hollow-tool-active = false; root.drain-tool-active = false; root.supports-tool-active = false; } }
            more-btn := IconTool { width: root.tool-w; tint: -1; icon: @image-url("icons/more.svg"); label: @tr("More tools"); clicked => { more-tools.show(); } }
        }
    }
    // With the right panel slid away, a tab on the window edge brings it
    // back (R109).
    // R113: it sits in the same column as the plate tabs button, the same
    // size and card (a half-hidden edge tab overlapped that button).
    if !root.parts-panel-shown: Rectangle {
        x: root.width - 44px; y: 134px; width: 32px; height: 32px;
        border-radius: ShellTheme.radius; background: show-tab.has-hover ? ShellTheme.field : ShellTheme.panel;
        border-width: 1px; border-color: ShellTheme.border;
        accessible-role: button; accessible-label: @tr("Show object panel (Ctrl+L)");
        accessible-action-default => { root.parts-panel-shown = true; root.parts-panel-toggled(true); }
        Image { source: @image-url("icons/panel-show.svg"); width: 18px; height: 18px; x: 7px; y: 7px; colorize: ShellTheme.text; }
        show-tab := TouchArea { mouse-cursor: pointer; clicked => { root.parts-panel-shown = true; root.parts-panel-toggled(true); } }
    }
    // Plate thumbnails occupy a vertical viewport rail, only for multiple plates.
    Rectangle {
        x: parent.width - (root.section == WorkspaceSection.Slice ? 468px : root.right-panel-space + 140px); y: 134px;
        width: 84px; height: Math.min(420px, root.height - 300px);
        visible: root.plate-tabs-visible && root.plate-ids.length > 1;
        background: ShellTheme.panel; border-radius: ShellTheme.radius;
        plate-menu := PopupWindow {
            x: -228px; y: 0px; width: 224px; height: plate-menu-layout.preferred-height;
            MenuSurface { }
            plate-menu-layout := VerticalLayout { padding: 6px; spacing: 0px;
                MenuRow { icon: @image-url("icons/gear.svg"); label: @tr("Plate settings / rename"); clicked => { root.plate-settings-requested(); plate-menu.close(); } }
                MenuRow { icon: @image-url("icons/slice.svg"); label: @tr("Slice this plate"); enabled: root.scene-present && !root.slicing; clicked => { root.start-slice(); plate-menu.close(); } }
                MenuSeparator { }
                MenuRow { icon: @image-url("icons/plate-add.svg"); label: @tr("Add plate"); clicked => { root.add-plate-requested(); plate-menu.close(); } }
                MenuRow { icon: @image-url("icons/arrange.svg"); label: @tr("Arrange all plates"); enabled: root.scene-present; clicked => { root.arrange-all-requested(); plate-menu.close(); } }
                MenuSeparator { }
                MenuRow { icon: @image-url("icons/chevron-up.svg"); label: @tr("Move plate up"); enabled: root.plate-ids.length > 1; clicked => { root.reorder-plate-requested(-1); plate-menu.close(); } }
                MenuRow { icon: @image-url("icons/chevron-down.svg"); label: @tr("Move plate down"); enabled: root.plate-ids.length > 1; clicked => { root.reorder-plate-requested(1); plate-menu.close(); } }
                MenuSeparator { }
                MenuRow { icon: @image-url("icons/delete.svg"); label: @tr("Delete plate"); enabled: root.plate-ids.length > 1; clicked => { root.delete-plate-requested(); plate-menu.close(); } }
            }
        }
        VerticalLayout { padding: 4px; spacing: 4px;
            ScrollView {
                viewport-width: 64px;
                VerticalLayout { spacing: 8px; alignment: start;
                    for id[index] in root.plate-ids: Rectangle {
                        width: 72px; height: 76px;
                        accessible-role: button;
                        accessible-label: @tr("Select plate {}", index + 1);
                        accessible-action-default => { if !root.slicing { root.plate-selected(id); } }
                        background: id == root.active-plate-id ? ShellTheme.accent : ShellTheme.panel;
                        VerticalLayout {
                            padding: 2px; spacing: 2px;
                            Image { source: root.plate-thumbnails[index]; width: 64px; height: 48px; image-fit: contain; }
                            Text { text: root.plate-names[index] == "" ? @tr("Plate {}", index + 1) : root.plate-names[index]; overflow: elide; color: id == root.active-plate-id ? ShellTheme.accent-text : ShellTheme.text; vertical-alignment: center; }
                        }
                        TouchArea { clicked => { if !root.slicing { root.plate-selected(id); } } }
                    }
                }
            }
            Button { accessible-label: @tr("Plate operations"); colorize-icon: true; height: 32px; horizontal-stretch: 0; icon: @image-url("icons/gear.svg"); clicked => { plate-menu.show(); } }
        }
    }
    // Show / hide the plate tabs viewer (Sleptic: this used to add a plate;
    // the plate's own + tile and the plate menu do that). In Preview this
    // corner holds the layer slider's top label.
    // Below the toolbar's row (R94: at 1280 px the wider toolbar ran under it).
    if root.section != WorkspaceSection.Slice: Rectangle { x: root.width - root.right-panel-space - 44px; y: root.parts-panel-shown ? 134px : 174px; width: 32px; height: 32px;
        background: ShellTheme.panel; border-radius: ShellTheme.radius; border-width: 1px; border-color: ShellTheme.border;
        IconTool { width: 32px; height: 32px; tint: 0; icon: @image-url("icons/plate-tabs.svg");
            label: root.plate-tabs-visible ? @tr("Hide plate tabs") : @tr("Show plate tabs");
            active: root.plate-tabs-visible;
            clicked => { root.plate-tabs-visible = !root.plate-tabs-visible; } }
    }
    // Plate tool glyphs, one per tile of the plate mesh (slot 0 = plate
    // number, 1..5 = clear / orient / arrange / lock / settings, 6 = add
    // plate). x/y/w/h
    // are the tile's projected bounds, so the glyph stays on its tile.
    // The tiles are drawings only, with no TouchArea: the viewport gets
    // every pointer event, so a right- or left-drag that starts on a tile
    // pans or orbits like anywhere else (a tile TouchArea grabbed the press
    // and cut the drag short). The controller hit-tests tiles for hover and
    // runs a tile on a left click that did not move.
    // Clipped to the 3D view: a tile running off the canvas (zoomed in, odd
    // angle) keeps its visible part and glyph instead of vanishing, and
    // nothing spills onto the status bar or side panels.
    Rectangle {
        x: root.settings-width; y: 68px;
        width: root.width - root.settings-width - root.right-panel-space;
        height: root.height - 108px;
        clip: true;
        visible: root.section != WorkspaceSection.Slice;
    for tile[ti] in root.plate-overlays: Rectangle {
        property <bool> usable: tile.slot == 0 || tile.slot >= 4 || (root.scene-present && !tile.locked);
        x: tile.x * 1px;
        y: tile.y * 1px;
        width: tile.w * 1px; height: tile.h * 1px;
        property <length> glyph: Math.min(self.width, self.height) * 0.72;
        // The tile, its icon and the plate number are part of the 3D plate
        // (R110); this element only carries the hover label.
        // Hover label (the tile has no TouchArea for a Tooltip to use).
        if ti == root.hovered-plate-tile: Rectangle {
            x: (parent.width - self.width) / 2; y: -self.height - 6px;
            width: hover-label.preferred-width + 16px; height: 24px;
            background: ShellTheme.panel; border-radius: 4px;
            border-width: 1px; border-color: ShellTheme.border;
            hover-label := Text {
                font-size: 12px; color: ShellTheme.text; vertical-alignment: center;
                text: tile.slot == 0 ? @tr("Plate {}", tile.index)
                    : tile.slot == 1 ? @tr("Delete plate {}", tile.index)
                    : tile.slot == 2 ? @tr("Auto orient plate {}", tile.index)
                    : tile.slot == 3 ? @tr("Arrange plate {}", tile.index)
                    : tile.slot == 4 ? (tile.locked ? @tr("Unlock plate {}", tile.index) : @tr("Lock plate {}", tile.index))
                    : tile.slot == 5 ? @tr("Plate {} settings", tile.index)
                    : @tr("Add plate");
            }
        }
    }
    }
    if root.section != WorkspaceSection.Slice || root.preview-3d: Rectangle {
        // Fusion-style view cube (Sleptic's reference): light grey solid with
        // uppercase face labels, X / Z (and Y when it faces us) along its own
        // edges, a home button top-left and the view menu arrow bottom-right.
        x: root.settings-width + 10px; y: parent.height - 220px; width: 148px; height: 146px;
        background: transparent;
        Rectangle { x: 14px; y: 14px; width: 120px; height: 120px;
            // Rounded edges and corners (Sleptic, R54: smaller and filleted),
            // shaded by how squarely each facet faces the camera.
            for piece in root.cube-round: Path {
                x: 0px; y: 0px; width: 120px; height: 120px; viewbox-width: 120; viewbox-height: 120;
                commands: piece.path;
                fill: #eef0f3.mix(#b4b9c0, 0.1 + 0.9 * piece.facing);
                stroke: #eef0f3.mix(#b4b9c0, 0.1 + 0.9 * piece.facing); stroke-width: 0.8px;
            }
            for face in root.cube-faces: Rectangle {
                accessible-role: button;
                accessible-label: @tr("View {}", face.label);
                accessible-action-default => { root.cube-clicked(face.cx, face.cy); }
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                Path { x: 0px; y: 0px; width: 120px; height: 120px; viewbox-width: 120; viewbox-height: 120;
                    fill: #eef0f3.mix(#b4b9c0, 0.1 + 0.9 * face.facing);
                    stroke: #eef0f3.mix(#b4b9c0, 0.1 + 0.9 * face.facing); stroke-width: 0.8px;
                    MoveTo { x: face.x0; y: face.y0; } LineTo { x: face.x1; y: face.y1; }
                    LineTo { x: face.x2; y: face.y2; } LineTo { x: face.x3; y: face.y3; } Close {}
                }
                // The label is printed onto the face (it turns and foreshortens
                // with the cube), not drawn upright at the face centre.
                Path { x: 0px; y: 0px; width: 120px; height: 120px; viewbox-width: 120; viewbox-height: 120;
                    visible: Math.abs((face.x1 - face.x0) * (face.y3 - face.y0) - (face.y1 - face.y0) * (face.x3 - face.x0)) > 150;
                    commands: face.label-path; fill: #4a4f57;
                }
            }
            // Hovered face / edge / corner (Fusion's soft blue patches).
            if root.cube-highlight != "": Path {
                x: 0px; y: 0px; width: 120px; height: 120px; viewbox-width: 120; viewbox-height: 120;
                commands: root.cube-highlight; fill: #5b9befa0;
            }
            for axis[index] in root.nav-axes: Rectangle {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                visible: axis.visible;
                Path { x: 0px; y: 0px; width: 120px; height: 120px; viewbox-width: 120; viewbox-height: 120;
                    stroke: index == 0 ? #e0352b : index == 1 ? #2fa84f : #2c5fe0; stroke-width: 3px;
                    MoveTo { x: axis.x0; y: axis.y0; } LineTo { x: axis.x; y: axis.y; }
                }
                Text { x: axis.x * 1px + (axis.x - axis.x0) * 0.12px - 6px; y: axis.y * 1px + (axis.y - axis.y0) * 0.12px - 9px;
                    width: 14px; height: 18px; text: axis.label; font-size: 15px; font-weight: 700;
                    color: index == 0 ? #e0352b : index == 1 ? #2fa84f : #2c5fe0; }
            }
            cube-touch := TouchArea {
                mouse-cursor: root.cube-hover-face >= 0 ? pointer : default;
                clicked => { root.cube-clicked(self.mouse-x / 1px, self.mouse-y / 1px); }
                pointer-event(e) => { if e.kind == PointerEventKind.move { root.cube-hovered(self.mouse-x / 1px, self.mouse-y / 1px); } }
                changed has-hover => { if !self.has-hover { root.cube-hover-face = -1; root.cube-highlight = ""; } }
            }
        }
        // Home: back to the front-top-right view.
        Rectangle { x: 16px; y: 10px; width: 28px; height: 28px; border-radius: 4px;
            accessible-role: button; accessible-label: @tr("Home view");
            accessible-action-default => { root.navigation-view(0); }
            background: home-touch.has-hover ? ShellTheme.panel.transparentize(0.2) : transparent;
            Path { x: 3px; y: 3px; width: 22px; height: 22px; viewbox-width: 22; viewbox-height: 22;
                stroke: home-touch.has-hover ? ShellTheme.accent : #9aa0a8; stroke-width: 1.6px;
                commands: "M 2 10 L 11 2 L 20 10 M 4.5 8 L 4.5 20 L 17.5 20 L 17.5 8 M 9 20 L 9 14 L 13 14 L 13 20";
            }
            home-touch := TouchArea { mouse-cursor: pointer; clicked => { root.navigation-view(0); } }
            Tooltip { text: @markdown("\{@tr("Home view")}"); }
        }
        // View menu (named views, zoom to fit).
        Rectangle { x: 114px; y: 112px; width: 26px; height: 26px; border-radius: 4px;
            accessible-role: button; accessible-label: @tr("View menu");
            accessible-action-default => { nav-menu.show(); }
            background: menu-touch.has-hover ? ShellTheme.panel.transparentize(0.2) : transparent;
            Path { x: 4px; y: 5px; width: 18px; height: 16px; viewbox-width: 18; viewbox-height: 16;
                stroke: menu-touch.has-hover ? ShellTheme.accent : #9aa0a8; stroke-width: 1.5px;
                commands: "M 2 3 L 16 3 M 3 7 L 9 14 L 15 7 Z";
            }
            menu-touch := TouchArea { mouse-cursor: pointer; clicked => { nav-menu.show(); } }
            Tooltip { text: @markdown("\{@tr("View menu")}"); }
        }
        property <int> verification-popup: root.verification-popup;
        changed verification-popup => {if self.verification-popup == 5 {nav-menu.show();}}
        nav-menu := PopupWindow { x: 142px; y: 134px - self.height - 4px; width: 170px; height: nav-layout.preferred-height;
            MenuSurface {}
            nav-layout := VerticalLayout { padding: 4px;
                for name[index] in [@tr("Home"), @tr("Top"), @tr("Bottom"), @tr("Front"), @tr("Back"), @tr("Left"), @tr("Right")]: MenuRow {
                    label: name; clicked => { root.navigation-view(index); nav-menu.close(); }
                }
                MenuSeparator {}
                MenuRow { label: @tr("Zoom to fit (F)"); clicked => { root.fit-view-asked(); nav-menu.close(); } }
            }
        }
    }
    if root.chosen-part-row >= 0 && root.active-tool >= 0 && !root.model-tools-active && !root.hollow-tool-active && !root.supports-tool-active && !root.measure-tool-active && !root.place-face-tool-active && root.section != WorkspaceSection.Slice: Rectangle {
        x: root.settings-width + 14px; y: 138px; width: 284px;
        // Sized to its contents: a fixed height spread the spare space into
        // a gap under the title.
        height: tool-layout.preferred-height + 44px;
        background: ShellTheme.panel; border-radius: ShellTheme.radius;
        border-color: ShellTheme.border; border-width: 1px;
        drop-shadow-blur: 12px; drop-shadow-offset-y: 4px; drop-shadow-color: #00000040;
        Text { x: 12px; y: 0px; height: 44px; text: root.active-tool == 0 ? @tr("Move") : root.active-tool == 1 ? @tr("Rotate") : @tr("Scale"); color: ShellTheme.text; font-size: 14px; font-weight: 600; vertical-alignment: center; }
        tool-layout := VerticalLayout { x: 0px; y: 44px; width: parent.width; height: self.preferred-height; padding: 12px; padding-top: 0px; spacing: 8px; alignment: start;
                if root.active-tool == 0: TransformPanel {
        width: 260px;
        loading: root.busy-opening || root.plate-locked || root.chosen-part-row == -1;
        position-x-text: root.position-x-text;
        position-y-text: root.position-y-text;
        position-z-text: root.position-z-text;
        bbox-x-text: root.bbox-x-text;
        bbox-y-text: root.bbox-y-text;
        bbox-z-text: root.bbox-z-text;
        position-x-committed(t) => {
            root.position-x-committed(t);
        }
        position-y-committed(t) => {
            root.position-y-committed(t);
        }
        position-z-committed(t) => {
            root.position-z-committed(t);
        }
        center-on-plate-requested => {
            root.center-on-plate-requested();
        }
        drop-to-plate-requested => {
            root.drop-to-plate-requested();
        }
    }
                if root.active-tool != 0: VerticalLayout {
                    spacing: 8px;
                    if root.active-tool == 1: VerticalLayout {

                        spacing: 4px;
                        HorizontalLayout {
                            Text { text: @tr("Rotation"); color: ShellTheme.muted; vertical-alignment: center; horizontal-stretch: 1; }
                            // Uniform scaling is the default: one axis edit sets all three.
                            if 0 == 1: CheckBox { text: @tr("Uniform"); checked <=> root.scale-uniform; }
                        }
                        for axis[i] in ["X","Y","Z"]: HorizontalLayout {
                            height: 32px;
                            spacing: 4px;
                            Text { text: axis; color: ShellTheme.text; vertical-alignment: center; width: 50%; }
                            LineEdit {
                                accessible-label: @tr("Rotation {}", axis);
                                text: 0 == 0 ? root.object-rotation[i] : root.object-scale[i];
                                horizontal-alignment: right; min-width: 0px;
                                // Gated on the model's value (empty = nothing
                                // selected), never the typed text: clearing
                                // the box disabled it for good (Sleptic).
                                enabled: root.object-rotation[i] != "" && !root.plate-locked && !root.busy-opening;
                                accepted(t) => {
                                    if (0 == 1 && root.scale-uniform) {
                                        root.object-transform-committed(true, 0, t);
                                        root.object-transform-committed(true, 1, t);
                                        root.object-transform-committed(true, 2, t);
                                    } else {
                                        root.object-transform-committed(0 == 1, i, t);
                                    }
                                }
                            }
                            Text { text: 0 == 0 ? "\u{b0}" : "%"; color: ShellTheme.muted; vertical-alignment: center; width: 14px; }
                        }
                    }
                    if root.active-tool == 2: VerticalLayout {

                        spacing: 4px;
                        HorizontalLayout {
                            Text { text: @tr("Scale"); color: ShellTheme.muted; vertical-alignment: center; horizontal-stretch: 1; }
                            // Uniform scaling is the default: one axis edit sets all three.
                            if 1 == 1: CheckBox { text: @tr("Uniform"); checked <=> root.scale-uniform; }
                        }
                        for axis[i] in ["X","Y","Z"]: HorizontalLayout {
                            height: 32px;
                            spacing: 4px;
                            Text { text: axis; color: ShellTheme.text; vertical-alignment: center; width: 50%; }
                            LineEdit {
                                accessible-label: @tr("Scale {}", axis);
                                text: 1 == 0 ? root.object-rotation[i] : root.object-scale[i];
                                horizontal-alignment: right; min-width: 0px;
                                enabled: root.object-scale[i] != "" && !root.plate-locked && !root.busy-opening;
                                accepted(t) => {
                                    if (1 == 1 && root.scale-uniform) {
                                        root.object-transform-committed(true, 0, t);
                                        root.object-transform-committed(true, 1, t);
                                        root.object-transform-committed(true, 2, t);
                                    } else {
                                        root.object-transform-committed(1 == 1, i, t);
                                    }
                                }
                            }
                            Text { text: 1 == 0 ? "\u{b0}" : "%"; color: ShellTheme.muted; vertical-alignment: center; width: 14px; }
                        }
                        // Orca's Scale to fit: as large as the build volume holds.
                        Button {
                            text: @tr("Scale to fit");
                            enabled: !root.plate-locked && !root.busy-opening;
                            clicked => { root.scale-to-fit-requested(); }
                        }
                    }

                }        }
    }
    if root.supports-tool-active && root.section != WorkspaceSection.Slice: ToolPanel {
        x: root.settings-width + 14px; y: 138px; width: 340px;
        height: Math.min(supports-layout.preferred-height + 50px, root.height - 220px);
        title: @tr("Supports");
        close => { root.supports-tool-active = false; }
        ScrollView { x: 0px; y: 48px; width: parent.width; height: parent.height - 50px; viewport-width: self.width;
            supports-layout := VerticalLayout { padding: 12px; padding-top: 0px; spacing: 6px; alignment: start;
                CheckBox { text: @tr("Enable supports"); checked <=> root.supports-enabled; }
                ComboBox { accessible-label: @tr("Support preset"); model: [@tr("Light"), @tr("Medium"), @tr("Heavy")]; current-index <=> root.support-preset;
                    selected(index) => { root.support-preset-selected(self.current-index); }
                }
                HorizontalLayout { spacing: 8px;
                    PrimaryButton { horizontal-stretch: 1; icon: @image-url("icons/supports.svg"); text: root.making-supports ? @tr("Generating...") : @tr("Generate"); enabled: root.supports-enabled && root.scene-present && !root.making-supports && !root.slicing && !root.plate-locked; clicked => { root.auto-supports-requested(); } }
                    Button { horizontal-stretch: 1; icon: @image-url("icons/delete.svg"); text: @tr("Remove all"); enabled: root.supports-count > 0 && !root.making-supports && !root.slicing && !root.plate-locked; clicked => { root.remove-supports-requested(); } }
                }
                Text { text: @tr("{n} support on this plate" | "{n} supports on this plate" % root.supports-count); color: ShellTheme.muted; font-size: 12px; }
                // The next step, so a newcomer knows where to go (R95).
                Button { text: @tr("Next: slice and preview"); enabled: root.scene-present && !root.busy-opening && !root.slicing && !root.making-supports;
                    clicked => { root.supports-tool-active = false; root.hub-page = 0; if (!root.slice-export-ready) { root.start-slice(); } else { root.section-picked(WorkspaceSection.Slice); } } }
                if root.supports-error != "": Text { text: root.supports-error; color: ShellTheme.warning; wrap: word-wrap; }
                PanelSection { title: @tr("Placement"); }
                PanelField { label: @tr("Support spacing"); unit: "mm"; value <=> root.support-spacing-mm; }
                if root.settings-level > 0: PanelField { label: @tr("Overhang angle"); unit: "\u{b0}"; value <=> root.support-overhang-angle-deg; }
                if root.settings-level > 0: CheckBox { min-height: 32px; text: @tr("Symmetric supports (detected models)"); checked <=> root.support-symmetric; }
                if root.settings-level > 0: PanelSection { title: @tr("Tips"); }
                if root.settings-level > 0: PanelField { label: @tr("Tip contact diameter"); unit: "mm"; value <=> root.support-tip-contact-diameter-mm; }
                if root.settings-level > 0: PanelField { label: @tr("Tip length"); unit: "mm"; value <=> root.support-tip-length-mm; }
                if root.settings-level > 1: PanelField { label: @tr("Contact depth"); unit: "mm"; value <=> root.support-contact-depth-mm; }
                PanelSection { title: @tr("Columns"); }
                if root.settings-level > 0: PanelField { label: @tr("Shaft diameter"); unit: "mm"; value <=> root.support-shaft-diameter-mm; }
                CheckBox { text: @tr("Tree supports"); checked <=> root.support-tree; }
                if root.support-tree && root.settings-level > 0: PanelField { label: @tr("Branch angle limit"); unit: "\u{b0}"; value <=> root.support-branch-angle-deg; }
                if root.support-tree && root.settings-level > 0: PanelField { label: @tr("Min column diameter"); unit: "mm"; value <=> root.support-min-column-diameter-mm; }
                if root.support-tree && root.settings-level > 0: PanelField { label: @tr("Max column diameter"); unit: "mm"; value <=> root.support-max-column-diameter-mm; }
                PanelSection { title: @tr("Base and raft"); }
                if root.settings-level > 0: PanelField { label: @tr("Lift"); unit: "mm"; value <=> root.support-lift-mm; }
                HorizontalLayout { height: 34px; spacing: 6px;
                    Text { text: @tr("Raft type"); color: ShellTheme.text; min-width: 0px; horizontal-stretch: 1; vertical-alignment: center; font-size: 13px; overflow: elide; }
                    VerticalLayout { alignment: center;
                        ComboBox { width: 170px; accessible-label: @tr("Raft type (Supports panel)"); model: [@tr("No raft"), @tr("Solid raft"), @tr("Lattice raft (least peel)"), @tr("Skate pads (under each column)")]; current-index <=> root.support-raft-kind; }
                    }
                }
                if root.settings-level > 0: PanelField { label: @tr("Raft thickness"); unit: "mm"; value <=> root.support-raft-thickness-mm; }
                if root.settings-level > 0: PanelField { label: @tr("Raft margin"); unit: "mm"; value <=> root.support-raft-margin-mm; }
                if root.settings-level > 0: PanelField { label: @tr("Base diameter"); unit: "mm"; value <=> root.support-base-diameter-mm; }
                if root.settings-level > 0: PanelField { label: @tr("Base height"); unit: "mm"; value <=> root.support-base-height-mm; }
                PanelSection { title: @tr("Manual editing"); }
                PanelField { label: @tr("Brush radius"); unit: "mm"; value <=> root.support-brush-radius-mm; }
                Text { text: @tr("Click a model to add a support; Shift-click a support to remove it. Ctrl-drag paints where supports must go, Alt-drag where they must not."); color: ShellTheme.muted; font-size: 12px; wrap: word-wrap; }
            }
        }
    }
    if root.hollow-tool-active && root.chosen-part-row >= 0 && root.section != WorkspaceSection.Slice: ToolPanel {
        x: root.settings-width + 14px;
        y: 138px; width: 320px; height: Math.min(hollow-layout.preferred-height + 50px, root.height - 220px);
        title: @tr("Hollow");
        close => { root.hollow-tool-active = false; root.drain-tool-active = false; }
        ScrollView { x: 0px; y: 48px; width: parent.width; height: parent.height - 50px; viewport-width: self.width;
        hollow-layout := VerticalLayout { padding: 12px; padding-top: 0px; spacing: 6px; alignment: start;
            PanelField { label: @tr("Wall thickness"); unit: "mm"; value <=> root.hollow-wall-mm; }
            HorizontalLayout { spacing: 8px;
                PrimaryButton { horizontal-stretch: 1; icon: @image-url("icons/hollow.svg"); text: @tr("Hollow"); clicked => { root.hollow-requested(false); } }
                Button { horizontal-stretch: 1; text: @tr("Remove hollow"); enabled: root.selected-is-hollow; clicked => { root.context-action(18); } }
            }
            PanelSection { title: @tr("Drain holes"); }
            PanelField { label: @tr("Drain diameter"); unit: "mm"; value <=> root.drain-diameter-mm; }
            HorizontalLayout { height: 34px; spacing: 6px;
                Text { text: @tr("Direction"); color: ShellTheme.text; min-width: 0px; horizontal-stretch: 1; vertical-alignment: center; font-size: 13px; overflow: elide; }
                VerticalLayout { alignment: center;
                    ComboBox { width: 160px; accessible-label: @tr("Drain direction"); model: [@tr("Into the surface"), @tr("Along the view"), @tr("Straight down")]; current-index <=> root.drain-aim; }
                }
            }
            HorizontalLayout { height: 34px; spacing: 6px;
                Text { text: @tr("Depth"); color: ShellTheme.text; min-width: 0px; horizontal-stretch: 1; vertical-alignment: center; font-size: 13px; overflow: elide; }
                VerticalLayout { alignment: center;
                    ComboBox { width: 160px; accessible-label: @tr("Drain depth"); model: [@tr("Through the wall"), @tr("Custom length")]; current-index: root.drain-custom-depth ? 1 : 0; selected(v) => { root.drain-custom-depth = self.current-index == 1; } }
                }
            }
            if root.drain-custom-depth: PanelField { label: @tr("Hole length"); unit: "mm"; value <=> root.drain-depth-mm; }
            HorizontalLayout { height: 34px; spacing: 6px;
                Text { text: @tr("Mirror"); color: ShellTheme.text; min-width: 0px; horizontal-stretch: 1; vertical-alignment: center; font-size: 13px; overflow: elide; }
                VerticalLayout { alignment: center;
                    ComboBox { width: 160px; accessible-label: @tr("Drain mirror"); model: [@tr("No mirror"), @tr("Left and right"), @tr("Front and back"), @tr("All four sides")]; current-index <=> root.drain-mirror; }
                }
            }
            CheckBox { text: @tr("Place drain holes by clicking"); checked <=> root.drain-tool-active; }
            Button { text: @tr("Auto drain holes"); clicked => { root.hollow-requested(true); } }
            PanelSection { title: @tr("Hole at a point"); }
            PanelField { label: @tr("Hole point X"); unit: "mm"; value <=> root.drain-x-mm; }
            PanelField { label: @tr("Hole point Y"); unit: "mm"; value <=> root.drain-y-mm; }
            PanelField { label: @tr("Hole point Z"); unit: "mm"; value <=> root.drain-z-mm; }
            Button { text: @tr("Add hole at this point"); enabled: root.drain-x-mm != "" && root.drain-y-mm != "" && root.drain-z-mm != ""; clicked => { root.drain-at-point(); } }
            if root.drain-hole-rows.length > 0: PanelSection { title: @tr("Holes on this model ({})", root.drain-hole-rows.length); }
            for row[i] in root.drain-hole-rows: HorizontalLayout { height: 28px; spacing: 6px;
                Text { text: @tr("Hole {}", i + 1); color: ShellTheme.text; font-size: 13px; vertical-alignment: center; width: 52px; }
                Text { text: row; color: ShellTheme.muted; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                IconTool { width: 28px; height: 28px; tint: 2; icon: @image-url("icons/close.svg"); label: @tr("Remove hole {}", i + 1); clicked => { root.drain-hole-remove(i); } }
            }
            if root.drain-hole-rows.length > 1: Button { text: @tr("Remove all holes"); clicked => { root.drain-holes-clear(); } }
            if root.suction-cup-count > 0: Text { text: @tr("{n} suction cup: add drain holes to vent it." | "{n} suction cups: add drain holes to vent them." % root.suction-cup-count); color: ShellTheme.warning; wrap: word-wrap; font-size: 12px; }
        }
        }
    }
    if root.simplify-busy: Rectangle {
        x: root.settings-width + 14px; y: 570px; width: 280px; height: 100px;
        background: ShellTheme.panel; border-radius: ShellTheme.radius;
        VerticalLayout {
            padding: 10px; spacing: 8px;
            Text { text: @tr("Simplifying model..."); color: ShellTheme.text; }
            Rectangle {
                height: 8px; background: ShellTheme.border;
                Rectangle { width: parent.width * root.simplify-progress; background: ShellTheme.accent; }
            }
            Button { text: @tr("Cancel"); clicked => { root.model-tool-cancel(); } }
        }
    }
    if root.model-tools-active && root.section != WorkspaceSection.Slice: Rectangle {
        x: root.settings-width + 14px; y: 138px; width: 280px;
        height: model-tools-layout.preferred-height;
        background: ShellTheme.panel; border-radius: ShellTheme.radius;
        model-tools-layout := VerticalLayout {
            padding: 10px; spacing: 8px; alignment: start;
            HorizontalLayout {
                Text { text: @tr("Model tools"); color: ShellTheme.text; font-weight: 600; horizontal-stretch: 1; vertical-alignment: center; }
                Button { height: 32px; vertical-stretch: 0; text: @tr("Close"); clicked => { root.model-tools-active = false; } }
            }
            ComboBox { height: 32px; vertical-stretch: 0; model: [@tr("Cut"), @tr("Text label"), @tr("Boolean"), @tr("Simplify")]; current-index <=> root.model-tool-mode; }
            if root.model-tool-mode == 0: VerticalLayout {
                spacing: 6px; alignment: start; vertical-stretch: 0;
                CompactField { label: @tr("Cut height"); unit: "mm"; value <=> root.cut-z-mm; }
                ComboBox { height: 32px; vertical-stretch: 0; model: [@tr("Keep lower"), @tr("Keep upper"), @tr("Keep both")]; current-index <=> root.cut-keep; }
                CheckBox { min-height: 32px; vertical-stretch: 0; text: @tr("Close cut faces"); checked <=> root.cut-cap; }
                Text { min-height: 32px; vertical-stretch: 0; text: @tr("Drag the Z handle to move the cut plane."); color: ShellTheme.muted; wrap: word-wrap; }
                Button { height: 32px; vertical-stretch: 0; text: @tr("Cut"); clicked => { root.model-tool-requested(0); } }
            }
            if root.model-tool-mode == 1: VerticalLayout {
                spacing: 6px; alignment: start; vertical-stretch: 0;
                LineEdit { height: 32px; vertical-stretch: 0; text <=> root.label-text; }
                CompactField { label: @tr("Font size"); unit: "mm"; value <=> root.label-size-mm; }
                CompactField { label: @tr("Label depth"); unit: "mm"; value <=> root.label-depth-mm; }
                CheckBox { min-height: 32px; vertical-stretch: 0; text: @tr("Engrave"); checked <=> root.label-engrave; }
                Text { min-height: 32px; vertical-stretch: 0; text: @tr("Click a model face to place the ASCII label."); color: ShellTheme.muted; wrap: word-wrap; }
            }
            if root.model-tool-mode == 2: VerticalLayout {
                spacing: 6px; alignment: start; vertical-stretch: 0;
                ComboBox { height: 32px; vertical-stretch: 0; model: [@tr("Union"), @tr("Subtract"), @tr("Intersect")]; current-index <=> root.boolean-operation; }
                Text { min-height: 40px; vertical-stretch: 0; text: @tr("Select two models. Subtract removes the second selected model from the first."); color: ShellTheme.muted; wrap: word-wrap; }
                Button { height: 32px; vertical-stretch: 0; text: @tr("Apply Boolean"); clicked => { root.model-tool-requested(2); } }
            }
            if root.model-tool-mode == 3: VerticalLayout {
                spacing: 6px; alignment: start; vertical-stretch: 0;
                CompactField { label: @tr("Target triangles"); value <=> root.simplify-target; }
                CheckBox { min-height: 32px; vertical-stretch: 0; text: @tr("Target is a percentage"); checked <=> root.simplify-percentage; }
                CompactField { label: @tr("Maximum deviation"); unit: "mm"; value <=> root.simplify-deviation; }
                Text { min-height: 60px; vertical-stretch: 0; text: @tr("Boundary and feature edges are preserved. The deviation limit may prevent reaching the target."); color: ShellTheme.muted; wrap: word-wrap; }
                Button { height: 32px; vertical-stretch: 0; text: @tr("Simplify"); enabled: !root.simplify-busy; clicked => { root.model-tool-requested(3); } }
            }
            Button { height: 32px; vertical-stretch: 0; text: @tr("Split into parts"); clicked => { root.model-tool-requested(1); } }
            if root.model-tool-error != "": Text { vertical-stretch: 0; text: root.model-tool-error; color: ShellTheme.warning; wrap: word-wrap; }
        }
    }
    // Prepare's tool strip: Repair, under the section switcher and styled
    // like it, neither movable nor saved. It stays on for a healthy scene:
    // Repair then says "no problems found", clearer than a dead button.
    if root.scene-present && root.section == WorkspaceSection.Prepare: Rectangle {
        // Centred under the section switcher.
        width: repair-button.preferred-width + 16px;
        height: repair-button.preferred-height + 16px;
        x: (parent.width - self.width) / 2;
        y: 132px;
        background: ShellTheme.panel;
        border-color: ShellTheme.border;
        border-width: 1px;
        border-radius: 8px;
        drop-shadow-color: ShellTheme.shadow;
        drop-shadow-blur: 8px;

        repair-button := Button {
            x: 8px;
            y: 8px;
            text: @tr("Prepare" => "Repair meshes");
            // Not while anything else is working on the scene.
            enabled: !(root.busy-opening || root.slicing || root.repairing);
            clicked => {
                root.section-picked(WorkspaceSection.Prepare);
                root.repair-models();
            }
        }
    }

    // Transform-section tool surface: numeric Position (mm) entry for
    // the selected object. Same fixed-below-the-pill placement as the
    // Prepare section's "Repair meshes" pill above; the two sections
    // are mutually exclusive so there is never a layout conflict.
    // Hidden without a selection, since there is then nothing to show
    // or edit a position for.

    // The layer slider along the 3D view's right edge: there whenever Slice
    // is open (so its strip shows before slicing too), off until a slice
    // exists. Its value is the layer shown, the top layer at the top.
    if root.section == WorkspaceSection.Slice: Rectangle {
        x: parent.width - 338px;
        y: 124px;
        width: 40px;
        height: parent.height - 210px;

        property <length> track-height: self.height - 24px;
        Rectangle { x: 18px; y: 12px; width: 4px; height: parent.track-height; background: ShellTheme.border; border-radius: 2px; }
        for area[index] in root.layer-areas: Rectangle {
            x: -24px;
            y: 12px + (1 - index / Math.max(1, root.layer-total - 1)) * parent.track-height;
            width: 22px * area;
            height: Math.max(1px, parent.track-height / Math.max(1, root.layer-total - 1));
            background: ShellTheme.accent.transparentize(0.35);
        }
        // Island markers: a short red tick across the track at each layer
        // with an unsupported island, on the same scale as the area graph.
        for layer in root.island-layers: Rectangle {
            x: 12px;
            width: 16px;
            height: 2px;
            y: 12px + (1 - layer / Math.max(1, root.layer-total - 1)) * parent.track-height - 1px;
            background: ShellTheme.error;
        }
        Text { y: -24px; text: "" + root.layer-total; color: ShellTheme.muted; }
        Text { y: parent.height + 8px; text: "1"; color: ShellTheme.muted; }
        Rectangle {
            x: -144px; width: 136px; height: 28px;
            y: (1 - root.layer-shown / Math.max(1, root.layer-total - 1)) * parent.track-height - 2px;
            border-radius: ShellTheme.radius; background: ShellTheme.field;
            Text { text: @tr("{} | {}", root.layer-shown + 1, root.layer-z-text); color: ShellTheme.text; horizontal-alignment: center; vertical-alignment: center; }
        }
        Rectangle {
            x: 6px; width: 28px; height: 24px; border-radius: ShellTheme.radius;
            y: (1 - root.layer-shown / Math.max(1, root.layer-total - 1)) * parent.track-height;
            background: ShellTheme.accent;
        }
        TouchArea {
            mouse-cursor: ns-resize;
            pointer-event(e) => { if e.kind == PointerEventKind.down { root.layer-shown = round(Math.max(0, Math.min(1, 1 - (self.mouse-y - 12px) / parent.track-height)) * Math.max(0,root.layer-total - 1)); root.layer-picked(); } }
            moved => { if self.pressed { root.layer-shown = round(Math.max(0, Math.min(1, 1 - (self.mouse-y - 12px) / parent.track-height)) * Math.max(0,root.layer-total - 1)); root.layer-picked(); } }
            // Wheel over the slider steps one layer (Shift: ten).
            scroll-event(e) => {
                if e.delta-y == 0 { return reject; }
                root.step-layer((e.delta-y > 0 ? 1 : -1) * (e.modifiers.shift ? 10 : 1));
                accept
            }
        }
        LayerStepButton { x: 6px; y: -58px; up: true; clicked => { root.step-layer(1); } }
        LayerStepButton { x: 6px; y: parent.height + 30px; up: false; clicked => { root.step-layer(-1); } }
    }

    // The compact layout's menu button, top left: the same menus as the
    // hidden bar, calling the same callbacks. Its items show no shortcuts,
    // since Slint registers accelerators on menu bar items only, and the
    // hidden bar keeps them working. Never used on macOS.
    if root.menu-style == MenuLayout.Compact: compact-menu := ContextMenuArea {
        // Level with the section switcher's row, in the top-left corner.
        x: 6px;
        y: 6px;
        width: menu-button.width;
        height: menu-button.height;

        Menu {
            Menu {
                title: @tr("MenuBar" => "File");
                MenuItem { title: @tr("MenuBar" => "Open…"); enabled: !root.busy-opening; activated => { root.open-file(); } }
                Menu {
                    title: @tr("MenuBar" => "Open Recent");
                    enabled: root.recent-files.length > 0 && !root.busy-opening;
                    for path[idx] in root.recent-files: MenuItem { title: path; activated => { root.open-recent-requested(idx); } }
                }
                MenuItem { title: @tr("MenuBar" => "New Window"); activated => { root.open-new-window(); } }
                MenuSeparator {}
                MenuItem { title: @tr("MenuBar" => "Save"); enabled: root.scene-present && !root.busy-opening && !root.saving; activated => { root.run-save(0); } }
                MenuItem { title: @tr("MenuBar" => "Save As…"); enabled: root.scene-present && !root.busy-opening && !root.saving; activated => { root.run-save(1); } }
                MenuItem { title: @tr("MenuBar" => "Export As…"); enabled: root.scene-present && !root.busy-opening && !root.saving; activated => { root.run-save(2); } }
                MenuItem { title: @tr("MenuBar" => "Close"); enabled: root.busy-opening || root.scene-present; activated => { root.close-scene(); } }
                MenuSeparator {}
                MenuItem { title: @tr("MenuBar" => "Slice Plate"); enabled: root.scene-present && !root.busy-opening && !root.slicing; activated => { root.run-slice(); } }
                MenuItem { title: @tr("MenuBar" => "Export Printer Job (ZIP)…"); enabled: root.slice-export-ready; activated => { root.export-slice(0); } }
                MenuItem { title: @tr("MenuBar" => "Export Sliced File (SVG)…"); enabled: root.slice-export-ready; activated => { root.export-slice(1); } }
                MenuItem { title: @tr("MenuBar" => "Export Sliced Layers (PNG)…"); enabled: root.slice-export-ready; activated => { root.export-slice(2); } }
                MenuSeparator {}
                MenuItem { title: @tr("Recipes..."); enabled: !root.busy-opening && !root.slicing; activated => { root.open-planner(false); } }
                MenuItem { title: @tr("Batch prepare..."); enabled: !root.busy-opening && !root.slicing; activated => { root.open-planner(true); } }
                MenuItem { title: @tr("Print history..."); activated => { root.hub-page = 2; root.hub-page-opened(2); } }
            }
            Menu {
                title: @tr("MenuBar" => "Edit");
                MenuItem { title: @tr("MenuBar" => "Undo"); enabled: root.scene-present && !root.busy-opening && root.may-undo; activated => { root.run-history(false); } }
                MenuItem { title: @tr("MenuBar" => "Redo"); enabled: root.scene-present && !root.busy-opening && root.may-redo; activated => { root.run-history(true); } }
                MenuSeparator {}
                MenuItem { title: @tr("MenuBar" => "Duplicate"); enabled: root.scene-present && !root.busy-opening && root.may-edit-selection; activated => { root.run-on-selection(false); } }
                MenuItem { title: @tr("MenuBar" => "Delete"); enabled: root.scene-present && !root.busy-opening && root.may-edit-selection; activated => { root.run-on-selection(true); } }
                MenuSeparator {}
                MenuItem { title: @tr("MenuBar" => "Preferences"); activated => { root.show-preferences(); } }
            }
            Menu {
                title: @tr("MenuBar" => "View");
                MenuItem { title: root.perspective-view ? @tr("MenuBar" => "Orthographic View (5)") : @tr("MenuBar" => "Perspective View (5)"); activated => { root.toggle-projection(); } }
                MenuItem { title: root.parts-panel-shown ? @tr("MenuBar" => "Hide Object List") : @tr("MenuBar" => "Show Object List"); enabled: root.scene-present; activated => { root.toggle-object-list(); } }
                MenuItem { title: root.layer-view-shown ? @tr("MenuBar" => "Hide Slice View") : @tr("MenuBar" => "Show Slice View"); enabled: root.scene-present; activated => { root.toggle-slice-view(); } }
                MenuSeparator {}
                MenuItem { title: root.menu-style == MenuLayout.Compact ? @tr("MenuBar" => "Show Menu Bar") : @tr("MenuBar" => "Hide Menu Bar"); enabled: !root.on-macos; activated => { root.switch-menu-layout(); } }
                MenuItem { title: @tr("MenuBar" => "Fullscreen"); checkable: true; checked <=> root.full-screen; }
            }
            Menu {
                title: @tr("Calibration");
                MenuItem { title: @tr("All calibration tools..."); activated => { root.calibration-menu-open = true; } }
                MenuItem { title: @tr("Exposure test..."); enabled: !root.slicing; activated => { root.open-calibration-tool(0); } }
                MenuItem { title: @tr("Overhang test..."); enabled: !root.slicing; activated => { root.open-calibration-tool(1); } }
                MenuItem { title: @tr("LCD orientation..."); enabled: !root.slicing; activated => { root.open-calibration-tool(2); } }
                MenuItem { title: @tr("XY scale..."); enabled: !root.slicing; activated => { root.open-calibration-tool(3); } }
                MenuItem { title: @tr("Z check..."); enabled: !root.slicing; activated => { root.open-calibration-tool(4); } }
                MenuItem { title: @tr("Time estimate from a print log..."); enabled: !root.slicing; activated => { root.open-calibration-tool(5); } }
            }
            Menu {
                title: @tr("MenuBar" => "Help");
                MenuItem { title: @tr("MenuBar" => "Keyboard Shortcuts"); activated => { root.show-shortcuts-requested(); } }
                MenuItem { title: @tr("MenuBar" => "Setup Wizard..."); activated => { root.show-setup-requested(); } }
                MenuSeparator {}
                MenuItem { title: @tr("MenuBar" => "About"); activated => { root.show-about(); } }
            }
        }

        menu-button := Rectangle {
            width: 34px;
            height: 30px;
            border-radius: ShellTheme.radius;
            background: compact-touch.has-hover ? ShellTheme.field : ShellTheme.scrim;
            accessible-role: button;
            accessible-label: @tr("Menu");
            accessible-action-default => { compact-menu.show({ x: 0, y: menu-button.height }); }

            Image {
                source: @image-url("icons/menu.svg");
                colorize: ShellTheme.text;
                width: 18px;
                height: 18px;
            }

            // Opens the menus just under the button.
            compact-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { compact-menu.show({ x: 0, y: menu-button.height }); }
            }
        }
    }

    // Place on face's hint: what to do, or why a model has no side to
    // stand on. Hidden in Slice.
    if root.place-face-tool-active && root.section != WorkspaceSection.Slice: Rectangle {
        x: root.settings-width + 16px; y: 120px; width: Math.min(650px, root.width - root.settings-width - 316px); height: 54px;
        background: ShellTheme.panel; border-radius: ShellTheme.radius;
        border-width: 1px; border-color: ShellTheme.border;
        Text { x: 10px; width: parent.width - 20px; height: parent.height; vertical-alignment: center;
            wrap: word-wrap; color: ShellTheme.text;
            text: root.place-face-count < 0 ? @tr("Place on face: select a model.")
                : root.place-face-count == 0 ? @tr("Place on face: this model has no flat side it can stand on.")
                : @tr("Place on face: click a highlighted side to put it on the plate. Esc exits.");
        }
    }

    if root.measure-tool-active && root.section != WorkspaceSection.Slice: Rectangle {
        x: root.settings-width + 16px; y: 120px; width: Math.min(650px, root.width - root.settings-width - 316px); height: 54px;
        background: ShellTheme.panel; border-radius: ShellTheme.radius;
        border-width: 1px; border-color: ShellTheme.border;
        Text { x: 10px; width: parent.width - 20px; height: parent.height; vertical-alignment: center;
            wrap: word-wrap; color: ShellTheme.text;
            text: root.measure-text == "" ? @tr("Measure: click two model points. Esc clears.") : root.measure-text;
        }
    }

    if mv.context-visible: CanvasMenuOverlay {
        x: root.settings-width; y: 68px;
        width: root.width - root.settings-width - root.right-panel-space;
        height: root.height - 108px;
        context-anchor-x: mv.context-anchor-x; context-anchor-y: mv.context-anchor-y;
        context-entries: mv.context-entries; context-index: mv.context-index;
        context-mirror: mv.context-mirror;
        context-plates: mv.context-plates;
        plate-ids: root.plate-ids;
        activate-context(action) => { mv.activate-context(action); }
        dismiss-context => { mv.dismiss-context(); }
    }

    // Home / Device / Project pages cover the workspace (settings, canvas,
    // object panel); the TouchArea keeps clicks from reaching the canvas.
    if root.hub-page != 0: Rectangle {
        x: 0px; y: 68px; width: root.width; height: root.height - 108px;
        background: ShellTheme.background;
        TouchArea {}
        if root.hub-page == 1: HomePage {
            recent: root.home-recent;
            printer-name: root.printer-choice >= 0 ? root.printer-choices[root.printer-choice] : "";
            resin-name: root.resin-choice >= 0 ? root.resin-choices[root.resin-choice] : "";
            printer-picture: root.printer-picture;
            resin-picture: root.resin-picture;
            change-printer => { root.chooser-open-requested(1); }
            change-resin => { root.chooser-open-requested(2); }
            setup-wizard => { root.show-setup-requested(); }
            new-project => { root.new-project-requested(); }
            open-project => { root.hub-page = 0; root.open-file(); }
            open-recent(i) => { root.hub-page = 0; root.open-recent-requested(i); }
            remove-recent(i) => { root.remove-recent-requested(i); }
        }
        if root.hub-page == 2: DevicePage {
            printer-name: root.device-printer-name;
            printer-model: root.device-printer-model;
            build-volume: root.device-build-volume;
            resolution: root.device-resolution;
            output: root.device-output;
            material-name: root.device-material;
            drives: root.device-drives;
            export-ready: root.slice-export-ready && !root.slicing;
            export-format <=> root.export-format;
            post-export-command <=> root.post-export-command;
            history: root.print-history;
            estimate-correction: root.estimate-correction;
            printer-picture: root.printer-picture;
            print-time: root.estimated-print-time-text;
            can-slice: root.scene-present && !root.busy-opening && !root.slicing;
            slicing: root.slicing;
            slice-now => { root.start-slice(); }
            edit-printer => { root.profile-edit-requested(true); }
            calibration-tools => { root.calibration-menu-open = true; }
            refresh-drives => { root.refresh-drives-requested(); }
            export-to-drive(i) => { root.export-to-drive-requested(i); }
            post-export-command-edited(t) => { root.post-export-command-edited(t); }
            history-outcome(i, o) => { root.history-outcome-changed(i, o); }
            history-failed-layer(i, t) => { root.history-failed-layer-changed(i, t); }
            calibrate-estimate => { root.calibrate-estimate-requested(); }
            reset-estimate => { root.reset-estimate-requested(); }
        }
        if root.hub-page == 3: ProjectPage {
            project-name: root.project-name;
            project-path: root.project-path;
            dirty: root.project-dirty;
            plates: root.project-plates;
            totals: root.project-totals;
            has-scene: root.scene-present;
            save => { root.save-project(); }
            save-as => { root.save-project-as(); }
            slice-all => { root.slice-all-requested(); }
            export-all => { root.export-all-requested(); }
            open-plate(i) => { root.plate-selected(root.plate-ids[i]); root.hub-page = 0; root.section-picked(WorkspaceSection.Transform); }
        }
    }
    if root.recipes-visible: Rectangle {
        width: 100%; height: 100%; background: ShellTheme.scrim;
        TouchArea {}
        Rectangle {
            x: (parent.width - self.width) / 2; y: 76px;
            width: Math.min(900px, parent.width - 40px); height: parent.height - 100px;
            background: ShellTheme.panel; border-width: 1px; border-color: ShellTheme.border; border-radius: ShellTheme.radius;
            VerticalLayout { padding: 16px; spacing: 8px;
                Text { text: @tr("Recipes"); font-size: 20px; color: ShellTheme.text; height: 28px; }
                HorizontalLayout { height: 32px; vertical-stretch: 0;
                    ComboBox { model: root.recipe-names; current-index <=> root.recipe-index; enabled: !root.recipe-busy; selected(index) => { root.recipe-selected(self.current-index); } horizontal-stretch: 1; }
                    Button { text: @tr("Save"); enabled: !root.recipe-busy; clicked => { root.recipe-edit(6); } }
                    Button { text: @tr("Save copy"); enabled: !root.recipe-busy; clicked => { root.recipe-edit(0); } }
                    Button { text: @tr("Delete saved"); enabled: !root.recipe-busy; clicked => { root.recipe-edit(1); } }
                }
                CheckBox { text: @tr("Edit as TOML"); checked <=> root.recipe-advanced; toggled => { if !self.checked { root.recipe-sync-form(); } } }
                HorizontalLayout { height: 32px; vertical-stretch: 0;
                    ComboBox { model: [@tr("Scale"), @tr("Auto orient"), @tr("Hollow"), @tr("Drain holes"), @tr("Supports"), @tr("Arrange"), @tr("Slice"), @tr("Export")]; current-index <=> root.recipe-step-kind; enabled: !root.recipe-busy; }
                    Button { text: @tr("Add step"); enabled: !root.recipe-busy; clicked => { root.recipe-edit(2); } }
                    Button { text: @tr("Up"); enabled: !root.recipe-busy && root.recipe-step-index > 0; clicked => { root.recipe-edit(3); } }
                    Button { text: @tr("Down"); enabled: !root.recipe-busy && root.recipe-step-index + 1 < root.recipe-steps.length; clicked => { root.recipe-edit(4); } }
                    Button { text: @tr("Remove step"); enabled: !root.recipe-busy && root.recipe-steps.length > 1; clicked => { root.recipe-edit(5); } }
                }
                HorizontalLayout { spacing: 12px;
                    if root.recipe-advanced: TextEdit { text <=> root.recipe-toml; read-only: root.recipe-busy; horizontal-stretch: 1; }
                    if !root.recipe-advanced: ScrollView { width: 230px;
                        VerticalLayout { spacing: 4px; alignment: start;
                            for step[index] in root.recipe-steps: Rectangle {
                                height: 38px; vertical-stretch: 0; border-radius: ShellTheme.radius;
                                background: index == root.recipe-step-index ? ShellTheme.field : transparent;
                                Text { x: 8px; width: parent.width - 16px; height: 100%; text: step; color: ShellTheme.text; vertical-alignment: center; }
                                TouchArea { enabled: !root.recipe-busy; clicked => { root.recipe-select-step(index); } }
                            }
                        }
                    }
                    if !root.recipe-advanced: ScrollView { horizontal-stretch: 1;
                        VerticalLayout { spacing: 4px; alignment: start;
                            for field in root.recipe-fields: HorizontalLayout {
                                height: 36px; vertical-stretch: 0;
                                if field.kind == 0: SettingField {
                                    horizontal-stretch: 1;
                                    setting: {id: 0, label: field.label, value: field.value, units: "", modified: false, level: 0, help: field.label, minimum: field.key == "count" ? 1 : 0, maximum: field.key == "count" ? 64 : 100000, step: field.key == "count" ? 1 : 0.1};
                                    edited(id, value) => { root.recipe-field-edit(field.key, value); }
                                }
                                if field.kind == 1: CheckBox { text: field.label; checked: field.value == "true"; enabled: !root.recipe-busy; toggled => { root.recipe-field-edit(field.key, self.checked ? "true" : "false"); } }
                                if field.kind >= 2: Text { text: field.label; color: ShellTheme.text; width: 45%; vertical-alignment: center; }
                                if field.kind == 2: LineEdit { text: field.value; enabled: !root.recipe-busy; accepted(value) => { root.recipe-field-edit(field.key, value); } horizontal-stretch: 1; }
                                if field.kind == 3: ComboBox { model: field.choices; current-value: field.value; enabled: !root.recipe-busy; selected(index) => { root.recipe-field-edit(field.key, self.current-value); } horizontal-stretch: 1; }
                            }
                            if root.recipe-fields.length == 0: Text { text: @tr("This step uses the current printer and process settings."); color: ShellTheme.muted; wrap: word-wrap; }
                        }
                    }
                }
                if root.recipe-busy: ScrollView { height: 100px; vertical-stretch: 0;
                        VerticalLayout { spacing: 4px; alignment: start;
                            for status in root.recipe-progress: Text { text: status; wrap: word-wrap; color: ShellTheme.text; min-height: 32px; vertical-stretch: 0; }
                        }
                    }
                Text { text: root.recipe-summary; wrap: word-wrap; color: ShellTheme.text; min-height: 48px; max-height: 96px; overflow: elide; }
                HorizontalLayout { height: 32px; vertical-stretch: 0;
                    ComboBox { model: [@tr("Selection"), @tr("Active plate"), @tr("All plates")]; current-index <=> root.recipe-scope; enabled: !root.recipe-busy; }
                    Button { text: root.recipe-busy ? @tr("Cancel") : @tr("Close"); clicked => { root.recipe-cancel(); } }
                    PrimaryButton { text: @tr("Run recipe"); enabled: !root.recipe-busy && root.scene-present && !root.slicing; clicked => { root.recipe-run(); } }
                }
            }
        }
    }
    if root.batch-visible: Rectangle {
        width: 100%; height: 100%; background: ShellTheme.panel.transparentize(0.2);
        TouchArea { }
        Rectangle {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: 540px; height: 430px;
            background: ShellTheme.panel; border-color: ShellTheme.border; border-width: 1px; border-radius: ShellTheme.radius;
            VerticalLayout { padding: 20px; spacing: 8px;
                Text { text: @tr("Batch prepare"); font-size: 20px; color: ShellTheme.text; }
                Text { text: root.batch-use-recipe ? @tr("Runs the selected recipe in order for every file.") : @tr("Uses the current orientation, support and hollow settings."); color: ShellTheme.muted; wrap: word-wrap; }
                HorizontalLayout {
                    Button { text: @tr("Choose files..."); enabled: !root.batch-busy; clicked => { root.batch-choose-files(); } }
                    Button { text: @tr("Choose folder..."); enabled: !root.batch-busy; clicked => { root.batch-choose-folder(); } }
                }
                HorizontalLayout { height: 32px; vertical-stretch: 0;
                    CheckBox { text: @tr("Recipe per file"); checked <=> root.batch-use-recipe; enabled: !root.batch-busy; }
                    ComboBox { model: root.recipe-names; current-index <=> root.recipe-index; enabled: !root.batch-busy; selected(_) => { root.recipe-selected(self.current-index); } }
                }
                CheckBox { text: @tr("Auto orient"); checked <=> root.batch-orient; enabled: !root.batch-busy; }
                CheckBox { text: @tr("Auto supports"); checked <=> root.batch-supports; enabled: !root.batch-busy; }
                CheckBox { text: @tr("Hollow"); checked <=> root.batch-hollow; enabled: !root.batch-busy; }
                HorizontalLayout {
                    CheckBox { text: @tr("Slice all"); checked <=> root.batch-slice; enabled: !root.batch-busy; }
                    CheckBox { text: @tr("Export all"); checked <=> root.batch-export; enabled: !root.batch-busy; }
                }
                Text { text: root.batch-summary; color: ShellTheme.text; wrap: word-wrap; vertical-stretch: 1; overflow: elide; }
                HorizontalLayout {
                    Button { text: root.batch-busy ? @tr("Cancel") : @tr("Close"); clicked => { root.batch-cancel(); } }
                    PrimaryButton { text: @tr("Prepare"); enabled: !root.batch-busy; clicked => { root.batch-start(); } }
                }
            }
        }
    }
    // Shown while a file is dragged over the window.
    if root.file-over-window: DropOverlay { }

    // The load panel, bottom centre, while a file is being read. It has no
    // click area of its own, so clicks reach the 3D view under it.
    if root.opening: ProgressCard {
        area-width: parent.width;
        area-height: parent.height;
        progress: root.open-fraction;
        text: root.open-step == OpenStep.Uploading ? @tr("Uploading to GPU…")
            : root.open-step == OpenStep.Meshing ? @tr("Preparing geometry…")
            : @tr("Reading file…");
    }

    // Unit-conversion banner over the viewport (Prepare only).
    if root.units-hint-visible && root.section != WorkspaceSection.Slice: Rectangle {
        width: Math.min(parent.width - root.settings-width - root.right-panel-space - 96px, 640px);
        height: units-hint-layout.preferred-height;
        x: root.settings-width + (parent.width - root.settings-width - 340px - self.width) / 2;
        y: 76px;
        background: ShellTheme.panel;
        border-color: ShellTheme.warning;
        border-width: 1px;
        border-radius: ShellTheme.radius;
        drop-shadow-blur: 8px;
        drop-shadow-color: ShellTheme.shadow;
        units-hint-layout := HorizontalLayout {
            padding: 10px;
            spacing: 8px;
            Text { text: root.units-hint-text; color: ShellTheme.text; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
            Button { text: @tr("Inches (x25.4)"); clicked => { root.units-conversion-requested(25.4); } }
            Button { text: @tr("Meters (x1000)"); clicked => { root.units-conversion-requested(1000); } }
            Button { text: @tr("Dismiss"); clicked => { root.units-hint-visible = false; } }
        }
    }

    // Support notice over the viewport: a part needs no supports.
    if root.support-notice-text != "" && root.section != WorkspaceSection.Slice: Rectangle {
        // Narrower than the units banner: clear of the view toolbar at the right.
        width: Math.min(parent.width - root.settings-width - 420px, 560px);
        height: support-notice-layout.preferred-height;
        x: root.settings-width + (parent.width - root.settings-width - 340px - self.width) / 2;
        y: root.units-hint-visible ? 140px : 76px;
        background: ShellTheme.panel;
        border-color: ShellTheme.accent;
        border-width: 1px;
        border-radius: ShellTheme.radius;
        drop-shadow-blur: 8px;
        drop-shadow-color: ShellTheme.shadow;
        support-notice-layout := HorizontalLayout {
            padding: 10px;
            spacing: 8px;
            VerticalLayout { alignment: center; Image { source: @image-url("icons/check.svg"); colorize: ShellTheme.accent; width: 18px; height: 18px; } }
            Text { text: root.support-notice-text; color: ShellTheme.text; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
            Button { text: @tr("OK"); clicked => { root.support-notice-text = ""; } }
        }
    }

    // The support generator's panel, placed like the load panel. Its phase
    // is Rust's `JobProgress.phase` text as it is: it is only shown.
    if root.making-supports: ProgressCard {
        area-width: parent.width;
        area-height: parent.height;
        progress: root.supports-fraction;
        text: root.supports-step != "" ? root.supports-step : @tr("Generating support structure…");
    }

    // The save panel, where the load panel goes (the two never run at once:
    // each turns the other off). No click area, so clicks pass through.
    if root.saving: ProgressCard {
        area-width: parent.width;
        area-height: parent.height;
        progress: root.save-fraction;
        text: root.save-step == WriteStep.Writing ? @tr("Writing file…")
            : root.save-step == WriteStep.Compressing ? @tr("Compressing…")
            : root.save-step == WriteStep.Serializing ? @tr("Serializing model…")
            : @tr("Preparing geometry…");
    }

    // Slicing locks the window behind a progress card.
    if root.slicing: SliceModal {
        plate-label: root.slice-plate-label;
        layers-done: root.layers-done;
        layers-planned: root.layers-planned;
        fraction: root.slice-fraction;
        cancel => { root.cancel-slice(); }
    }
    if root.recovery-prompt: Rectangle {
        width: parent.width; height: parent.height; background: ShellTheme.modal-scrim;
        TouchArea {}
        Rectangle {
            width: 430px; height: 180px; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2;
            background: ShellTheme.panel; border-radius: ShellTheme.radius;
            VerticalLayout {
                padding: 20px; spacing: 12px;
                Text { text: @tr("Restore unsaved work?"); font-size: 20px; color: ShellTheme.text; }
                Text { text: @tr("Recovery snapshots were found from a previous session."); wrap: word-wrap; color: ShellTheme.muted; }
                HorizontalLayout {
                    Button { text: @tr("Discard"); clicked => { root.recovery-choice(false); } }
                    PrimaryButton { text: @tr("Restore"); clicked => { root.recovery-choice(true); } }
                }
            }
        }
    }

    if root.drop-project-prompt: Rectangle {
        background: ShellTheme.viewport.transparentize(0.2);
        Rectangle {
            width: 440px; height: 160px; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2;
            background: ShellTheme.panel; border-radius: ShellTheme.radius;
            VerticalLayout {
                padding: 16px; spacing: 12px;
                Text { text: @tr("How would you like to open the 3MF?"); color: ShellTheme.text; wrap: word-wrap; }
                HorizontalLayout { spacing: 8px;
                    PrimaryButton { text: @tr("Open as project"); clicked => { root.drop-project-choice(true); } }
                    Button { text: @tr("Import geometry"); clicked => { root.drop-project-choice(false); } }
                    Button { text: @tr("Cancel"); clicked => { root.drop-project-prompt = false; } }
                }
            }
        }
    }



    if root.plate-editor-open: Rectangle {
        width: parent.width; height: parent.height; background: ShellTheme.modal-scrim;
        TouchArea {}
        Rectangle {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: 400px; height: 248px; background: ShellTheme.panel;
            border-radius: ShellTheme.radius;
            VerticalLayout { padding: 24px; spacing: 16px;
                Text { text: @tr("Plate settings"); color: ShellTheme.text; font-size: 18px; font-weight: 600; }
                HorizontalLayout { spacing: 8px;
                    Text { text: @tr("Name"); width: 72px; color: ShellTheme.text; vertical-alignment: center; }
                    LineEdit { accessible-label: @tr("Plate name"); text <=> root.plate-display-name; placeholder-text: @tr("Plate {}", root.active-plate-id); }
                }
                CheckBox { text: @tr("Lock plate"); checked <=> root.plate-editor-locked; }
                HorizontalLayout { spacing: 8px;
                    Button { text: @tr("Cancel"); clicked => { root.plate-editor-open = false; } }
                    PrimaryButton { text: @tr("Apply"); clicked => { root.plate-renamed(root.plate-display-name); root.plate-locked = root.plate-editor-locked; root.plate-editor-open = false; } }
                }
            }
        }
    }
    if root.calibration-open: Rectangle {
        x:0px; y:0px; width:parent.width; height:parent.height; background:ShellTheme.scrim;
        TouchArea {}
        Rectangle { x:(parent.width - self.width)/2; y:(parent.height - self.height)/2; width:520px; height:calibration-layout.preferred-height;
            background:ShellTheme.panel; border-color:ShellTheme.border; border-width:1px; border-radius:ShellTheme.radius;
            calibration-layout := VerticalLayout {padding:20px; spacing:10px;
                Text {text:@tr("Calibration > Exposure test");color:ShellTheme.text;font-size:18px;font-weight:600;}
                Text {text:@tr("Print these tiles together, wash and dry them, then compare the smallest intact pins, open holes, readable text and bridge. Choose the exposure with clean details and strong features. Each tile receives its own exposure; export as PNG + run.gcode (G-code ZIP).");color:ShellTheme.muted;wrap:word-wrap;}
                HorizontalLayout { Text {text:@tr("Tiles (2-8)");color:ShellTheme.text;vertical-alignment:center;horizontal-stretch:1;} LineEdit {width:140px;text<=>root.calibration-count;} }
                HorizontalLayout { Text {text:@tr("Start exposure (s)");color:ShellTheme.text;vertical-alignment:center;horizontal-stretch:1;} LineEdit {width:140px;text<=>root.calibration-start;} }
                HorizontalLayout { Text {text:@tr("Step (s)");color:ShellTheme.text;vertical-alignment:center;horizontal-stretch:1;} LineEdit {width:140px;text<=>root.calibration-step;} }
                HorizontalLayout { Text {text:@tr("Or exposure list (s)");color:ShellTheme.text;vertical-alignment:center;horizontal-stretch:1;} LineEdit {width:230px;text<=>root.calibration-list;placeholder-text:"1.5, 2.0, 2.5, 3.0";} }
                HorizontalLayout { alignment: start; PrimaryButton {text:@tr("Place tiles on active plate");clicked=>{root.calibration-create();}} }
                Text {text:@tr("After printing, select the best tile and record its exposure in a new material profile.");color:ShellTheme.muted;wrap:word-wrap;}
                HorizontalLayout {spacing:8px; ComboBox {model:root.calibration-tiles;current-index<=>root.calibration-best;horizontal-stretch:1;} Button {text:@tr("Record result");enabled:root.calibration-tiles.length>0;clicked=>{root.calibration-record();}}}
                if root.calibration-message != "": Text {text:root.calibration-message;color:ShellTheme.accent;wrap:word-wrap;}
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout { alignment: end; Button {text:@tr("Close");clicked=>{root.calibration-open=false;}} }
            }
        }
    }

    if root.overhang-test-open: Rectangle {
        x:0px; y:0px; width:parent.width; height:parent.height; background:ShellTheme.scrim;
        TouchArea {}
        Rectangle { x:(parent.width - self.width)/2; y:(parent.height - self.height)/2; width:520px; height:overhang-layout.preferred-height;
            background:ShellTheme.panel; border-color:ShellTheme.border; border-width:1px; border-radius:ShellTheme.radius;
            overhang-layout := VerticalLayout {padding:20px; spacing:10px;
                Text {text:@tr("Calibration > Overhang test");color:ShellTheme.text;font-size:18px;font-weight:600;}
                Text {text:@tr("Measures how flat an overhang your resin holds without supports. The test has six ledges leaving a wall at 30 to 80 degrees from horizontal, each labelled with its angle. Print it without supports in the resin you want to measure, then find the flattest ledge that came out whole and smooth underneath.");color:ShellTheme.muted;wrap:word-wrap;}
                HorizontalLayout { alignment: start; PrimaryButton {text:@tr("Place test on active plate");clicked=>{root.overhang-test-create();}} }
                Text {text:@tr("Flattest ledge that printed clean (the selected resin gets supports under anything flatter):");color:ShellTheme.muted;wrap:word-wrap;}
                HorizontalLayout {spacing:8px; ComboBox {model:["30\u{b0}","40\u{b0}","50\u{b0}","60\u{b0}","70\u{b0}","80\u{b0}"];current-index<=>root.overhang-test-best;horizontal-stretch:1;} Button {text:@tr("Save to resin");clicked=>{root.overhang-test-record(root.overhang-test-best);}}}
                if root.overhang-test-message != "": Text {text:root.overhang-test-message;color:ShellTheme.accent;wrap:word-wrap;}
                HorizontalLayout { alignment: end; Button {text:@tr("Close");clicked=>{root.overhang-test-open=false;root.overhang-test-message="";}} }
            }
        }
    }

    // The compact tool chooser also provides a captureable, keyboard-friendly menu.
    if root.calibration-menu-open: Rectangle {
        x:0px;y:0px;width:parent.width;height:parent.height;background:ShellTheme.scrim;TouchArea {}
        Rectangle {x:(parent.width - self.width)/2;y:100px;width:360px;height:290px;background:ShellTheme.panel;border-width:1px;border-color:ShellTheme.border;border-radius:ShellTheme.radius;
            VerticalLayout {padding:16px;spacing:8px;
                Text {text:@tr("Calibration");color:ShellTheme.text;font-size:18px;}
                Button {text:@tr("Exposure test...");clicked=>{root.calibration-menu-open=false;root.calibration-open=true;}}
                Button {text:@tr("Overhang test...");clicked=>{root.calibration-menu-open=false;root.overhang-test-open=true;}}
                Button {text:@tr("LCD orientation...");clicked=>{root.calibration-menu-open=false;root.machine-tool=0;}}
                Button {text:@tr("XY scale...");clicked=>{root.calibration-menu-open=false;root.machine-tool=1;}}
                Button {text:@tr("Z check...");clicked=>{root.calibration-menu-open=false;root.machine-tool=2;}}
                HorizontalLayout { alignment: end; padding-top: 4px; Button {text:@tr("Close");clicked=>{root.calibration-menu-open=false;}} }
            }
        }
    }
    if root.machine-tool >= 0: Rectangle {
        x:0px;y:0px;width:parent.width;height:parent.height;background:ShellTheme.scrim;TouchArea {}
        Rectangle {x:(parent.width - self.width)/2;y:(parent.height - self.height)/2;width:540px;height:machine-layout.preferred-height;background:ShellTheme.panel;border-width:1px;border-color:ShellTheme.border;border-radius:ShellTheme.radius;
            machine-layout := VerticalLayout {padding:20px;spacing:8px;
                Text {text:root.machine-tool==0 ? @tr("Calibration > LCD orientation") : root.machine-tool==1 ? @tr("Calibration > XY scale") : @tr("Calibration > Z check");color:ShellTheme.text;font-size:18px;font-weight:600;}
                Text {text:root.machine-tool==0 ? @tr("Display or print this single layer. FRONT is the printer front (-Y); compare all four labelled corners, the +X/+Y arrows and the 10 mm grid with the physical LCD. Choose mirror flags, then clockwise rotation of the exported image. Record result saves a clearly named printer copy; print again to confirm.") : root.machine-tool==1 ? @tr("Print the two 100 mm rulers, wash and dry them, then measure between the centres of the 0 and 100 mm ticks on each axis. Enter both measured lengths below. Record result multiplies the current axis correction by 100 / measured length and saves a new printer profile. Print again to verify the correction.") : @tr("Print this stepped tower directly on the plate. Wash and dry it, then measure from its base to each flat top: 5, 10, 15, 20 and 25 mm. Compare several steps to distinguish a base offset from a Z travel error. Adjust the motion controller steps per millimetre if needed; this check does not change Z motion settings.");color:ShellTheme.muted;wrap:word-wrap;}
                HorizontalLayout { alignment: start; PrimaryButton {text:@tr("Place test on empty active plate");clicked=>{root.machine-create();}} }
                if root.machine-tool==0: VerticalLayout {spacing:4px;
                    HorizontalLayout {height:28px;CheckBox {text:@tr("Mirror X");checked<=>root.machine-mirror-x;} CheckBox {text:@tr("Mirror Y");checked<=>root.machine-mirror-y;}}
                    HorizontalLayout {height:28px;Text {text:@tr("Orientation (clockwise)");color:ShellTheme.text;vertical-alignment:center;horizontal-stretch:1;} ComboBox {model:["0°","90°","180°","270°"];current-index<=>root.machine-rotation;width:140px;}}
                }
                if root.machine-tool==1: VerticalLayout {spacing:4px;
                    HorizontalLayout {height:28px;Text {text:@tr("Measured X (mm)");color:ShellTheme.text;vertical-alignment:center;horizontal-stretch:1;} LineEdit {width:140px;text<=>root.machine-measured-x;}}
                    HorizontalLayout {height:28px;Text {text:@tr("Measured Y (mm)");color:ShellTheme.text;vertical-alignment:center;horizontal-stretch:1;} LineEdit {width:140px;text<=>root.machine-measured-y;}}
                }
                if root.machine-tool!=2: HorizontalLayout { alignment: start; Button {text:@tr("Record result in new printer profile");clicked=>{root.machine-record();}} }
                if root.machine-message != "": Text {text:root.machine-message;color:ShellTheme.accent;wrap:word-wrap;}
                Rectangle {height:4px;}
                HorizontalLayout { alignment: end; Button {text:@tr("Close");clicked=>{root.machine-tool=-1;}} }
            }
        }
    }

    // First-run setup, over everything else.
    if root.setup-visible: SetupWizard {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        step <=> root.setup-step;
        theme-choice: root.setup-theme-choice;
        printer-groups: root.setup-printer-groups;
        resin-groups: root.setup-resin-groups;
        printer-picture: root.setup-printer-picture;
        resin-picture: root.setup-resin-picture;
        printer-name: root.setup-printer-name;
        resin-name: root.setup-resin-name;
        theme-picked(i) => { root.setup-theme-picked(i); }
        printer-search-edited(t) => { root.setup-printer-search(t); }
        resin-search-edited(t) => { root.setup-resin-search(t); }
        printer-clicked(i) => { root.setup-printer-clicked(i); }
        resin-clicked(i) => { root.setup-resin-clicked(i); }
        custom-printer => { root.setup-custom-printer(); }
        skip => { root.setup-skip(); }
        finish(open) => { root.setup-finish(open); }
    }

    // In-window confirmation: dimmed backdrop, a card with the question and
    // full-width-label buttons (Cancel, secondary, primary on the right).
    if root.confirm-visible: Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        background: #00000059;
        TouchArea {}
        confirm-focus := FocusScope {
            init => { self.focus(); }
            key-pressed(e) => {
                if e.text == Key.Escape { root.confirm-chosen(2); return accept; }
                if e.text == Key.Return { root.confirm-chosen(0); return accept; }
                reject
            }
        }
        Rectangle {
            width: 460px; height: confirm-layout.preferred-height;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            border-radius: 12px; background: ShellTheme.panel;
            border-width: 1px; border-color: ShellTheme.border;
            drop-shadow-blur: 24px; drop-shadow-offset-y: 8px; drop-shadow-color: #00000040;
            confirm-layout := VerticalLayout {
                padding: 24px; spacing: 10px;
                Text { text: root.confirm-title; color: ShellTheme.text; font-size: 17px; font-weight: 700; wrap: word-wrap; }
                Text { text: root.confirm-body; color: ShellTheme.muted; font-size: 13px; wrap: word-wrap; }
                Rectangle { height: 10px; }
                HorizontalLayout {
                    spacing: 10px; alignment: end;
                    Button { text: @tr("Cancel"); clicked => { root.confirm-chosen(2); } }
                    if root.confirm-secondary != "": Button { text: root.confirm-secondary; clicked => { root.confirm-chosen(1); } }
                    Rectangle {
                        height: 36px; width: confirm-primary-text.preferred-width + 32px;
                        border-radius: ShellTheme.radius;
                        accessible-role: button; accessible-label: root.confirm-primary;
                        accessible-action-default => { root.confirm-chosen(0); }
                        background: root.confirm-destructive
                            ? (primary-touch.has-hover ? #c92a2a : ShellTheme.error)
                            : (primary-touch.has-hover ? ShellTheme.accent-hover : ShellTheme.accent);
                        confirm-primary-text := Text { text: root.confirm-primary; color: #ffffff; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        primary-touch := TouchArea { mouse-cursor: pointer; clicked => { root.confirm-chosen(0); } }
                    }
                }
            }
        }
    }
    // Full-catalog chooser (R101): every printer or resin with its picture;
    // a click picks it and keeps it in the dropdown, the star only adds or
    // removes it from the dropdown.
    if root.chooser-kind > 0: Rectangle {
        x: 0px; y: 0px; width: root.width; height: root.height;
        background: #00000080;
        TouchArea { clicked => { root.chooser-kind = 0; } }
        chooser-panel := Rectangle {
            width: Math.min(560px, root.width - 48px); height: Math.min(680px, root.height - 80px);
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            background: ShellTheme.panel; border-radius: 10px; border-width: 1px; border-color: ShellTheme.border;
            drop-shadow-blur: 24px; drop-shadow-color: #00000060;
            TouchArea { }
            VerticalLayout {
                padding: 16px; spacing: 10px;
                HorizontalLayout { spacing: 8px;
                    Text { text: root.chooser-kind == 1 ? @tr("Choose a printer") : @tr("Choose a resin"); font-size: 16px; font-weight: 700; color: ShellTheme.text; vertical-alignment: center; horizontal-stretch: 1; }
                    IconTool { width: 30px; height: 30px; tint: -1; icon: @image-url("icons/close.svg"); label: @tr("Close"); clicked => { root.chooser-kind = 0; } }
                }
                Text { text: @tr("Click one to use it. The star keeps it in the dropdown."); color: ShellTheme.muted; font-size: 12px; wrap: word-wrap; }
                HorizontalLayout { spacing: 8px;
                    Image { source: @image-url("icons/search.svg"); width: 18px; colorize: ShellTheme.muted; }
                    LineEdit { placeholder-text: root.chooser-kind == 1 ? @tr("Search printers") : @tr("Search resins"); text <=> root.chooser-search; edited(t) => { root.chooser-search-edited(t); } }
                }
                HorizontalLayout { spacing: 12px; vertical-stretch: 1;
                ScrollView {
                    width: 150px;
                    viewport-width: self.width;
                    VerticalLayout { spacing: 2px; padding-right: 8px; alignment: start;
                        for brand[b] in root.chooser-brands: Rectangle {
                            height: 32px; border-radius: 6px;
                            accessible-role: tab; accessible-label: brand; accessible-item-selected: b == root.chooser-brand;
                            accessible-action-default => { root.chooser-brand-picked(b); }
                            background: b == root.chooser-brand ? ShellTheme.accent.transparentize(0.82) : brand-touch.has-hover ? ShellTheme.field : transparent;
                            brand-touch := TouchArea { mouse-cursor: pointer; clicked => { root.chooser-brand-picked(b); } }
                            Text { x: 10px; width: parent.width - 20px; height: parent.height; text: brand; color: ShellTheme.text; font-size: 13px; font-weight: b == root.chooser-brand ? 700 : 400; vertical-alignment: center; overflow: elide; }
                        }
                    }
                }
                ScrollView {
                    horizontal-stretch: 1;
                    viewport-width: self.width;
                    VerticalLayout { spacing: 4px; padding-right: 12px; alignment: start;
                        for row[i] in root.chooser-rows: Rectangle {
                            height: row.heading != "" ? 30px : 64px; border-radius: 8px;
                            if row.heading != "": Text { x: 4px; y: parent.height - self.height - 2px; text: row.heading; color: ShellTheme.muted; font-size: 12px; font-weight: 700; accessible-role: text; }
                            if row.heading == "": Rectangle {
                            width: parent.width; height: parent.height; border-radius: 8px;
                            accessible-role: button; accessible-label: row.label;
                            accessible-action-default => { root.chooser-picked(i); }
                            background: row.current ? ShellTheme.accent.transparentize(0.82) : row-touch.has-hover ? ShellTheme.field : transparent;
                            border-width: row.current ? 1px : 0px; border-color: ShellTheme.accent;
                            row-touch := TouchArea { mouse-cursor: pointer; clicked => { root.chooser-picked(i); } }
                            HorizontalLayout { padding: 4px; padding-right: 8px; spacing: 12px;
                                Rectangle { width: 56px; height: 56px; border-radius: 6px; background: ShellTheme.field;
                                    if row.picture.width > 0: Image { x: 2px; y: 2px; width: 52px; height: 52px; source: row.picture; image-fit: contain; }
                                }
                                VerticalLayout { alignment: center; horizontal-stretch: 1;
                                    Text { text: row.label; color: ShellTheme.text; font-size: 14px; font-weight: row.current ? 700 : 400; overflow: elide; }
                                    if row.current || row.in-list: Text { text: row.current ? @tr("In use") : @tr("In your dropdown"); color: ShellTheme.muted; font-size: 11px; }
                                }
                                VerticalLayout { alignment: center;
                                    Rectangle { width: 32px; height: 32px; border-radius: 6px;
                                        accessible-role: checkbox; accessible-checked: row.in-list;
                                        accessible-label: row.in-list ? @tr("Remove {} from the dropdown", row.label) : @tr("Add {} to the dropdown", row.label);
                                        accessible-action-default => { root.chooser-star(i); }
                                        background: star-touch.has-hover ? ShellTheme.field : transparent;
                                        Text { text: row.in-list ? "\u{2605}" : "\u{2606}"; font-size: 20px; color: row.in-list ? ShellTheme.icon-yellow : ShellTheme.muted; horizontal-alignment: center; vertical-alignment: center; }
                                        star-touch := TouchArea { mouse-cursor: pointer; clicked => { root.chooser-star(i); } }
                                    }
                                }
                            }
                            }
                        }
                        if root.chooser-rows.length == 0: Text { text: @tr("Nothing matches."); color: ShellTheme.muted; }
                    }
                }
                }
            }
        }
    }

}
