    in-out property <bool> plate-tabs-visible: true;
    callback slice-all-requested();
    callback export-all-requested();
    callback arrange-all-requested();
    callback move-to-plate-requested(int);
    callback delete-plate-requested();
    callback reorder-plate-requested(int);

    in-out property <string> plate-action-message;
    in-out property <string> hollow-wall-mm: "2.0";
    in-out property <string> drain-diameter-mm: "3.0";
    // Drain hole placement (R111): 0 into the surface, 1 along the view,
    // 2 straight down; custom depth; mirror 0 none, 1 x, 2 y, 3 both.
    in-out property <int> drain-aim: 0;
    in-out property <bool> drain-custom-depth: false;
    in-out property <string> drain-depth-mm: "10.0";
    in-out property <int> drain-mirror: 0;
    in-out property <string> drain-x-mm: "";
    in-out property <string> drain-y-mm: "";
    in-out property <string> drain-z-mm: "";
    in-out property <[string]> drain-hole-rows: [];
    callback drain-hole-remove(int);
    callback drain-holes-clear();
    callback drain-at-point();
    in-out property <bool> recovery-prompt: false;
    callback recovery-choice(bool);
    in-out property <bool> measure-tool-active: false;
    in-out property <bool> place-face-tool-active: false;
    // SVG path data (viewport px) of the selectable sides and the hovered
    // one; -1 count = no model selected.
    in property <string> place-face-path;
    in property <string> place-face-hover-path;
    in property <int> place-face-count: -1;
    // Rotate drag protractor (viewport px path data): the 15 degree ticks
    // the angle sticks to, the tick it is on, and the turned angle.
    in property <string> rotate-ticks-path;
    in property <string> rotate-tick-hot-path;
    in property <string> rotate-readout;
    in property <length> rotate-readout-x;
    in property <length> rotate-readout-y;
