    in-out property <int> hovered-plate-tile: -1;
    callback plate-action(int, int);
    in property <[int]> plate-ids: [1];
    in property <[image]> plate-thumbnails;
    callback plate-thumbnails-refresh();
    in property <int> active-plate-id: 1;
    // 1-based plate (as on the plate tabs) of the selected model; 0 = none.
    in property <int> object-plate-number: 0;
    callback plate-selected(int);
    callback add-plate-requested();
    // Plate tabs viewer (thumbnail list of plates) shown / hidden by the
