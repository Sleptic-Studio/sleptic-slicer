    callback move-menu-evidence();
    move-menu-evidence => { mv.activate-context(-2); }
    callback batch-choose-files();
    callback batch-choose-folder();
    callback batch-start();
    callback batch-cancel();
    in-out property <bool> batch-visible: false;
    in-out property <bool> batch-busy: false;
    in-out property <bool> batch-orient: true;
    in-out property <bool> batch-supports: false;
    in-out property <bool> batch-hollow: false;
