.vscode/

# Build artifacts
/target
/apps/*/i18n/*/LC_MESSAGES/*.mo

# Development samples
/examples

# Downloaded packaging blobs (large, re-fetched by the vendor scripts)
/packages/**/.cache

# Machine-local files: benchmark model list and results, round logs
/local

# Python bytecode
__pycache__/

# Generated from the configured GUI license for Inno Setup
/packages/windows/license.txt
